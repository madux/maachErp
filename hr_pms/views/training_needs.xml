<?xml version="1.0" encoding="utf-8"?>
    <odoo>
		<record id="view_training_section_line_form" model="ir.ui.view">
			<field name="name">Training section form</field>
			<field name="model">training.section.line</field>
			<field name="arch" type="xml">
				<form string="Sections">
                    <div class="oe_title">
                        <h1>
                            <field name="name" default_focus="1" required="1" placeholder="Safety management"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" required="0"/> 
                            <field name="requested_date" required="1"/> 
                            <field name="expected_completion_date" required="0"/> 
                            <!-- <field name="state" readonly="0" string ="Status"/>  -->
                            
                        </group>
                        <group>
                            <field name="requester_id" readonly="1"/> 
                            <field name="comments" required="1" readonly="0"/> 
                        </group>
                    </group>
                </form>
			</field>
		</record>

		<record id="view_training_session_tree" model="ir.ui.view">
			<field name="name">training.section.line.tree</field>
			<field name="model">training.section.line</field>
			<field name="arch" type="xml">
				<tree string="section">
                    <field name="employee_id" readonly="1"/> 
                    <field name="name"/>
                    <field name="requested_date" readonly="0"/> 
                    <field name="expected_completion_date" required="0"/> 
                    <field name="requester_id" required="0"/> 
                </tree>
			</field>
		</record>

		<record id="view_pms_training_section_filter" model="ir.ui.view">
			<field name="name">training section</field>
			<field name="model">training.section.line</field>
			<field name="arch" type="xml">
				<search string="Search Section">
                    <field name="employee_id" readonly="1" force_save="1"/> 
                    <field name="name"/>
                    <field name="requested_date" readonly="0"/> 
                    <field name="expected_completion_date" required="0"/> 
                    <field name="requester_id" required="0"/>
                    <group>
                        <filter name="group_by_employee_id" string='Employee' domain="[]" context="{'group_by' : 'employee_id'}"/>
                    </group>
				</search>
			</field>
		</record>
 
		<record id="action_pms_training_section_view" model="ir.actions.act_window">
			<field name="name">training Section</field>
			<field name="res_model">training.section.line</field>
			<field name="view_mode">tree,form</field>
             <field name="domain">[]</field>       

             <field name="context">{'default_state': 'draft', 'search_default_group_by_employee_id': 1}</field>
             <field name="search_view_id" ref="hr_pms.view_pms_training_section_filter" />
			<field name="view_id" eval="False"/>
			<field name="help" type="html">
				<p class="oe_view_nocontent_create">
					Click To Create.
				</p>
			</field>
		</record>
    <menuitem id="view_training_section_menu" name="Training Section" sequence="6" parent="hr_pms.view_hr_pms_menu" action="hr_pms.action_pms_training_section_view"
    groups="hr_pms.group_pms_officer_id,hr_pms.group_pms_manager_id,hr_pms.group_pms_supervisor"/>

    <menuitem id="view_employee_training_section_menu" name="Training Section" sequence="7" parent="hr.menu_hr_root" action="hr_pms.action_pms_training_section_view"
    groups="hr.group_hr_manager,hr_pms.group_pms_officer_id,hr_pms.group_pms_manager_id,hr_pms.group_pms_supervisor"/>

</odoo>