<odoo>
    <data noupdate="1">
        <record id="tax_group_1" model="account.tax.group">
            <field name="name">Company tax group</field> 
        </record>
        <!-- 10% Sales Tax -->
        <record id="tax_sale_10" model="account.tax">
            <field name="name">10% Sales Tax</field>
            <field name="amount">10.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="account_customization.tax_group_1"/>
        </record>

        <!-- 10% Purchase Tax -->
        <record id="tax_purchase_10" model="account.tax">
            <field name="name">10% Purchase Tax</field>
            <field name="amount">10.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="tax_group_id" ref="account_customization.tax_group_1"/>

        </record>

        <record id="tax_sale_75" model="account.tax">
            <field name="name">7.5% Sales Tax</field>
            <field name="amount">10.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="account_customization.tax_group_1"/>

        </record>

        <!-- 10% Purchase Tax -->
        <record id="tax_purchase_75" model="account.tax">
            <field name="name">7.5% Purchase Tax</field>
            <field name="amount">10.0</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">purchase</field>
            <field name="tax_group_id" ref="account_customization.tax_group_1"/>

        </record>

        <!-- 7.5% Personal Income Tax -->
        <record id="tax_pit_7_5" model="account.tax">
            <field name="name">7.5% Personal Income Tax</field>
            <field name="amount">7.5</field>
            <field name="amount_type">percent</field>
            <field name="type_tax_use">none</field>
            <field name="tax_group_id" ref="account_customization.tax_group_1"/>
        </record>

    </data>
</odoo>