<odoo>

    <!-- Override move -->
    <record id="account.group_account_readonly" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>


    <record id="view_account_journal_form_inherit_labels" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.labels.groups</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">

            <!-- Bank Account label -->
            <xpath expr="//page[@name='bank_account']//label[@for='default_account_id'][1]" position="attributes">
                <attribute name="groups">account.group_account_readonly,base.group_user</attribute>
            </xpath>

            <!-- Cash Account label -->
            <xpath expr="//page[@name='bank_account']//label[@for='default_account_id'][2]" position="attributes">
                <attribute name="groups">account.group_account_readonly,base.group_user</attribute>
            </xpath>

            <!-- Default Income Account label -->
            <xpath expr="//page[@name='bank_account']//label[@for='default_account_id'][3]" position="attributes">
                <attribute name="groups">account.group_account_readonly,base.group_user</attribute>
            </xpath>

            <!-- Default Expense Account label -->
            <xpath expr="//page[@name='bank_account']//label[@for='default_account_id'][4]" position="attributes">
                <attribute name="groups">account.group_account_readonly,base.group_user</attribute>
            </xpath>

            <!-- Default Expense Account label -->
            <xpath expr="//page[@name='bank_account']//field[@name='suspense_account_id']" position="attributes">
                <attribute name="groups">account.group_account_readonly,base.group_user</attribute>
            </xpath>

            <xpath expr="//page[@name='bank_account']//field[@name='bank_statements_source']" position="attributes">
                <attribute name="groups">account.group_account_readonly,base.group_user</attribute>
            </xpath>

        </field>
    </record>
</odoo>