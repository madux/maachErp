<odoo>
    <data noupdate="1">
        <!-- LOAN REQUEST  -->
        <record id="memo_cash_advance_new_stage" model="memo.stage">
            <field name="name">New</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">10</field>
        </record>
        <record id="memo_cash_advance_manager_approve_stage" model="memo.stage">
            <field name="name">Manager to Approve</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">20</field>
        </record>
        <record id="memo_cash_advance_cpo_approve_stage" model="memo.stage">
            <field name="name">CPO</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">30</field>
        </record>
         <record id="memo_cash_advance_finance_controller_stage" model="memo.stage">
            <field name="name">Finance Controller</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">45</field>
        </record>
        <record id="memo_cash_advance_md_ceo_approve_stage" model="memo.stage">
            <field name="name">MD /CEO To Approve</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">50</field>
        </record>
        <record id="memo_cash_advance_finance_post_approve_stage" model="memo.stage">
            <field name="name">Finance To post</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="is_approved_stage">1</field>
            <field name="sequence">60</field>
        </record>

        
        <record id="memo_cash_advance_done_stage" model="memo.stage">
            <field name="name">Done</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">70</field>
        </record>
         <record id="memo_config_employee_cash_advance_request" model="memo.config">
            <field name="name">* Cash Advance Request</field>
            <field name="memo_type" ref="company_memo.mtype_soe"/>
            <field name="active">1</field>
            <field name="prefix_code">SOE</field>

            <field name="company_id" ref="base.main_company"/>
            <field name="stage_ids" eval="[(6, 0, [
            ref('company_memo.memo_cash_advance_new_stage'),
            ref('company_memo.memo_cash_advance_manager_approve_stage'),
            ref('company_memo.memo_cash_advance_cpo_approve_stage'),
            ref('company_memo.memo_cash_advance_finance_controller_stage'),
            ref('company_memo.memo_cash_advance_md_ceo_approve_stage'),
            ref('company_memo.memo_cash_advance_finance_post_approve_stage'),
            ref('company_memo.memo_cash_advance_done_stage'),
            ])]"/>
        </record>
        

        <record id="memo_cash_advance_threshold_1_5" model="memo.threshold">
            <field name="threshold_over_amount">1</field> 
            <field name="threshold_under_amount">1500000</field> 
            <field name="threshold_stage_id" ref="company_memo.memo_cash_advance_finance_controller_stage"/> 
            <field name="memo_config_id" ref="company_memo.memo_config_employee_cash_advance_request"/> 
        </record>
        <record id="memo_cash_advance_threshold_over_15" model="memo.threshold">
            <field name="threshold_over_amount">1500000</field> 
            <field name="threshold_under_amount">900000000000</field> 
            <field name="threshold_stage_id" ref="company_memo.memo_cash_advance_md_ceo_approve_stage"/> 
            <field name="memo_config_id" ref="company_memo.memo_config_employee_cash_advance_request"/> 
        </record>

        <record id="memo_config_employee_cash_advance_request" model="memo.config">
            <field name="threshold_ids" eval="[(6, 0, [
            ref('company_memo.memo_cash_advance_threshold_1_5'),
            ref('company_memo.memo_cash_advance_threshold_over_15')]
            )]"/>
        </record>

         <record id="company_memo.memo_cash_advance_new_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_cash_advance_request"/>
        </record>
        <record id="company_memo.memo_cash_advance_manager_approve_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_cash_advance_request"/>
        </record>
        <record id="company_memo.memo_cash_advance_cpo_approve_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_cash_advance_request"/>
        </record> 
        <record id="company_memo.memo_cash_advance_md_ceo_approve_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_cash_advance_request"/>
        </record>
        <record id="company_memo.memo_cash_advance_finance_post_approve_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_cash_advance_request"/>
        </record>
        <record id="company_memo.memo_cash_advance_done_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_cash_advance_request"/>
        </record>

    </data>
</odoo>