<odoo>
    <data noupdate="1">
        <!-- employee_transfer REQUEST  -->
        <record id="memo_employee_transfer_new_stage" model="memo.stage">
            <field name="name">New</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">10</field>
        </record>
        <record id="memo_employee_transfer_manager_approve_stage" model="memo.stage">
            <field name="name">Manager to Approve</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">20</field>
        </record>
        <record id="memo_employee_transfer_cpo_review_stage" model="memo.stage">
            <field name="name">CPO / HR REVIEW</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">30</field>
        </record>
        <record id="memo_employee_transfer_fc_payroll_stage" model="memo.stage">
            <field name="name">Finance Controller / Payroll review</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">40</field>
        </record>
         
        <record id="memo_employee_transfer_md_ceo_approve_stage" model="memo.stage">
            <field name="name">MD /CEO To Approve</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">50</field>
        </record>
        <record id="memo_employee_transfer_it_update_stage" model="memo.stage">
            <field name="name">Finance To post</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="is_approved_stage">1</field>
            <field name="sequence">60</field>
        </record>

        
        <record id="memo_employee_transfer_done_stage" model="memo.stage">
            <field name="name">Done</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">70</field>
        </record>
         <record id="memo_config_employee_employee_transfer_request" model="memo.config">
            <field name="name">* Employee Transfer Request</field>
            <field name="memo_type" ref="company_memo.mtype_employee_update"/>
            <field name="active">1</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="stage_ids" eval="[(6, 0, [
            ref('company_memo.memo_employee_transfer_new_stage'),
            ref('company_memo.memo_employee_transfer_manager_approve_stage'),
            ref('company_memo.memo_employee_transfer_cpo_review_stage'),
            ref('company_memo.memo_employee_transfer_fc_payroll_stage'),
            ref('company_memo.memo_employee_transfer_md_ceo_approve_stage'),
            ref('company_memo.memo_employee_transfer_it_update_stage'),
            ref('company_memo.memo_employee_transfer_done_stage'),
            ])]"/>
        </record>
        

        
         <record id="company_memo.memo_employee_transfer_new_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_employee_transfer_request"/>
        </record>
        <record id="company_memo.memo_employee_transfer_manager_approve_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_employee_transfer_request"/>
        </record>
        <record id="company_memo.memo_employee_transfer_cpo_review_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_employee_transfer_request"/>
        </record>
        <record id="company_memo.memo_employee_transfer_fc_payroll_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_employee_transfer_request"/>
        </record>
        <record id="company_memo.memo_employee_transfer_md_ceo_approve_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_employee_transfer_request"/>
        </record>
        <record id="company_memo.memo_employee_transfer_it_update_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_employee_transfer_request"/>
        </record>
        <record id="company_memo.memo_employee_transfer_done_stage" model="memo.stage">
            <field name="memo_config_id" ref="company_memo.memo_config_employee_employee_transfer_request"/>
        </record>
    </data>
</odoo>