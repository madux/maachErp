        <!-- LOAN REQUEST  -->
        <record id="memo_loan_new_stage" model="memo.stage">
            <field name="name">New</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">10</field>
        </record>

        <record id="memo_loan_hr_approve_stage" model="memo.stage">
            <field name="name">HR Verification</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">20</field>
        </record>
        <record id="memo_loan_cpo_approve_stage" model="memo.stage">
            <field name="name">CPO to Validate</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">30</field>
        </record>
        <record id="memo_loan_finance_approve_stage" model="memo.stage">
            <field name="name">Finance to Post</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="is_approved_stage">1</field>
            <field name="sequence">40</field>
        </record>
        <record id="memo_loan_done_stage" model="memo.stage">
            <field name="name">Done</field>
            <field name="loaded_from_data">1</field>
            <field name="active">1</field>
            <field name="sequence">50</field>
        </record>
        
        <record id="memo_config_employee_loan_request" model="memo.config">
            <field name="name">* Loan Request</field>
            <field name="memo_type" ref="company_memo.mtype_loan"/>
            <field name="active">1</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="stage_ids" eval="[(6, 0, [
            ref('company_memo.memo_loan_new_stage'),
            ref('company_memo.memo_loan_hr_approve_stage'),
            ref('company_memo.memo_loan_cpo_approve_stage'),
            ref('company_memo.memo_loan_finance_approve_stage'),
            ref('company_memo.memo_loan_done_stage'),
            ])]"/>
        </record>

    </data>
</odoo>