<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="company_mono_view" model="ir.ui.view">
            <field name="name">res.company.mono.view</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[last()]" position="after">
                    <page name="mono_config" string="Mono Configuration">
                        <group>
                            <group>
                                <field name="mono_publickey"/>
                                <field name="mono_secretckey"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>


        <record id="account_journal_mono_view" model="ir.ui.view">
            <field name="name">account.journal.mono.view</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <notebook>
                        <page name="mono_config" string="Mono Configuration">
                            <group>
                                <group>
                                    <field name="mono_publickey" invisible="1"/>
                                    <field name="mono_secretckey" invisible="1"/>
                                    <field name="mono_api_token" readonly="1"/>
                                    <field name="mono_account_id" readonly="1"/>
                                    <field name="last_sync_date"/>
                                    <field name="sync_active"/>
                                    <field name="sync_limit"/>
                                </group>
                                <group>
                                    <button class="btn btn-primary mono-widget" type="object" name="authenticate"
                                            string="Mono Connect"/>
                                    <button class="btn btn-primary" type="object" name="retrieve_transactions"
                                            string="Mono Manual Sync"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
