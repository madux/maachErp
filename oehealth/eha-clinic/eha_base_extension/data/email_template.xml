<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="misconduct_mail_template" model="mail.template">
            <field name="name">Misconduct Notification</field>
            <field name="email_from">${object.write_uid.email}</field>
            <field name="subject">Misconduct Notification</field>
            <field name="email_to">${object.email}</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html"><![CDATA[
                <p>Hi ${object.name}, <br/>
                You have been ${ctx['flag_type']} for the following reasons: ${ctx['flag_reason']} <br/>
                Kindly contact the admin for further enquires. <br/>
                Yours Sincerely <br/>
                ${object.write_uid.name}
            ]]></field>
        </record>

        <record id="misconduct_patient_mail_template" model="mail.template">
            <field name="name">Patient Misconduct Notification</field>
            <field name="email_from">${object.write_uid.email}</field>
            <field name="subject">Misconduct Notification</field>
            <field name="email_to">${object.email}</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_patient"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html"><![CDATA[
                <p>Hi ${object.name}, <br/>
                You have been ${ctx['flag_type']} for the following reasons: ${ctx['flag_reason']} <br/>
                Kindly contact the admin for further enquires. <br/>
                Yours Sincerely <br/>
                ${object.write_uid.name}
            ]]></field>
        </record>
        
 </data>
</odoo>