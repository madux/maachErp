<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_tree_eha_base_extension" model="ir.ui.view">
        <field name="name">res.partner.view.tree.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="hp_number" />
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_eha_base_extension" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group[1]" position="inside">
                <field name="hp_number" />
                <field name="epid_number" />
                <field name="passport_number" />
                <field name="marital_status" />
                <field name="secondary_email" />
                <field name="next_of_kin" />
                <field name="gender"/>
                <field name="dob"/>
                <field name="flag" invisible="1"/>
                <field name="registered_patient"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="migrate_data_from_patients" string="Migrate Patient Data" type="object" class="oe_highlight"/>
                    <button name="flag_contact" string="FLAG" type="object" class="btn-danger" attrs="{'invisible': [('flag', '=', True)]}" 
                    groups="eha_base_extension.group_quality_team"/>
                    <button name="unflag_contact" string="Unflag" type="object" class="oe_highlight" attrs="{'invisible': [('flag', '=', False)]}"
                    groups="eha_base_extension.group_quality_team"/>
                </header>
            </xpath>
            <xpath expr="//sheet/div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="Flagged" bg_color="bg-danger" attrs="{'invisible': [('flag', '=', False)]}"/>
            </xpath>
        </field>
    </record>
    
    <record id="view_res_partner_filter_ext" model="ir.ui.view">
        <field name="name">res.partner.select.ext</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="hp_number" filter_domain="[('hp_number', 'ilike', self)]"/>
            </xpath>

            <xpath expr="//filter[@name='type_person']" position="before">
               <filter string="HP Number" name="group_hpnumber" context="{'group_by' : 'hp_number'}"/>
               <separator/>
            </xpath>
        </field>
    </record>

    <!-- Get the HP numbers from the related patient records -->
    <record model="ir.actions.server" id="action_partner_get_hp_from_patients">
        <field name="name">Migrate Patient Data</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.migrate_data_from_patients()
        </field>
    </record>

</odoo>
