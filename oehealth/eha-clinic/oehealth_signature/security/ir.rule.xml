<?xml version="1.0"?>
<odoo>
    <data>
        <record id="oehealth_signature_document_sign_hr" model="ir.rule">
            <field name="name">Access to all HR documents</field>
            <field name="model_id" ref="oehealth_signature.model_sign_template"/>
            <field name="groups" eval="[(4, ref('oehealth_signature.group_hr_document'))]"/>
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
            <field name="domain_force">[('is_hr_document', '=', True)]</field>
        </record>
        <record id="oehealth_signature_document_sign_non_hr" model="ir.rule">
            <field name="name">Prevent Access to all HR documents</field>
            <field name="model_id" ref="oehealth_signature.model_sign_template"/>
            <field name="groups" eval="[(4, ref('sign.group_sign_user'))]"/>
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
            <field name="domain_force">[('is_hr_document', '!=', True)]</field>
        </record>
    </data>
</odoo>
