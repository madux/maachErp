<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_partner_view_form" model="ir.ui.view">
            <field name="name">res.partner.form.sign.inherit.oehealth.signature</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="sign.res_partner_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']/button[@name='open_signatures']" position="replace" />
                <xpath expr="//div[@name='button_box']/button[1]" position="after">
                    <button name="open_signatures" type="object" class="oe_stat_button" icon="fa-pencil">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="signature_count" />
                            </span>
                            <span class="o_stat_text">Signature Requests</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

    </data>
</odoo>