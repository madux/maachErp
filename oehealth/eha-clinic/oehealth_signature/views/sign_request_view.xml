<?xml version="1.0"?>
<odoo>
    <data>

        <record id="inherit_sign_request_view_form" model="ir.ui.view">
            <field name="name">oehealth.sign.reuest.form.extended</field>
            <field name="model">sign.request</field>
            <field name="inherit_id" ref="sign.sign_request_view_form" />
            <field name="arch" type="xml">

                <xpath expr="//field[@name='template_id']" position="after">
                    <field name="partner_id" placeholder="Name or email..." context="{'force_email': True}" />
                    <field name="access_token" readonly="1" />
                </xpath>
            </field>
        </record>

        <record id="inherit_sign_request_view_tree_extended" model="ir.ui.view">
            <field name="name">sign.request.view.tree.extended</field>
            <field name="model">sign.request</field>
            <field name="inherit_id" ref="sign.sign_request_view_tree" />
            <field name="arch" type="xml">
                <field name="template_id" position="after">
                    <field name="partner_id" string="Customer" />
                </field>
            </field>
        </record>

    </data>
</odoo>