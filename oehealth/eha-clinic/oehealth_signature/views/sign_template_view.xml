<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="inherit_sign_template_view_form" model="ir.ui.view">
            <field name="name">oehealth.sign.template.form.extended</field>
            <field name="model">sign.template</field>
            <field name="inherit_id" ref="sign.sign_template_view_form"/>
            <field name="arch" type="xml">

               <xpath expr="//field[@name='attachment_id']" position="after">
                    <field name="partner_id" invisible="1"/>         
                </xpath>
                <xpath expr="//field[@name='favorited_ids']" position="after">
                    <field name="is_hr_document"/>         
                </xpath>
            </field>
        </record>

        <record id="inherit_sign_template_view_tree_extended" model="ir.ui.view">
            <field name="name">sign.template.view.tree.extended</field>
            <field name="model">sign.template</field>
            <field name="inherit_id" ref="sign.sign_template_view_tree"/>
            <field name="arch" type="xml">
                <field name="attachment_id" position="after">
                    <field name="partner_id" invisible="1" string="Customer"/>
                </field> 
            </field>
        </record>

    </data>
</odoo>


