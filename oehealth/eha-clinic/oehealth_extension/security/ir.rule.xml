<?xml version="1.0"?>
<odoo>
    <data>
        <record id="oehealth.oeh_medical_appointment_physician" model="ir.rule">
            <field name="name">Override Each physician can see only own appointment</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('oehealth.group_oeh_medical_manager'),ref('oehealth.group_oeh_medical_physician'))]"/>
        </record>

        <record id="oehealth.oeh_medical_appointment_admin" model="ir.rule">
            <field name="name">Access all the appointments</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('oehealth.group_oeh_medical_manager'))]"/>
        </record>

        <record id="oehealth.oeh_medical_prescription_physician" model="ir.rule">
            <field name="name">Override Each physician can see only own prescriptions</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_prescription"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('oehealth.group_oeh_medical_manager'),ref('oehealth.group_oeh_medical_physician'))]"/>
        </record>

        <record id="oehealth.oeh_medical_prescription_admin" model="ir.rule">
            <field name="name">Access all the prescriptions</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_prescription"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('oehealth.group_oeh_medical_manager'),ref('oehealth.group_oeh_medical_physician'))]"/>
        </record>

        <record id="oehealth.oeh_medical_evaluation_physician" model="ir.rule">
            <field name="name">Override Each physician can see only own evaluation</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_evaluation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('oehealth.group_oeh_medical_manager'),ref('oehealth.group_oeh_medical_physician'))]"/>
        </record>

        <record id="oehealth.oeh_medical_evaluation_admin" model="ir.rule">
            <field name="name">Access all the evaluations</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_evaluation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('oehealth.group_oeh_medical_manager'),ref('oehealth.group_oeh_medical_physician'))]"/>
        </record>

        <record id="oehealth.oeh_medical_lab_test_physician" model="ir.rule">
            <field name="name">Override Each physician can see only own lab tests</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_lab_test"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('oehealth.group_oeh_medical_manager'),ref('oehealth.group_oeh_medical_physician'))]"/>
        </record>

        <record id="oehealth.oeh_medical_lab_test_admin" model="ir.rule">
            <field name="name">Access all the lab tests</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_lab_test"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('oehealth.group_oeh_medical_manager'),ref('oehealth.group_oeh_medical_physician'))]"/>
        </record>

        <record id="oeha_medical_imaing_test" model="ir.rule">
            <field name="name">Each patient can see only own imaging tests</field>
            <field name="model_id" ref="model_oeha_medical_imaging_test"/>
            <field name="domain_force">['|', ('patient', '=', False), ('patient.oeh_patient_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('oehealth.group_oeh_medical_patient'))]"/>
        </record>

        <!-- CHP Nurse Record Rules -->
        <record id="oeha_medical_chp_nurse_patient" model="ir.rule">
            <field name="name">Each CHP Nurse Can See only Own Program Patients</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_patient"/>
            <field name="domain_force">['|',('program_ids', 'in', [p.id for p in user.program_ids]),('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('oehealth_extension.group_oeh_medical_chp_nurse'))]"/>
        </record>

        <record id="oeha_medical_chp_nurse_appointment" model="ir.rule">
            <field name="name">Each CHP Nurse Can See only Own Appointments</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_appointment"/>
            <field name="domain_force">['|',('field_nurse', '=', user.id),('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('oehealth_extension.group_oeh_medical_chp_nurse'))]"/>
        </record>

        <record id="oeha_medical_chp_nurse_evaluation" model="ir.rule">
            <field name="name">Each CHP Nurse Can See only Own Program Patients Evaluations</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_evaluation"/>
            <field name="domain_force">['|',('patient.program_ids', 'in', [p.id for p in user.program_ids]),('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('oehealth_extension.group_oeh_medical_chp_nurse'))]"/>
        </record>

        <record id="oeha_medical_chp_nurse_prescription" model="ir.rule">
            <field name="name">Each CHP Nurse Can See only Own Program Patients Prescriptions</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_prescription"/>
            <field name="domain_force">['|',('patient.program_ids', 'in', [p.id for p in user.program_ids]),('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('oehealth_extension.group_oeh_medical_chp_nurse'))]"/>
        </record>

        <record id="oeha_medical_chp_nurse_labtest" model="ir.rule">
            <field name="name">Each CHP Nurse Can See only Own Program Patients Lab Tests</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_lab_test"/>
            <field name="domain_force">['|',('patient.program_ids', 'in', [p.id for p in user.program_ids]),('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('oehealth_extension.group_oeh_medical_chp_nurse'))]"/>
        </record>

        <record id="oeha_medical_chp_nurse_vaccines" model="ir.rule">
            <field name="name">Each CHP Nurse Can See only Own Program Patients Vaccines</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_vaccines"/>
            <field name="domain_force">['|',('patient.program_ids', 'in', [p.id for p in user.program_ids]),('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('oehealth_extension.group_oeh_medical_chp_nurse'))]"/>
        </record>

        <!-- CHP Manager Record Rules -->
        <record id="oeha_medical_chp_manager_appointment" model="ir.rule">
            <field name="name">CHP Manager Can See all Program Patients Appointments</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_appointment"/>
            <field name="domain_force">[('patient.program_ids', 'in', [p.id for p in user.program_ids])]</field>
            <field name="groups" eval="[(4, ref('oehealth_extension.group_oeh_medical_chp_manager'))]"/>
        </record>

        <!--SMS template rule-->
        <record id="ir_rule_sms_template_cif" model="ir.rule">
            <field name="name">SMS Template: Internal User CRUD on CIF	</field>
            <field name="model_id" ref="sms.model_sms_template"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('model_id.model', '=', 'oeha.covid19.cif')]</field>
        </record>
    </data>
</odoo>
