<?xml version="1.0"?>
    <odoo>
        <record id="view_oeha_batch_import_search" model="ir.ui.view">
            <field name="name">oeha.patient.batch.import.search</field>
            <field name="model">oeha.patient.batch.import</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search Third Party Partner imports">
                    <separator orientation="vertical"/>
                        <field name="thirdparty_partner_id" select="1"/>
                        <field name="date_generated"/>
                        <field name="filename"/>
                        <field name="is_day2"/>
                    <newline/>
                    <group expand="0" string="Group By...">
                        <filter name="thirdparty_partner_id" string="Third Party Partner"  domain="[]" context="{'group_by':'thirdparty_partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="view_oeha_batch_import_list">
            <field name="name">oeha.patient.batch.import.list</field>
            <field name="model">oeha.patient.batch.import</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string='Templates'>
                    <field name="thirdparty_partner_id" select="1"/>
                    <field name="date_generated"/>
                    <field name="filename"/>
                    <field name="is_day2"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_oeha_batch_import_form">
            <field name="name">oeha.patient.batch.import.form</field>
