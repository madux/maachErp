<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_oeh_medical_blood_diary_form" model="ir.ui.view">
		<field name="name">view blood pressure diary form</field>
		<field name="model">oeh.medical.blood.pressure.diary</field>
		<field name="arch" type="xml">
			<form string="Patient Blood Diaries">
				<sheet>
					<group>
						<group>
							<field name="patient_id" string="Patient ID" required="1"/>
							<field name="systolic_pressure" required="1"/>
							<field name="reference" required="0"/>

						</group>
						<group>
							<field name="diastolic_pressure" required="1"/>
							<field name="date_of_reading" required="1"/>
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>
	<record id="view_oeh_medical_blood_pressure_diary_tree" model="ir.ui.view">
		<field name="name">view.oeh.medical.blood.pressure.diary.tree</field>
		<field name="model">oeh.medical.blood.pressure.diary</field>
		<field name="arch" type="xml">
			<tree string="Patient Blood Pressure Diaries">
				<field name="reference" required="0"/>
				<field name="patient_id" string="Patient ID" required="1"/>
				<field name="systolic_pressure" required="1"/>
				<field name="diastolic_pressure" required="1"/>
				<field name="date_of_reading" required="1"/>
			</tree>
		</field>
	</record>

	<record id="view_oeh_medical_blood_plessure_diary_filter" model="ir.ui.view">
		<field name="name">oeh.medical.blood.pressure.diary</field>
		<field name="model">oeh.medical.blood.pressure.diary</field>
		<field name="arch" type="xml">
			<search string="Patient Blood Diaries">
				<field name="patient_id" />
				<field name="systolic_pressure"/>
				<field name="diastolic_pressure"/>
				<field name="date_of_reading"/>
			</search>
		</field>
	</record>
	<record id="view_oeh_medical_blood_pressure_diary_graph" model="ir.ui.view">
		<field name="name">oeh.medical.blood.pressure.diary</field>
		<field name="model">oeh.medical.blood.pressure.diary</field>
		<field name="arch" type="xml">
			<graph string="Patient Blood Plessure Diaries">
				<field name="date_of_reading"/>
				<field name="systolic_pressure" type="measure"/>
				<field name="diastolic_pressure" type="measure"/>
			</graph>
		</field>
	</record>
	<record id="action_view_oeh_medical_blood_pressure_diary" model="ir.actions.act_window">
		<field name="name">Patient Blood Pressure Diary</field>
		<field name="res_model">oeh.medical.blood.pressure.diary</field>
		<field name="view_mode">tree,form,graph</field>
		<field name="view_id" eval="view_oeh_medical_blood_plessure_diary_filter" />
		<field name="help" type="html">
			<p class="oe_view_nocontent_create">
					Click To Create Patient Diary. 
			</p>
		</field>
	</record>
	<menuitem id="patient_medical_diaries" name="Medical Diaries" action="action_view_oeh_medical_blood_pressure_diary" parent="oehealth.oeh_medical_patients_menu"/>

</odoo>