<?xml version="1.0" ?>
<odoo>
    <data>

        <record id="view_partner_form_extended" model="ir.ui.view">
            <field name="name">base.contact.form.extended</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <field name="company_type" position="before">
                    <button name="action_convert_to_patient" 
                    type="object" string="Convert To Patient"
                    attrs="{'invisible': ['|', ('patient_id', '!=', False), '|', ('id', '=', False),('is_company', '=', True)]}"
                    class="oe_highlight"
                    confirm="Are you sure you want to convert this contact to a patient?" />
                </field>
                <xpath expr="//form/sheet/div/field[@name='company_type']" position="after">
                    <field name="patient_id"/>
                </xpath>
                <xpath expr="//form/sheet/div/h1" position="replace">
                    <h1>
                        <field name="name" default_focus="1" placeholder="Company Name" attrs="{'required':[('type', '=', 'contact')], 'invisible':[('is_company', '=', False)]}"/>
                        <field name="name" placeholder="Company Name" class='oe_read_only' attrs="{'required':[('type', '=', 'contact')], 'invisible':[('is_company', '=', True)]}"/>
                    </h1>
                </xpath>
            </field>
        </record>

        <record id="view_user_form" model="ir.ui.view">
            <field name="name">res.user.form.oehealth_extension</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside" >
                    <group string="Linked Patients" >
                        <field string="Linked Patients" name="linked_patient_ids">
                            <tree>
                                <field name="identification_code" />
                                <field name="name" />
                                <field name="sex" />
                                <field name="dob" />
                                <field name="age" />
                            </tree>
                        </field>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
