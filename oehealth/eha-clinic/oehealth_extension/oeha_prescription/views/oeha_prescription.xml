<odoo>
    <record model="ir.ui.view" id="oeh_medical_healthcenters_pharmacy_view_inherites">
        <field name="name">oeh.medical.health.center.pharmacy.inherits</field>
        <field name="model">oeh.medical.health.center.pharmacy</field>
        <field name="inherit_id" ref="oehealth.oeh_medical_healthcenters_pharmacy_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pharmacy_lines']/tree/field[@name='doctor']" position="after">
                <field name="dispenser" options="{'no_create': True}" attrs="{'required': [('state', '=','Draft')]}"/>
                <field name="prescriber" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='pharmacy_lines']/form/sheet/group/group/field[@name='doctor']" position="after">
                <field name="dispenser" options="{'no_create': True}"/>
                <field name="prescriber" options="{'no_create': True}"/>
            </xpath>

            <xpath expr="//field[@name='pharmacy_lines']/form/sheet/group/group/field[@name='doctor']" position="replace">
                <field name="doctor" invisible="1" options="{'no_create': True}"/>

            </xpath>
            <xpath expr="//field[@name='pharmacy_lines']/tree/field[@name='doctor']" position="replace">
                <field name="doctor" invisible="1"/>
            </xpath>

        </field>
    </record>

    <record model="ir.ui.view" id="oeh_medical_prescription_view_inherites">
        <field name="name">oeh.medical.prescription.inherits</field>
        <field name="model">oeh.medical.prescription</field>
        <field name="inherit_id" ref="oehealth.oeh_medical_prescription_view"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_prescription_send_to_pharmacy']" position="replace">
                <button confirm="Are you sure you want to send prescription to selected pharmacy?" name="action_prescription_send_to_pharmacy" states="Draft" string="Send to Pharmacy" type="object" class="oe_highlight" groups="oehealth.group_oeh_medical_physician,oehealth.group_oeh_medical_manager" invisible="1"/>
            </xpath>

            <xpath expr="//button[@name='action_prescription_send_to_pharmacy']" position="before">
                <field name="order_id" invisible="1"/>
                <button name="create_sales_order" attrs="{'invisible': [('order_id','>',0)]}" class="oe_stat_button oe_highlight" type="object" string="Create Sale Order"/>
                <button name="create_sales_order" attrs="{'invisible': [('order_id','=',False)]}" class="oe_stat_button oe_highlight" type="object" string="Access Sale Order"/>
            </xpath>

            <xpath expr="//button[@name='action_prescription_send_to_pharmacy']" position="after">
                <button confirm="Are you sure you want to Confirm Dispense?" name="action_prescription_dispense" states="Draft" string="Dispense" type="object" class="oe_highlight" groups="oehealth.group_oeh_medical_physician,oehealth.group_oeh_medical_manager"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="replace">
                <field name="state" widget="statusbar" statusbar_visible="Draft,Sent to Pharmacy,Dispensed" statusbar_colors='{"Draft":"blue","Invoiced":"grey"}'/>

            </xpath>
            <xpath expr="//field[@name='doctor']" position="after">
                <field name="prescriber" options="{'no_create': True}" attrs="{'required': [('state', '=','Draft')]}"/>
                <field name="dispenser" options="{'no_create': True}" />

            </xpath>

            <xpath expr="//field[@name='doctor']" position="replace">
                <field name="doctor" required="0" invisible="1" options="{'no_create': True}"/>

            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_prescription_send" string="Send by email" type="object" class="oe_highlight"/>
            </xpath>

            <xpath expr="//field[@name='pharmacy']" position="after">
                <field name="property_product_pricelist" />    
            </xpath>

            <!-- prescription line extension -->
            <xpath expr="//field[@name='prescription_line']" position="replace">
                <field name="prescription_line" context="{'prescription_id': active_id, 'default_prescription_id': active_id}">
                    <tree string="Prescription Lines" editable="bottom">
                        <field name="name"/>
                        <field name="indication" required="True" />
                        <field name="dose_route"/>
                        <field name="dose"/>
                        <field name="dose_unit" attrs="{'readonly':[('is_physician', '=', False)], 'required':[('dose_form','=',False)]}"/>
                        <field name="dose_form" attrs="{'readonly':[('is_physician', '=', False)], 'required':[('dose_unit','=',False)]}" />
                        <field name="common_dosage" required="True"/>
                        <field name="duration"/>
                        <field name="duration_period"/>
                        <field name="is_refillable" />
                        <field name="state" invisible="0" />
                        <field name="patient" invisible="1"/>
                        <field name="prescription_id" invisible="1" />
                        <field name="is_physician" invisible="1"/>
                        <field name="next_refill_date" invisible="1" />
                        <field name="is_main_prescription" invisible="1"/>
                        <button string="REFILL" name="action_open_views" type="object" icon="fa-list" width="0.1" options='{"warn": true}' />
                    </tree>
                    <form string="Prescription Lines">
                        <header>
                            <button name="action_dispense" class="oe_highlight" type="object" string="Dispense" confirm="Are you sure you want to Dispense?" attrs="{'invisible': [('state', '!=', 'Undispensed')]}"/>
                            <button name="action_undispense" class="oe_highlight" type="object" string="Undispense" confirm="Are you sure you want to UnDispense?" attrs="{'invisible': [('state', '!=', 'Dispensed')]}"/>
                            <field name="state" widget="statusbar" clickable="False" statusbar_visible="draft,Dispensed,Undispensed"/>
                        </header>
                        <group>
                            <group>
                                <field name="is_physician" attrs="{'invisible':1}"/>
                                <field name="is_main_prescription" attrs="{'invisible':1}"/>
                                <field name="name" attrs="{'readonly':[('is_physician', '=', False)]}"/>
                                <field name="dose_route" attrs="{'readonly':[('is_physician', '=', False)]}" required="1"/>
                            </group>
                            <group>
                                <field name="patient" domain="[('id', '=', parent.patient)]" attrs="{'readonly':[('is_physician', '=', False)]}" required="1"/>
                                <field name="indication" attrs="{'readonly':[('is_physician', '=', False)]}"/>
                            </group>
                        </group>
                        <group string="Doctor's Comment">
                            <field name="info" nolabel="1" attrs="{'readonly':[('is_physician', '=', False)]}"/>
                        </group>
                        <group>
                            <group string="Dosage">
                                <label for="dose"/>
                                <div>
                                    <field name="dose" style="width: 17%%" attrs="{'readonly':[('is_physician', '=', False)]}" required="1"/>
                                    <field name="dose_unit" placeholder="unit" style="width: 17%%; margin-left: 3%%" attrs="{'readonly':[('is_physician', '=', False)], 'required':[('dose_form','=',False)]}"/>
                                    <field name="dose_form" placeholder="dose form" style="width: 60%%; margin-left: 3%%" attrs="{'readonly':[('is_physician', '=', False)], 'required':[('dose_unit','=',False)]}"/>
                                </div>
                                <field name="common_dosage" attrs="{'readonly':[('is_physician', '=', False)]}" required="1"/>
                                <label for="duration"/>
                                <div>
                                    <field name="duration" placeholder="0" style="width: 37%%" attrs="{'readonly':[('is_physician', '=', False)]}"/>
                                    <field name="duration_period" style="width: 60%%; margin-left: 3%%" attrs="{'readonly':[('is_physician', '=', False)], 'required':[('duration','>',0)]}"/>
                                </div>
                            </group>
                            <group string="Auxiliary Instructions">
                                <field name="auxiliary_instructions" nolabel="1"/>
                            </group>
                        </group>
                        <group string="Refill">
                            <group>
                                <field name="is_refillable" attrs="{'readonly':[('is_physician', '=', False)]}"/>
                                <label for="refill_frequency" attrs="{'invisible':[('is_refillable', '=', False)]}"/>
                                <div>
                                    <field name="refill_frequency" style="width: 37%%" attrs="{'invisible':[('is_refillable', '=', False)], 'readonly':[('is_physician', '=', False)]}"/>
                                    <field name="refill_frequency_unit" style="width: 60%%; margin-left: 3%%" attrs="{'invisible':[('is_refillable', '=', False)], 'readonly':[('is_physician', '=', False)]}"/>
                                </div>
                                <label for="refill_duration" attrs="{'invisible':[('is_refillable', '=', False)]}"/>
                                <div>
                                    <field name="refill_duration" style="width: 37%%" attrs="{'invisible':[('is_refillable', '=', False)], 'readonly':[('is_physician', '=', False)]}"/>
                                    <field name="refill_duration_unit" style="width: 60%%; margin-left: 3%%" attrs="{'invisible':[('is_refillable', '=', False)], 'readonly':[('is_physician', '=', False)]}"/>
                                </div>
                                <field name="dispense_date" invisible="1"/>
                            </group>
                            <group>
                                <field name="has_reminder" attrs="{'invisible':[('is_refillable', '=', False)], 'readonly':[('is_physician', '=', False)]}"/>
                                <field name="pharmacist_email" attrs="{'invisible':[('is_refillable', '=', False)], 'required': [('has_reminder', '=', True)]}"/>
                                <field name="patient_email" attrs="{'invisible':[('is_refillable', '=', False)], 'required': [('has_reminder', '=', True)]}"/>
                                <field name="next_refill_date" invisible="1"/>
                            </group>
                        </group>
                        <!-- insert refills here -->
                        <notebook>
                            <field name="refill_line_generated" invisible="1" />
                            <page name="refill_details" string="Refill Details" attrs="{'invisible': [('is_refillable', '=', False)], 'required': [('is_refillable', '=', True)]}">
                                <button name="generate_refill_lines" type="object" string="Generate Refill Lines" class="oe_highlight" attrs="{'invisible': [('refill_line_generated', '=', True)]}" />
                                <field name="prescription_detail_ids">
                                    <tree string="Refill Details" editable="bottom">
                                        <field name="id" groups="base.group_system"/>
                                        <field name="date_refill_proposed" />
                                        <field name="date_refill_actual" />
                                        <field name="state" />
                                        <field name="prescription_line_id" invisible="1" />
                                        <button name="confirm_refill" type="object" string="Dispense" class="oe_highlight" attrs="{'invisible': [('state', '=', 'done')]}"/>
                                    </tree>
                                </field>
                            </page>
                            <page name="ecommerce_config" string="eCommerce Configurations">
                                <group>
                                    <group>
                                        <field name="website_product_id" />
                                    </group>
                                    <group>
                                        <div>
                                            <field name="maximum_order_qty" class="oe_inline" />
                                            <field name="online_uom_id" class="oe_inline" />
                                        </div>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </form>
                </field>
            </xpath>
            <xpath expr="//sheet" position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </xpath>
        </field>
    </record>
    <record model="ir.ui.view" id="oeh_medical_prescription_inherited_tree">
        <field name="name">oeh.medical.prescription.inherits</field>
        <field name="model">oeh.medical.prescription</field>
        <field name="inherit_id" ref="oehealth.oeh_medical_prescription_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='doctor']" position="attributes">
                <attribute name= "invisible">1</attribute>
                <field name="doctor"/>
            </xpath>
            <xpath expr="//field[@name='doctor']" position="after">
                <field name="prescriber"/>
                <field name="dispenser"/>
            </xpath>

        </field>
    </record>

    <record model="ir.ui.view" id="view_prescription_line_form">
        <field name="name">oeh.medical.prescription.line.form.view</field>
        <field name="model">oeh.medical.prescription.line</field>
        <field name="arch" type="xml">
            <form string="Prescription Lines">
                <header>
                    <button name="action_dispense" class="oe_highlight" type="object" string="Dispense" confirm="Are you sure you want to Dispense?" attrs="{'invisible': [('state', '!=', 'Undispensed')]}"/>
                    <button name="action_undispense" class="oe_highlight" type="object" string="Undispense" confirm="Are you sure you want to UnDispense?" attrs="{'invisible': [('state', '!=', 'Dispensed')]}"/>
                    <field name="state" widget="statusbar" clickable="False" statusbar_visible="draft,Dispensed,Undispensed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="is_physician" attrs="{'invisible':1}"/>
                            <field name="is_main_prescription" attrs="{'invisible':1}"/>
                            <field name="name" attrs="{'readonly':[('is_physician', '=', False)]}"/>
                            <field name="dose_route" attrs="{'readonly':[('is_physician', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="prescription_id" invisible="1"/>
                            <field name="patient" required="1" />
                            <field name="indication" attrs="{'readonly':[('is_physician', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Doctor's Comment">
                        <field name="info" nolabel="1" attrs="{'readonly':[('is_physician', '=', False)]}"/>
                    </group>
                    <!-- insert refills here -->
                    <notebook>
                        <page name="common_dosage" string="Common Dosage">
                            <group>
                                <group string="Dosage">
                                    <label for="dose"/>
                                    <div>
                                        <field name="dose" style="width: 17%%" attrs="{'readonly':[('is_physician', '=', False)]}" required="1"/>
                                        <field name="dose_unit" placeholder="unit" style="width: 17%%; margin-left: 3%%" attrs="{'readonly':[('is_physician', '=', False)], 'required':[('dose_form','=',False)]}"/>
                                        <field name="dose_form" placeholder="dose form" style="width: 60%%; margin-left: 3%%" attrs="{'readonly':[('is_physician', '=', False)], 'required':[('dose_unit','=',False)]}"/>
                                    </div>
                                    <field name="common_dosage" attrs="{'readonly':[('is_physician', '=', False)]}" required="1"/>
                                    <label for="duration"/>
                                    <div>
                                        <field name="duration" placeholder="0" style="width: 37%%" attrs="{'readonly':[('is_physician', '=', False)]}"/>
                                        <field name="duration_period" style="width: 60%%; margin-left: 3%%" attrs="{'readonly':[('is_physician', '=', False)], 'required':[('duration','>',0)]}"/>
                                    </div>
                                </group>
                                <group string="Auxiliary Instructions">
                                    <field name="auxiliary_instructions" nolabel="1"/>
                                </group>
                            </group>
                        </page>
                        <page name="refill_details" string="Refill Details">
                            <group>
                                <field name="is_refillable" attrs="{'readonly':[('is_physician', '=', False)]}"/>
                                <label for="refill_frequency" attrs="{'invisible':[('is_refillable', '=', False)]}"/>
                                <div>
                                    <field name="refill_frequency" style="width: 37%%" attrs="{'invisible':[('is_refillable', '=', False)], 'readonly':[('is_physician', '=', False)]}"/>
                                    <field name="refill_frequency_unit" style="width: 60%%; margin-left: 3%%" attrs="{'invisible':[('is_refillable', '=', False)], 'readonly':[('is_physician', '=', False)]}"/>
                                </div>
                                <label for="refill_duration" attrs="{'invisible':[('is_refillable', '=', False)]}"/>
                                <div>
                                    <field name="refill_duration" style="width: 37%%" attrs="{'invisible':[('is_refillable', '=', False)], 'readonly':[('is_physician', '=', False)]}"/>
                                    <field name="refill_duration_unit" style="width: 60%%; margin-left: 3%%" attrs="{'invisible':[('is_refillable', '=', False)], 'readonly':[('is_physician', '=', False)]}"/>
                                </div>
                                <field name="dispense_date" invisible="1"/>
                            </group>
                            <group>
                                <field name="has_reminder" attrs="{'invisible':[('is_refillable', '=', False)], 'readonly':[('is_physician', '=', False)]}"/>
                                <field name="pharmacist_email" attrs="{'invisible':[('is_refillable', '=', False)], 'required': [('has_reminder', '=', True)]}"/>
                                <field name="patient_email" attrs="{'invisible':[('is_refillable', '=', False)], 'required': [('has_reminder', '=', True)]}"/>
                                <field name="next_refill_date" invisible="1"/>
                            </group>
                            <button name="generate_refill_lines" type="object" string="Generate Refill Lines" class="oe_highlight" attrs="{'invisible': [('refill_line_generated', '=', True)]}" />
                                <field name="refill_line_generated" invisible="1" />
                            <group>
                                <field name="prescription_detail_ids" nolabel="1" attrs="{'invisible': [('is_refillable', '=', False)], 'required': [('is_refillable', '=', True)]}">
                                    <tree string="Refill Details" editable="bottom">
                                        <field name="date_refill_proposed" />
                                        <field name="date_refill_actual" />
                                        <field name="state" />
                                        <field name="prescription_line_id" invisible="1" />
                                        <button name="confirm_refill" type="object" string="Dispense" class="oe_highlight" attrs="{'invisible': [('state', '=', 'done')]}"/>
                                    </tree>
                                </field>
                            </group>
                        </page>
                        <page name="ecommerce_config" string="eCommerce Configurations">
                            <group>
                                <group>
                                    <field name="website_product_id" domain="[('default_code', '=', 'Website')]"/>
                                </group>
                                <group>
                                    <label for="maximum_order_qty" />
                                    <div>
                                        <field name="maximum_order_qty" style="width: 60%"/>
                                        <field name="online_uom_id" style="width: 37%; margin-left: 3%" />
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button special="cancel" string="Cancel" class="pull-left"/>
                    <button name="action_save" type="object" string="Save" class="oe_highlight pull-right"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
