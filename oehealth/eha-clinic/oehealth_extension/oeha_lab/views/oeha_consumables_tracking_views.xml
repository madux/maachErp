<?xml version="1.0"?>
<odoo>
    <data>
        <record id="view_oeha_lab_consumables_tracking_tree" model="ir.ui.view">
            <field name="name">view.oeha.lab.consumables.tracking.tree</field>
            <field name="model">oehealth_extension.consumables.tracking</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string='Consumable Tracking'>
                    <field name="name"/>
                    <field name="import_file_name"/>
                    <field name="run_by" />
                    <!-- <field name="branch_id" /> -->
                    <field name="number_of_samples" />
                    <field name="state" />
                </tree>
            </field>
        </record>

        <record id="view_oeha_lab_consumables_tracking_form" model="ir.ui.view">
            <field name="name">view.oeha.lab.consumables.tracking.form</field>
            <field name="model">oehealth_extension.consumables.tracking</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form name="Consumable Tracking">
                    <header>
                        <button name="confirm" class="oe_highlight" type="object" string="Confirm" attrs="{'invisible': ['|', ('lines_computed', '=', False), ('state', '!=', 'draft')]}" />
                        <button name="compute_product_quantities" class="oe_highlight" type="object" string="Compute Lines" attrs="{'invisible': ['|', ('lines_computed', '!=', False), ('state', '!=', 'draft')]}" />
                        <button name="generate_picking" class="oe_highlight" type="object" string="Create Picking" states="confirm"/>
                        <button name="cancel" type="object" string="Cancel" states="done" groups="oehealth_extension.group_covid_consumables_manager" />
                        <button name="reset" type="object" string="Set to Draft" states="cancel" groups="oehealth_extension.group_covid_consumables_manager" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,done" />
                    </header>
                    <sheet name="Labtest mapping">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pickings" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="picking_count" string="Pickings" widget="statinfo"/>
                        </button>
                    </div>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="import_file_name" />
                                <field name="run_by" />
                                <!-- <field name="branch_id" /> -->
                                <field name="lines_computed" invisible="1" />
                            </group>
                            <group>
                                <field name="number_of_samples" />
                                <field name="picking_type_id" default="%(oehealth_extension.stock_picking_type_covid_consumables)d"/>
                                <field name="test_type_id" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Product Details">
                                <field name="line_ids" context="{'default_tracking_id': active_id}">
                                    <tree>
                                        <field name="product_id" />
                                        <field name="name" string="Description" />
                                        <field name="apply_to" />
                                        <field name="qty" />
                                        <field name="uom_id" />
                                        <field name="tracking_id" invisible="1" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="oeha_consumables_tracking_view_search" model="ir.ui.view">
            <field name="name">oeha.lab.consumables.tracking.view.search</field>
            <field name="model">oehealth_extension.consumables.tracking</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="run_by" />
                    <field name="picking_type_id" />
                    <field name="test_type_id" />
                    <field name="state" />
                    <field name="picking_id" />
                    <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]" context="{'group_by': 'state'}" />
                    <filter name="filter_confirm" string="Confirmed" domain="[('state', '=', 'confirm')]" context="{'group_by': 'state'}" />
                    <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]" context="{'group_by': 'state'}" />
                    <filter name="filter_cancel" string="Cancelled" domain="[('state', '=', 'cancel')]" context="{'group_by': 'state'}" />
                    <filter name="filter_manual_run" string="Manual Run" domain="[('run_by', '=', 'manual')]" context="{'group_by': 'run_by'}" />
                    <filter name="filter_robot_run" string="Robot Run" domain="[('run_by', '=', 'robot')]" context="{'group_by': 'run_by'}" />
                </search>
            </field>
        </record>

        <record id="action_oeha_lab_consumables_tracking" model="ir.actions.act_window">
            <field name="name">Consumables Tracking</field>
            <field name="res_model">oehealth_extension.consumables.tracking</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                Click to add a new record.
                </p>
            </field>
        </record>

        <menuitem id="menu_consumables_tracking" name="Consumable Tracking" parent="oehealth.oeh_medical_laboratory_menu" action="action_oeha_lab_consumables_tracking" />
    </data>
</odoo>