<?xml version="1.0"?>
    <odoo>
        <data>
        <record model="ir.ui.view" id="view_oeha_lab_test_reason_tree">
            <field name="name">Lab Test reason</field>
            <field name="model">oeha.lab.reason.model</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string='Lab test Reason'>
                    <field name="name"/>
                    <field name="related_partner_tag"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_oeha_lab_test_reason_form">
            <field name="name">Lab Test reason</field>
            <field name="model">oeha.lab.reason.model</field>
            <field name="arch" type="xml">
                <form string="Lab test Reason">
                    <sheet>
                        <div class="oe_title">
                            <label class="oe_edit_only" for="name" string="Name" />
                            <h1><field name="name" class="oe_inline" placeholder="e.g Inbound" required="1" readonly="0"/></h1>
                        </div>
                        <group name="outer">
                            <group name="left">
                                <field name="related_partner_tag" widget="many2many_tags" invisible="0" required="1" readonly="0" options="{'no_create': True, 'no_open': True}"/>
                            </group>

                            <group name="right">
                            </group>

                            <field name="partner_reference_line" editable="bottom" readonly="0">
                                <tree string="Partner &amp; CIF Lines" editable="bottom">
                                    <field name="partner_id" required="1"/>
                                    <field name="related_cif_ids" required="1" widget="many2many_tags"/>
                                </tree>
                                <form string="Partner &amp; CIF">
                                    <group>
                                        <group>
                                            <field name="partner_id"/>
                                        </group>
                                        <group>
                                            <field name="related_cif_ids" widget="many2many_tags"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                             
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_oeha_labtest_reason_action" model="ir.actions.act_window">
            <field name="name">Lab test reason</field>
            <field name="res_model">oeha.lab.reason.model</field>

            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="view_id" eval="False"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                Click to add a new record.
                </p>
            </field>
        </record>

        
        <menuitem action="view_oeha_labtest_reason_action" name="Referring Partner &amp; Reason"
            id="view_oeha_labtest_reason_menu" parent="oehealth.oeh_medical_conf_laboratory"
            sequence="30"
        />
        </data>
    </odoo>