<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--Email template -->
        <record id="lab_review_email_template" model="mail.template">
            <field name="name">Lab Test Review - Send by Email</field>
            <field name="email_from">"${object.care_provider_who_ordered_test.company_id.name|safe}"${(object.care_provider_who_ordered_test.company_id.email or '')|safe}</field>
            <field name="subject">Lab test result ready for Review</field>
            <field name="email_to">${ctx['email_to']}</field>
            <field name="model_id" ref="oehealth.model_oeh_medical_lab_test"/>
            <field name="body_html"><![CDATA[
                <div style="padding:0px;width:960px;margin:auto;background: #FFFFFF repeat top /100%;color:#777777">
                    <table cellspacing="0" cellpadding="0" style="width:600px;background:inherit;color:inherit">
                        <tbody><tr>
                            <td valign="center" width="200" style="padding:10px 10px 10px 5px;font-size: 12px">
                                <img src="/logo.png" style="padding: 0px; margin: 0px; height: auto; width: 80px;" alt="${object.care_provider_who_ordered_test.company_id.name}">
                            </td>
                        </tr></tbody>
                    </table>
                </div>
                <p>Dear ${object.care_provider_who_ordered_test.name},<br/>
                    <br/>
                    The ${object.test_type.name} result for ${object.patient.partner_id.name} is ready for review.
                    Please click on the link below to view results
                    <br/><br/>
                    <a href="https://www.eha.ng/web#id=${object.id}&action=921&active_id=1&model=oeh.medical.lab.test&view_type=form&menu_id=734">Review Lab Test</a>
                    <br/><br/>
                    Regards
                    </br>
                
                </p>
                <br/>
                <div style="width: 960px; margin: 0px; padding: 0px; background-color: #007bff; background-repeat: repeat no-repeat;">
                    <h3 style="margin: 0px; padding: 2px 14px; font-size: 12px; color: #DDD;">
                        &nbsp;
                    </h3>
                </div>
                <div style="width: 960px; margin: 0px; line-height: 16px; background-color: #F2F2F2;">
                    <div style="color: #222; margin-bottom: 5px; padding: 5px 14px; ">
                        ${object.care_provider_who_ordered_test.company_id.partner_id.sudo().with_context(show_address=True, html_format=True).name_get()[0][1] | safe}
                    </div>
                    % if object.care_provider_who_ordered_test.company_id.phone:
                        <div style="padding: 5px 14px;">
                            Phone:&nbsp; ${object.care_provider_who_ordered_test.company_id.phone}
                        </div>
                    % endif
                    % if object.care_provider_who_ordered_test.company_id.website:
                        <div style="padding: 5px 14px;">
                            Web :&nbsp;<a href="${object.care_provider_who_ordered_test.company_id.website}">${object.care_provider_who_ordered_test.company_id.website}</a>
                        </div>
                    %endif
                    <p></p>
                </div>
            ]]></field>
        </record>
    </data>
</odoo>
