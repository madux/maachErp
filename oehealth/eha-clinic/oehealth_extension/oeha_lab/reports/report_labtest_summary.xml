<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_oeh_medical_patient_labtest_summary_document">
        <t t-call="web.external_layout">
            <div class="row mt32 mb32">
                
            </div>

            <div class="page">
                <div class="oe_structure"/>
                <h2> Atila Sars-CoV-2 Test Summary</h2>
                <table class="table table-condensed mt32">
                    <thead>
                        <tr>
                            <th class="text-left">Name</th>
                            <th class="text-left">Lab test ID</th>
                            <th class="text-left">Test Type</th>
                            <th class="text-left">Date</th>
                            <th class="text-left">Result</th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <tr t-foreach="o.active_lab_ids" t-as="act">
                            <td class="text-left">
                            <strong><span t-field="act.patient.partner_id.name"/></strong>
                            </td>
                            <td>
                                <span t-field="act.name"/>
                            </td>
                            <td class="text-left">
                                <span t-field="act.test_type"/>
                            </td>
                            <td class="text-left">
                                <span t-field="act.date_analysis" t-options='{"format": "dd/MMM/yyyy"}'/>
                            </td>

                            <td class="text-left">
                                <t t-foreach="act.lab_test_criteria" t-as="l">
                                    <t t-if="l.sequence == 6">
                                        <span t-field="l.result"/>
                                    </t>
                                </t>
                            </td>
                            
                        </tr>
                    </tbody>
                </table><br/>
                Please note that your test result is attached to this email and might be encrypted. <br/>
                To unlock and view your test results, please provide your surname and date of birth<br/>
                e.g. If your name is John Momoh and your date of birth is 15 January 1980, your password is <strong>momoh15011980</strong><br/>
                Do not hesitate to contact the clinic if you have any questions.
                <table>
                    <tr>
                    <td>
                        <span> For EHA Clinics:</span>
                    </td>
                    </tr>
                    <tr>
                    <td>
                        <img src="https://i.imgur.com/OXoZIeY.jpg" style="max-height: 120px;" />
                        </td>
                    </tr>
                    <tr>
                    <td>
                        <span> Anthonia Hananiya</span>
                        </td>
                    </tr>
                    <tr>
                    <td>
                        <span> Chief Medical Officer</span>
                        </td>
                    </tr>
                </table>
                <div class="oe_structure"/>
            </div>
    </t>
    </template>
    <template id="report_oeh_medical_patient_summary_labtest">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="oehealth_extension.report_oeh_medical_patient_labtest_summary_document"/>
            </t>
        </t>
    </template>
    <report
        string="Lab Test Summary Report"
        id="action_summary_report_patient_labtest"
        model="batch.labtest.emailing"
        report_type="qweb-pdf"
        name="oehealth_extension.report_oeh_medical_patient_summary_labtest"
        file="oehealth_extension.report_oeh_medical_patient_summary_labtest"
    />

</odoo>
