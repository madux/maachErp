<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record model="res.partner.category" id="id_referring_partner_tag">
            <field name="name">REFERRING PARTNER</field>
            <field name="active">True</field>
        </record>

        <record model="oeha.lab.reason.model" id="id_res_outbound_tag">
            <field name="name">Outbounds</field>
            <field name="related_partner_tag" eval="[(6, 0, [ref('oehealth_extension.id_referring_partner_tag')])]"/>
        </record>

        <record model="oeha.lab.reason.model" id="id_res_inbound_tag">
            <field name="name">Inbounds</field>
            <field name="related_partner_tag" eval="[(6, 0, [ref('oehealth_extension.id_referring_partner_tag')])]"/>
        </record>

        <record model="oeha.lab.reason.model" id="id_res_nontravel_tag">
            <field name="name">Non travels</field>
            <field name="related_partner_tag" eval="[(6, 0, [ref('oehealth_extension.id_referring_partner_tag')])]"/>
        </record> 

        <!-- Lab test cron for completed results -->
        <record id="cron_lab_test_mail_result" model="ir.cron">
            <field name="name">Cron Send Completed Lab Result via Email</field>
            <field name="active" eval="False" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall">0</field>
            <field name="model_id" ref="model_oeh_medical_lab_test"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_lab_result_mail()</field>
        </record>
        <!--COVID-19 Lab result sms-->

        <record id="covid19_result_sms" model="ir.config_parameter">
            <field name="key">oeha_lab.covid19.result.sms</field>
            <field name="value"> Hello {first_name} Your COVID-19 result is ready. Download your result with Lab test number {labtest_no} on www.eha.ng/services/check-test-results.</field>
        </record>

        <record id="cron_sms_covid19_result" model="ir.cron">
            <field name="name">SMS COVID-19 Result </field>
            <field name="active" eval="False" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall">0</field>
            <field name="model_id" ref="model_oeh_medical_lab_test"/>
            <field name="state">code</field>
            <field name="code">model.cron_sms_covid19_result()</field>
        </record>
    </data>
    <data noupdate="1">
        <record id="covid_sms_cutoff_date" model="ir.config_parameter">
            <field name="key">oehealth_extension.covid_sms_cutoff_date</field>
            <field name="value" eval="(datetime.now().strftime('%Y-%m-%d %H:%M:%S'))"/>
        </record>
        <record id="covid_sms_max_retries" model="ir.config_parameter">
            <field name="key">oehealth_extension.covid_sms_max_retries</field>
            <field name="value" eval="3"/>
        </record>
    </data>

    <data noupdate="0">
        <record id="covid_consumable_dest_location" model="stock.location">
            <field name="name">Covid Test</field>
            <field name="usage">inventory</field>
        </record>

        <record id="seq_covid_consumable_code" model="ir.sequence">
            <field name="name">EHA Clinics Covid Consu Sequence Out Code</field>
            <field name="code">stock.picking.covid.consu.code</field>
            <field name="prefix">WH/COVID/CONSU/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="stock_picking_type_covid_consumables" model="stock.picking.type">
            <field name="name">Covid Consumables</field>
            <field name="sequence_code">COVID/CONSU/</field>
            <field name="code">internal</field>
            <field name="sequence_id" eval="ref('oehealth_extension.seq_covid_consumable_code')" />
            <field name="default_location_src_id" eval="ref('stock.stock_location_stock')" />
            <field name="default_location_dest_id" eval="ref('oehealth_extension.covid_consumable_dest_location')" />
            <field name="company_id" eval="ref('base.main_company')" /> 
        </record>
    </data>

    <data noupdate="1">
        <record id="labtest_complete_cloud_function_url_param" model="ir.config_parameter">
            <field name="key">oehealth_extension.labtest_complete_cloud_function_url_param</field>
            <field name="value"></field>
        </record>
    </data>
    
</odoo> 