<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_form_labtest_export" model="ir.ui.view">
            <field name="name">view.form.labtest.export</field>
            <field name="model">oeh.medical.lab.test.export</field>
            <field name="arch" type="xml">
                <form string="Lab test export">
                    <sheet>
                        <group>
                            <div>
                                <field name="labtest_ids" />
                            </div>
                        </group>
                    </sheet>
                    <footer>
                        <button name="export_lab_test" type="object" string="Export" class="oe_highlight" />
                        <button special="cancel" string="Cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="labtest_export_action" model="ir.actions.act_window">
            <field name="name">Export NITP Results</field>
            <field name="res_model">oeh.medical.lab.test.export</field>
            <field name="view_mode">form</field>
            <field name="context">{'default_labtest_ids': active_ids}</field>
            <field name="target">new</field>
            <field name="views">[[False, 'form']]</field>
            <field name="binding_model_id" ref="oehealth.model_oeh_medical_lab_test" />
        </record>

    </data>
</odoo>
