<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Hide Oehealth Health Center Button in Clinic Menu -->

		<record id="make_invisible" model="res.groups">
			<field name="name">Invisible</field>
		</record>
		
		<record model="ir.ui.menu" id="oehealth.oeh_medical_healthcenters_list">
			<field name="groups_id" eval="[(6,0,[ref('make_invisible')])]"/>
		</record>

        <record id="view_medical_healthcenters_bed_filter" model="ir.ui.view">
            <field name="name">Bed Search</field>
            <field name="model">oeh.medical.health.center.beds</field>
            <field name="inherit_id" ref="oehealth.view_medical_healthcenters_bed_filter"/>
            <field name="arch" type="xml">
                <filter name="group_health_centers" position="replace" />
            </field>
        </record>

        <record id="view_oeh_medical_appointment_filter" model="ir.ui.view">
            <field name="name">Appointment Search</field>
            <field name="model">oeh.medical.appointment</field>
            <field name="type">search</field>
            <field name="inherit_id" ref="oehealth.view_oeh_medical_appointment_filter"/>
            <field name="arch" type="xml">
                <filter name="group_health_center" position="replace"/>
                <field name="institution" position="replace"/>
            </field>
        </record>

        <record id="view_medical_healthcenters_ward_filter" model="ir.ui.view">
            <field name="name">Ward Search</field>
            <field name="model">oeh.medical.health.center.ward</field>
            <field name="priority" eval="8" />
            <field name="inherit_id" ref="oehealth.view_medical_healthcenters_ward_filter"/>
            <field name="arch" type="xml">
                <filter name="group_health_center" position="replace"/>
                <field name="institution" position="replace"/>
            </field>
        </record>

        <record id="view_medical_healthcenters_building_filter" model="ir.ui.view">
            <field name="name">Building Search</field>
            <field name="model">oeh.medical.health.center.building</field>
            <field name="priority" eval="8" />
            <field name="inherit_id" ref="oehealth.view_medical_healthcenters_building_filter"/>
            <field name="arch" type="xml">
                <filter name="group_health_center" position="replace"/>
                <field name="institution" position="replace"/>
            </field>
        </record>

        <record id="view_medical_healthcenters_pharmacy_filter" model="ir.ui.view">
            <field name="name">Pharmacies Search</field>
            <field name="model">oeh.medical.health.center.pharmacy</field>
            <field name="priority" eval="8" />
            <field name="inherit_id" ref="oehealth.view_medical_healthcenters_pharmacy_filter"/>
            <field name="arch" type="xml">
                <filter name="group_health_centers" position="replace"/>
                <field name="institution" position="replace"/>
            </field>
        </record>

    </data>
</odoo>