<?xml version="1.0"?>
    <odoo>
        <record id="confirm_create_order_wizard" model="ir.ui.view">
            <field name="name">Comfirm Create Order</field>
            <field name="model">confirm.order.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirm Create Order">
                    <group>
                        <separator style="font-size:14px" string="No Open Sale Order Found for the Patient." colspan="4"/>
                        <separator style="font-size:14px" string="Do you want to create a new Sale Order?" colspan="4"/>
                    </group>
                    <footer>                        
                        <button name="open_sale_order" confirm="Are you sure you want to create Sales Order ?" string="Create Sale Order" type="object" class="oe_highlight" />
                        <button string="Close" class="oe_link" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- <act_window id="action_confirm_create_order"
                    name="Confirm Create Sale Order"
                    context="{}"
                    res_model="confirm.order.wizard"
        /> -->
        <record id="action_confirm_create_order" model="ir.actions.act_window">
            <field name="name">Confirm Create Sale Order</field>
            <field name="res_model">confirm.order.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </odoo>