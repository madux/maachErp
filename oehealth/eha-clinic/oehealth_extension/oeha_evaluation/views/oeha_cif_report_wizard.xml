<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

	<record id="inbound_testers_report_view_form" model="ir.ui.view">
        <field name="name">Inbound Testing Report</field>
        <field name="model">oeha.cif.reportwizard</field>
        <field name="arch" type="xml">
        	<form>
        		<group>
                    <group>
                        <field name="filter_type" string='Filter Type(Inbound)' required="1"/>
                        <field name="datefrom" />

                    </group>
                    <group>
                        <field name="dateto" />
                    </group>
                     
                </group>
                
        		<footer>
	                <button name="action_view_records" string="View Records" type="object" default_focus="1" class="oe_highlight" />
                    or
	                <button string="Cancel" class="oe_link" special="cancel" />
	            </footer>
			</form>
        </field>
    </record>

	<record id="action_inbound_testers_view_wizard" model="ir.actions.act_window">
        <field name="name">Inbound Testing Report</field>
        <field name="res_model">oeha.cif.reportwizard</field>
        <field name="type">ir.actions.act_window</field>

        <field name="view_mode">form</field>
        <field name="view_id" ref="inbound_testers_report_view_form"/>
        <field name="target">new</field>
    </record>
     
	<menuitem id="covid_inbound_testers_menu_report" name="C19 Inbound Testing Reports" action="action_inbound_testers_view_wizard" parent="oehealth.oeh_medical_patients_menu" sequence="14"/>
</data>
</odoo>