<?xml version="1.0"?>
    <odoo>
        <record id="view_oeha_covid19_cif_search" model="ir.ui.view">
            <field name="name">oeha.covid19.cif.search</field>
            <field name="model">oeha.covid19.cif</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search Templates">
                    <separator orientation="vertical"/>
                        <field name="name" select="1"/>
                        <field name="patient_id"/>
                        <field name="phone" select="1"/>
                        <field name="email" select="1"/>
                        <field name="flight" select="1"/>
                        <field name="gender" select="1"/>
                        <field name="url_token" />
                        <field name="filename" select="1"/>
                        <field name="create_date" />
                        <field name="covid_19_inbound_tester" select="1"/>
                        <field name="is_outbound_tester" select="1"/>
                        <field name="is_non_travel" />
                        <field name="sample_collect_state" select="1"/>
                        <field name="payment_ref" string="Payment Reference" select="1"/>
                        <field name="arrival_date" string="Arrival Date" select="1"/>
                        <field name="source"/>
                        <field name="has_day2_testing" string="Day 2 Testing"/>
                        <field name="is_appointment_simplybook" />
                        <field name="nitp_booking_id" />
                        <field name="vaccination_status" />
                        <field name="labtest_result" />
                    <newline/>
                    <group expand="0" string="Group By...">
                        <filter name="group_flight" string="Flight"  domain="[]" context="{'group_by':'flight'}"/>
                        <filter name="group_flightdate" string="Flight Date"  domain="[]" context="{'group_by':'flight_date'}"/>
                        <filter name="group_test_location" string="Test Location"  domain="[]" context="{'group_by':'test_location'}"/>
                        <filter name="group_gender" string="Gender"  domain="[]" context="{'group_by':'gender'}"/>
                        <filter name="group_date_paid" string="Date Paid"  domain="[]" context="{'group_by':'create_date'}"/>
                        <filter name="covid_19_inbound_tester" string="Covid 19 Inbound Testing"  domain="[]" context="{'group_by':'covid_19_inbound_tester'}"/>
                        <filter name="is_outbound_tester" string="Covid 19 Outbound Testing"  domain="[]" context="{'group_by':'is_outbound_tester'}"/>
                        <filter name="is_non_travel" string="Covid 19 Non-Travel Testing"  domain="[]" context="{'group_by':'is_non_travel'}"/>
                        <filter name="appointment_date" string="Proposed Date"  domain="[]" context="{'group_by':'appointment_date'}"/>
                        <filter name="has_booked" string="Has Booked Appointment"  domain="[]" context="{'group_by':'has_booked'}"/>
                        <filter name="evaluation_generated" string="Evaluation generated"  domain="[]" context="{'group_by':'payment_ref'}"/>
                        <filter name="arrival_date" string="Arrival Date"  domain="[]" context="{'group_by':'arrival_date'}"/>
                        <filter name="has_day2_testing" string="Day 2 Testing"  domain="[('has_day2_testing', '=', True)]" context="{'group_by':'has_day2_testing'}"/>
                        <filter name="has_day7_testing" string="Day 7 Testing"  domain="[('has_day2_testing', '=', False)]" context="{'group_by':'has_day7_testing'}"/>
                        <filter name="vaccination_status" string="Vaccinated"  domain="[('vaccination_status', '=', 'Vaccinated')]" context="{'group_by':'vaccination_status'}"/>

                    </group>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="view_oeha_covid19_cif_list">
            <field name="name">oeha.covid19.cif.list</field>
            <field name="model">oeha.covid19.cif</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string='Templates'>
                    <field name="patient_id"/>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="gender" />
                    <field name="flight"/>
                    <field name="flight_date"/>
                    <field name="test_location"/>
                    <field name="create_date" string="Create Date"/>
                    <field name="appointment_date" string="Proposed Date"/>
                    <field name="arrival_date" string="Arrival Date"/>
                    <field name="source" />
                    <field name="nitp_booking_id" />
                    <field name="vaccination_status" />
                    <field name="labtest_result" />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_oeha_covid19_cif_form">
            <field name="name">oeha.covid19.cif.form</field>
            <field name="model">oeha.covid19.cif</field>
            <field name="arch" type="xml">
                <form string="Templates">
                    <header>
                        <field name="identification_code" invisible="1" />
                        <button name="%(oehealth.oeh_medical_patient_action_tree)d" 
                            string="Patient Record" 
                            type="action" 
                            class="oe_highlight" 
                            context="{'default_id': patient_id, 'search_default_identification_code': identification_code}"
                            />
                            <button name="generate_covid_eval" 
                            string="Generate Evaluation Record" 
                            type="object" 
                            class="oe_highlight" 
                            attrs="{'invisible': [('evaluation_generated', '=', True)]}"
                            />
                           <button name="action_merge_records" 
                            string="Merge Records" 
                            type="object" 
                            groups="base.group_system"
                            />
                            <button name="button_triage_form" 
                            string="Update triage" 
                            type="object" 
                            />
                            <button name="book_appointment" 
                            string="Book Appointment" 
                            type="object" 
                            />
                    </header>
                    <sheet>
                        <div class="oe_title" >
                            <label class="oe_edit_only" for="name" string="" />
                            <h1><field name="name" class="oe_inline" readonly="1"/></h1>
                        </div>
                        <group name="outer">
                            <group name="left">
                                <field name="patient_id" required="1" options="{'no_create': True}" readonly="0"/>
                                <field name="phone" />
                                <field name="email" />
                                <field name="gender"/>
                                <field name="dob" />
                                <field name="street" />
                                <field name="city" />
                                <field name="state_id" />
                                <field name="country_id" />
                                <field name="test_location_id" invisible="1"/>
                                <field name="test_location"/>
                            </group> 
                            <group name="right">
                                <field name="flight" />
                                <field name="flight_date"/>
                                <field name="destination"/>
                                <field name="id_card"/>
                                <field name="id_card_country"/>
                                <field name="passport_attachment" />
                                <field name="appointment_date" string="Proposed Date"/>
                                <field name="is_non_travel" />
                                <field name="covid_19_inbound_tester" string="Is Inbound Testing"/>
                                <field name="is_outbound_tester" string="Is Outbound Testing"/>                                
                                <field name="is_payment_required" string="Is Payment Required"/>
                                <field name="thirdparty_partner_id" widget="many2many_tags" required="1"/>
                                <field name="sample_collect_state"/>
                                <field name="nationality" />
                                <field name="depature_country" />
                                <field name="arrival_date" string="Arrival Date"/>
                                <field name="create_date" string="Created On"/>
                                <field name="filename" string="Imported file"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Other information">
                                <group>
                                    <group>
                                        <field name="url_token" string="URL Token" readonly="1"/>
                                        <field name="source" />
                                        <field name="cif_json" string="CIF Json"/>
                                        <field name="is_appointment_simplybook" />
                                        <field name="has_booked"/>
                                        <field name="evaluation_generated"/>
                                        <field name="evaluation_id" options="{'no_create': True}"/>
                                        <field name="labtest_id"/>
                                        <field name="labtest_result"/>
                                        <field name="labtest_ids" widget="many2many_tags" />
                                        <field name="test_type_tag" />
                                        <field name="sale_order_id" options="{'no_create': True}"/>
                                        <field name="agreed_for_airline" readonly="1"/>
                                        <field name="agreed_for_emb_public_health" readonly="1"/>
                                        
                                    </group>
                                    <group>
                                        <field name="payment_ref" readonly="1"/>
                                        <field name="destination_json" />
                                        <field name="payment_transaction_id" />
                                        <field name="payment_status" />
                                        <field name="appointment_data" />
                                        <field name="has_day2_testing" />
                                        <field name="day2_testing_date" />
                                        <field name="day7_testing_date" />
                                        <field name="post_date" string="Post date"/>
                                        <field name="nitp_booking_id" />
                                        <field name="vaccination_status" />
                                        <field name="simplybookme_appointment_date" readonly="1" force_save="1"/>
                                        <field name="simplybookme_appointment_code" string="EMR booking code" readonly="1" force_save="1"/>
                                        <field name="simplybookme_reschedule_reason" readonly="1" force_save="1"/>
                                         
                                    </group>
                                    <group/>
                                </group>
                            </page>
                            <page string="Mail Logs / Status">
                                <field name="mail_log_ids" readonly="1" string="Emails">
                                    <tree string="Emails" editable="bottom">
                                        <field name="subject" string="SUbject"/>
                                        <field name="date" string="Date"/>
                                        <field name="state" string="Status"/>
                                        <field name="email_from" string="From"/>
                                    </tree>
                                </field>
                            </page>
                            
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_oeha_covid19_cif_action" model="ir.actions.act_window">
            <field name="name">Online COVID-19 Test</field>
            <field name="res_model">oeha.covid19.cif</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="view_id" eval="False"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                Click to add a new record.
                </p>
            </field>
        </record>

        <!-- Home sample collection -->
        <record id="view_oeha_homesample_collection_search" model="ir.ui.view">
            <field name="name">oeha.oeha.homesample.collection.search</field>
            <field name="model">oeha.homesample.collection</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Search Templates">
                    <separator orientation="vertical"/>
                        <field name="partner_id" select="1"/>
                        <field name="city"/>
                        <field name="phone" select="1"/>
                        <field name="street" select="1"/>
                    <newline/>
                    <group expand="0" string="Group By...">
                        <filter name="group_partner_name" string="Partner" domain="[]" context="{'group_by':'partner_id'}"/>
                        <filter name="group_city" string="City" domain="[]" context="{'group_by':'city'}"/>
                        <filter name="group_phone" string="Phone" domain="[]" context="{'group_by':'phone'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="view_oeha_homesample_collection_list">
            <field name="name">oeha.homesample.collection.list</field>
            <field name="model">oeha.homesample.collection</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string='Templates'>
                    <field name="partner_id"/>
                    <field name="phone"/>
                    <field name="city"/>
                    <field name="create_date" />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_oeha_homesample_collection_form">
            <field name="name">oeha.homesample.collection.form</field>
            <field name="model">oeha.homesample.collection</field>
            <field name="arch" type="xml">
                <form string="Home sample collection Form">
                    <header>
                    </header>
                    <sheet>
                        <!-- <field name="image" widget='image' class="oe_left oe_avatar" options='{"preview_image": "image_medium", "size": [90, 90]}'/> -->
                        <div class="oe_title" >
                            <label class="oe_edit_only" for="partner_id" string="" />
                            <h1><field name="partner_id" class="oe_inline" readonly="1"/></h1>
                        </div>
                        <group name="outer">
                            <group name="left">
                                <field name="city" />
                                <field name="street" />
                            </group>
                            <group name="right">
                                <field name="phone"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="CIF RECORDS">
                                <field name="cif_ref_ids" readonly="1" string="CIF REFS">
                                    <tree string="CIF Refs" editable="bottom"> 
                                        <field name="patient_id" string="Patient" invisible="0"/>
                                        <field name="identification_code" string="ID"/>
                                        <field name="gender" string="Gender"/>
                                        <field name="dob" string="Date of Birth"/> 
                                        <field name="test_location" string="Test Location"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_oeha_homesample_collection_action" model="ir.actions.act_window">
            <field name="name">Home Sample Collection</field>
            <field name="res_model">oeha.homesample.collection</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="view_id" eval="False"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                Click to add a new record.
                </p>
            </field>
        </record>

        <menuitem action="view_oeha_homesample_collection_action" 
            id="view_oeha_homesample_collection_menu" 
            parent="oehealth.oeh_medical_patients_menu" 
            sequence="5"
            groups="oehealth_extension.external_command_center,oehealth_extension.group_oeh_medical_op_ass,oehealth_extension.group_oeh_medical_lab_off"
        />
        <!-- HOME COLLECTION ENDS -->

        <!-- Send email notification -->
        <!-- <act_window id="batch_appointment_emailing_action" name="Send Notification"
            context="{'default_cif_mail_type': 'inbound', 'default_appointment_booking': True}"
            res_model="batch.labtest.emailing"
            view_mode="form"
            binding_model="oeha.covid19.cif"
        /> -->
        <record id="batch_appointment_emailing_action" model="ir.actions.act_window">
            <field name="name">Send Notification</field>
            <field name="res_model">batch.labtest.emailing</field>
            <field name="context">{'default_cif_mail_type': 'inbound', 'default_appointment_booking': True}</field>
            <field name="view_mode">form</field>
            <field name="binding_model_id" ref="oehealth_extension.model_oeha_covid19_cif"/>
            <field name="target">new</field>
        </record>
        
        <!--book NITP appointment-->
        <!-- <act_window id="batch_appointment_booking_action" name="Book Appointment"
            context="{'default_text': 'Are you sure you want to book the appointments?'}"
            res_model="wizard.confirm.nitp.appointment"
            view_mode="form"
            binding_model="oeha.covid19.cif"
        /> -->
        <record id="batch_appointment_booking_action" model="ir.actions.act_window">
            <field name="name">Book Appointment</field>
            <field name="res_model">wizard.confirm.nitp.appointment</field>
            <field name="context">{'default_text': 'Are you sure you want to book the appointments?'}</field>
            <field name="view_mode">form</field>
            <field name="binding_model_id" ref="oehealth_extension.model_oeha_covid19_cif"/>
            <field name="target">new</field>
        </record>

        <menuitem action="view_oeha_covid19_cif_action"
            id="view_oeha_covid19_cif_menu"
            parent="oehealth.oeh_medical_patients_menu"
            sequence="4"
            groups="oehealth_extension.external_command_center,oehealth_extension.group_oeh_medical_op_ass,oehealth_extension.group_oeh_medical_lab_off,base.group_user"
        />

    </odoo>