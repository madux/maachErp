<?xml version="1.0"?>
    <odoo>
        <record model="ir.ui.view" id="oeha_nurse_assessment_tree">
            <field name="name">Nurse Assessment</field>
            <field name="model">oeha.nurse.assessment</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string='Nurse Assessment'>
                    <field name="patient"/>
                    <field name="patient_id" readonly="1"/>

                    <field name="user_id"/>
                    <field name="assessment_date"/>
                    <field name="completed_date"/>
                    <field name="position"/>
                    <field name="state"/>

                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="oeha_nurse_assessment_form">
            <field name="name">Nurse Assessment</field>
            <field name="model">oeha.nurse.assessment</field>

            <field name="arch" type="xml">
                
                <form string="Nurse Assessment">
                    <header>
                        <button name="complete_Assessment" string="Complete" type="object" class="oe_highlight" states="draft"/>

                        <button name="set_draft" string="Set Draft" type="object" 
                            class="oe_highlight" states="Completed"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,Completed" statusbar_colors='{"Completed":"red","draft":"grey"}'/>
                    </header>
                    <sheet>
                        <group name="outer" attrs="{'invisible':[('system_type', '=', 'Notes')],'readonly':[('state', 'in', ['Completed'])]}">
                            <group name="left"> 
                                <field name="patient" invisible="1" options="{&quot;no_open&quot;: True,'no_quick_create':True,'no_create_edit':True}" />
                                <field name="patient_id" readonly="1"/>
                                <field name="assessment_date"/>

                            </group> 
                            <group attrs="{'invisible':[('system_type', '=', 'Notes')]}">
                                <field name="user_id" readonly="1" options="{&quot;no_open&quot;: True,'no_quick_create':True,'no_create_edit':True}" />
                                <field name="position"/>
                                <field name="completed_date" readonly="1"/>
                                <field name="system_type" invisible="1"/>
                            </group>
                            <notebook>
                                <page string="Assessment Form">
                                    <group >
                                        <group colspan="2" string="Nutrition" attrs="{'invisible':[('system_type', '!=', 'Nutrition')]}">
                                            <field name="conditions_affecting_ecs" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="diet" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="mucous_membranes" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="recent_weight_change" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                        </group>

                                        <group colspan="2" string="Skin Condtion" attrs="{'invisible':[('system_type', '!=', 'Skin')]}">
                                            <field name="skin" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="skin_intact" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="special_care" attrs="{'invisible':[('skin_intact', '!=', 'no')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="wound_assessment" attrs="{'invisible':[('skin_intact', '!=', 'no')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                        </group>
                                    
                                        <group colspan="2" string="Neuro" attrs="{'invisible':[('system_type', '!=', 'Neuro')]}">
                                            <field name="difficulty_in_orientation" widget="radio" options="{'horizontal': true}" 
                                            attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="difficulty_in_orientation_other" placeholder="Please Explain..." 
                                            attrs="{'invisible':[('difficulty_in_orientation', '!=', 'yes')], 'required':[('difficulty_in_orientation', '=', 'yes')], 'readonly':[('state', 'in', ['Completed'])]}"/>

                                            <field name="level_of_consciousness" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="impaired_decision_making" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="memory_deficit" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="sensation" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="sleep_aids" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                        </group>
                                        <group colspan="2" string="Pain/Discomfort" attrs="{'invisible':[('system_type', '!=', 'Pain')]}">
                                            <field name="pain" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="pain_score" attrs="{'invisible':[('pain', '=', 'no')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="duration" attrs="{'invisible':[('pain', '=', 'no')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="frequency" attrs="{'invisible':[('pain', '=', 'no')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="location" attrs="{'invisible':[('pain', '=', 'no')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="treatment" attrs="{'invisible':[('pain', '=', 'no')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                        </group>
                                        
                                        <group colspan="2" string="Respiration" attrs="{'invisible':[('system_type', '!=', 'Respiration')]}">
                                            <field name="breath_sounds" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="cough" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="cough_type" attrs="{'invisible':[('cough', '=', 'no')],'readonly':[('state', 'in', ['Completed'])]}"/>
                                            
                                            <field name="shortness_of_breath" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="shortness_of_breath_trigger" attrs="{'invisible':[('shortness_of_breath', '=', 'no')],'required':[('shortness_of_breath', '=', 'yes')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="respirations" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="respiratory_treatment" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                        </group>
                                        <group colspan="2" string="Cardiovascular / Circulation" attrs="{'invisible':[('system_type', '!=', 'Cardiovascular')]}">
                                            <field name="chest_pain" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="explain_chest_pain" placeholder="Please Explain..." attrs="{'invisible':[('chest_pain', '=', 'no')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="edema" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="pitting" widget="radio" options="{'horizontal': true}" attrs="{'invisible':[('edema', '=', 'no')],'required':[('edema', '=', 'yes')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="pitting_location" attrs="{'invisible':[('pitting', '=', 'no')],'required':[('pitting', '=', 'yes')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <!-- <field name="explain_edema" attrs="{'invisible':[('edema', '=', 'no')], 'readonly':[('state', 'in', ['Completed'])]}"/> -->
                                            <field name="history" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="pulse" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            
                                        </group>
                                        <group colspan="2" string="Gastrointestinal System" attrs="{'invisible':[('system_type', '!=', 'Gastrointestinal')]}">
                                            
                                            <field name="bowel_sounds" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="bowel_movement" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="change_in_appetite" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="explain_change_in_appetite" placeholder = "Increased or Descreased" attrs="{'invisible':[('change_in_appetite', '=', 'no')],'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="gastrointestinal_abdominal_pain" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="gastrointestinal_bleeding" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="gastrointestinal_constipation" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="gastrointestinal_diarrhea" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="gastrointestinal_enteral_tube" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="gastrointestinal_gastrostomy" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            
                                            <field name="gastrointestinal_nausea" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="gastrointestinal_vomiting" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            
                                        </group>
                                        <group colspan="2" string="Genitourinary" attrs="{'invisible':[('system_type', '!=', 'Genitourinary')]}">
                                            <field name="bladder_control" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="bladder_frequency" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="blood_in_urine" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="difficulty_urinating" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="indwelling_catheter" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="nocturnia" widget="radio" options="{'horizontal': true}" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                        </group>
                                        <group colspan="2" string="Musculoskeletal" attrs="{'invisible':[('system_type', '!=', 'Musculoskeletal')]}">
                                            <field name="activities_of_daily" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="eating_activities" attrs="{'invisible':[('activities_of_daily', '=', False)], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="bathing_activities" attrs="{'invisible':[('activities_of_daily', '=', False)],'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="dressing_activities" attrs="{'invisible':[('activities_of_daily', '=', False)],'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="mobility" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="assistive_devices" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="range_of_motion" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            
                                        </group>
                                        <group colspan="2" string="Sensory" attrs="{'invisible':[('system_type', '!=', 'Sensory')]}">
                                            <field name="hearing" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="hearing_aid" attrs="{'invisible':[('hearing', '=', 'normal')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="vision" attrs="{'readonly':[('state', 'in', ['Completed'])]}"/>
                                            <field name="corrective_device" attrs="{'invisible':[('vision', '=', 'normal')], 'readonly':[('state', 'in', ['Completed'])]}"/>
                                            
                                        </group>
                                    </group>
                                    <field name="nursing_assessment_notes" placeholder="Add Notes..."/>
                                </page>

                                 
                            </notebook>
                        </group>
                        <separator string="" colspan="2" />
                            <group string="" attrs="{'invisible':[('system_type', '!=', 'Notes')],'readonly':[('state', 'in', ['Completed'])]}">
                                <group colspan="2" string="Notes">
                                    <div>
                                        <field name="nursing_assessment_notes" placeholder="Add Activity Note..."/>
                                    </div>
                                </group>
                                <group colspan="2" string="">
                                    <field name="user_id"  readonly="1" string="Created By" />
                                    <field name="assessment_date" readonly="1" string="Date Created"/>
                                </group>
                            </group>
                                
                          
                    </sheet>
                </form>
            </field>
        </record>

        <record id="oeha_nurse_assessment_action" model="ir.actions.act_window">
            <field name="name">Nurse Assessment</field>
            <field name="res_model">oeha.nurse.assessment</field>

            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="view_id" eval="False"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                Click to add Nurse Assessment.
                </p>
            </field>
        </record>

         
    </odoo>