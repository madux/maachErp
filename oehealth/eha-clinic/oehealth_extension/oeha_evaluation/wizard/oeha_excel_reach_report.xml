<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="view_reach_report_export_form" model="ir.ui.view">
            <field name="name">reach.excel.report.form</field>
            <field name="model">reach.excel.report</field>
            <field name="arch" type="xml">
                <form string="Export Records As XLS">
                        <group>
                            <group>
                                <!-- <separator string="Options" colspan="4"/> -->
                                <field name="filter_by"/>
                                <field name="start_date" string="Start Date"
                                attrs="{'invisible': [('filter_by', '!=', 'date')], 
                                'required': [('filter_by', '=', 'date')]}"/>
                                <field name="end_date" string="End Date" 
                                attrs="{'invisible': [('filter_by', '!=', 'date')], 
                                'required': [('filter_by', '=', 'date')]}"/>
                            </group>
                            <group>
                                <!-- <separator string="File" colspan="2"/> -->
                                
                                <field name="program_id" invisible="0"/>
                                <field name="excel_file" nolabel="0" filename="filename"/>
                                <field name="filename" invisible="1"/>

                            </group>
                        </group>

                    <footer>
                        <button name="button_export_and_download" type='object' string="Export &amp; Download" class="oe_highlight"/>
                        or                        
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                     
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_reach_report_export">
            <field name="name">Export Reach Report as XLS</field>
            <field name="res_model">reach.excel.report</field>

            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_reach_report_export_form"/>
        </record>

        <menuitem id="menu_reach_report_data_export" name="Export Reach Report" action="action_reach_report_export" parent="oehealth.oeh_medical_patients_menu" sequence="101"/>


    </data>
</odoo>