		<t t-name="SaleInvPopupWidget">
			<div class="modal-dialog">
				<div class="popup" style="height: 405px;">
					<p class="title" style="background-color: #019286; color: #fff;">Sale Invoice Workflow</p>
					<div class="body" style="background: #dcdcdc;color: #292929;margin: 0px;border: 10px solid #f0eeee;">
						<div t-if="widget.pos.get_client()" style="min-height: 30px;padding: 10px;">
							<span class="pull-left">Customer</span>
							<span style="margin-right: 10px;" class="pull-right"><t t-esc="widget.pos.get_client().name" /></span>
						</div>
						<div style="min-height: 40px;padding: 10px;">
							<span style="margin-top: 2%;" class="pull-left">Select Type</span>
							<select class="select_sale_inv_id" name='select_sale_inv_id' style="padding: 10px;min-width: 265px;margin-left: 20%;">
								<option value=''>--------------- Select --------------- </option>
								<option value='so_draft'>Create Draft Quotation </option>
								<option value='so_done'>Create and confirm sales order </option>
								<option value='inv_draft'>Create Customer Invoice </option>
								<option value='inv_valid'>Create Invoice and Validate </option>
								<option value='inv_paid'>Create Invoice,validate and paid</option>
							</select>
						</div>
						<div style="min-height: 130px;padding: 10px;">
							<span style="margin-top: 10%;" class="pull-left">Extra Note</span>
							<textarea id="extra_note" type="textarea" class="input-field" name="extra_note" style="width: 250px;margin-left: 20%;height: 100px;"></textarea>
						</div>
						
					</div>
					<div class="footer" style="background-color: #209a8f; color: #fff;">
						<div class="button create_sale_inv" style="background-color: #064c49; color: white;">
							Create
						</div>
						<div class="button cancel_sale_inv" style="background-color: #064c49; color: white;">
							Close 
						</div>
					</div>
				</div>
			</div>
		</t>

		<t t-name="PurchaseBillPopupWidget">
			<div class="modal-dialog">
				<div class="popup" style="height: 405px;">
					<p class="title" style="background-color: #019286; color: #fff;">Purchase Bill Workflow</p>
					<div class="body" style="background: #dcdcdc;color: #292929;margin: 0px;border: 10px solid #f0eeee;">
						<div t-if="widget.pos.get_client()" style="min-height: 30px;padding: 10px;">
							<span class="pull-left">Vendor</span>
							<span style="margin-right: 10px;" class="pull-right"><t t-esc="widget.pos.get_client().name" /></span>
						</div>
						<div style="min-height: 40px;padding: 10px;">
							<span style="margin-top: 2%;" class="pull-left">Select Type</span>
							<select class="select_po_bill" name='select_sale_inv_id' style="padding: 10px;min-width: 265px;margin-left: 20%;">
								<option value=''>--------------- Select ---------------  </option>
								<option value='po_draft'>Create Draft RFQ-Purchase</option>
								<option value='po_done'>Create and confirm Purchase order </option>
								<option value='bill_draft'>Create Vendor Bill </option>
								<option value='bill_valid'>Create Vendor Bill and Validate </option>
								<option value='bill_paid'>Create Vendor Bill,validate and paid</option>
							</select>
						</div>
						<div style="min-height: 130px;padding: 10px;">
							<span style="margin-top: 10%;" class="pull-left">Extra Note</span>
							<textarea id="vendor_note" type="textarea" class="input-field" name="vendor_note" style="width: 250px;margin-left: 20%;height: 100px;"></textarea>
						</div>
						
					</div>
					<div class="footer" style="background-color: #209a8f; color: #fff;">
						<div class="button create_po_bill" style="background-color: #064c49; color: white;">
							Create
						</div>
						<div class="button cancel_po_bill" style="background-color: #064c49; color: white;">
							Close 
						</div>
					</div>
				</div>
			</div>
		</t>

	</templates>
	
	
