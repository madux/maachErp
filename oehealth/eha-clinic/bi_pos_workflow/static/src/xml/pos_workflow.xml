<?xml version="1.0" encoding="UTF-8"?>
	<templates id="pos_workflow_template" inherit_id="point_of_sale.template" xml:space="preserve">
	
		<t t-name="SaleInvoiceFlowButtonWidget" name="Sale-Invoice Workflow Button Widget">
			<t t-if="widget.pos.config.use_sale_flow">
				<div class="control-button button confirm" id="so_inv_flow" style="background-color: #019286; color: #fff;">
					<i class="fa fa-shopping-cart"></i> Sale/Customer Invoice Workflow
					<i class="fa fa-money" style="margin-left: 5px;"></i>
				</div>
			</t>
		</t>

		<t t-name="PurchaseBillFlowButtonWidget" name="Purchase Bill Workflow Button Widget">
			<t t-if="widget.pos.config.use_purchase_flow">
				<div class="control-button button confirm" id="po_bill_flow" style="background-color: #019286; color: #fff;">
					<i class="fa fa-shopping-cart"></i> Purchase/Vendor Bill Workflow
					<i class="fa fa-money" style="margin-left: 5px;"></i>
				</div>
			</t>
		</t>


