<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="view_delivery_carrier_form_with_provider_mydhl" model="ir.ui.view">
    <field name="name">delivery.carrier.form.provider.mydhl</field>
    <field name="model">delivery.carrier</field>
    <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
    <field name="arch" type="xml">
        <xpath expr="//page[@name='destination']" position='before'>
            <page string="MyDHL Configuration" attrs="{'invisible': [('delivery_type', '!=', 'mydhl')]}">
                <group>
                    <group>
                        <field name="dhl_username" attrs="{'required': [('delivery_type', '=', 'mydhl')]}"/>
                        <field name="dhl_password" attrs="{'required': [('delivery_type', '=', 'mydhl')]}"/>
                        <field name="dhl_account_number" attrs="{'required': [('delivery_type', '=', 'mydhl')]}"/>
                        <field name="dhl_dutiable"/>
                        <field name="dhl_region_code" attrs="{'required': [('delivery_type', '=', 'mydhl')]}"/>
                    </group>
                    <group>
                        <field name="dhl_product_code" attrs="{'required': [('delivery_type', '=', 'mydhl')]}"/>
                        <field name="dhl_default_packaging_id" attrs="{'required': [('delivery_type', '=', 'mydhl')]}" domain="[('package_carrier_type', '=', 'dhl')]"/>
                        <field name="dhl_package_weight_unit" attrs="{'required': [('delivery_type', '=', 'mydhl')]}"/>
                        <field name="dhl_package_dimension_unit" attrs="{'required': [('delivery_type', '=', 'mydhl')]}"/>
                        <field name="dhl_label_image_format" attrs="{'required': [('delivery_type', '=', 'mydhl')]}"/>
                        <field name="dhl_label_template" attrs="{'required': [('delivery_type', '=', 'mydhl')]}"/>
                    </group>
                </group>
            </page>
        </xpath>
    </field>
</record>

</odoo>
