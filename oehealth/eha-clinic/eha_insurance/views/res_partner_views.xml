<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_eha_insurance_extension" model="ir.ui.view">
        <field name="name">res.partner.view.eha.insurance.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group[1]" position="inside">
                <field name="current_insurance_id" />
                <field name="is_insurance_organisation" />

            </xpath>
        </field>
    </record>

</odoo>
