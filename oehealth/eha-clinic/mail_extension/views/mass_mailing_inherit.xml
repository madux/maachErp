        <record id="mass_mailing_healthmate_push_notification_tree_view" model="ir.ui.view">
            <field name="name">push.notification.tree</field>
            <field name="model">push.notification</field>
            <field name="arch" type="xml">
                <tree string="Healhmate Push Notifications">
                    <field name="subject"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="mass_mailing_healthmate_push_notification_form_view" model="ir.ui.view">
            <field name="name">push.notification.form</field>
            <field name="model">push.notification</field>
            <field name="arch" type="xml">
                <form string="Healhmate Push Notifications">
                    <header>
                        <button confirm="Are you sure you want to push this notification?" name="push_notification_now" string="Push" type="object" class="oe_highlight" attrs="{'invisible': [('when', '!=', 'now')]}"/>
                        <button confirm="Are you sure you want to schedule this notification?" name="schedule_notification" string="Schedule" type="object" class="oe_highlight" attrs="{'invisible': [('when', '!=', 'schedule')]}"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,schedule,posting,posted" statusbar_colors='{"schedule":"blue","posted":"green"}'/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="subject"/>
                                <field name="message"/>
                                <field name="when"/>
                                <field name="schedule_date" attrs="{'invisible': [('when', '!=', 'schedule')], 'required': [('when', '=', 'schedule')]}"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_view_healthmate_push_notification">
            <field name="name">Healthmate Push Notifications</field>
            <field name="res_model">push.notification</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Push Notification
                </p><p>
                    Healthmate Push Notification
                </p>
            </field>
        </record>

        <!-- Marketing / Healthmate -->
        <menuitem id="mass_mailing_healthmate"
            name="Healthmate"
            parent="mass_mailing.mass_mailing_menu_root"
            sequence="70"
            groups="mass_mailing.group_mass_mailing_user"/>

        <!-- Configuration / Push Notification -->
        <menuitem id="mail_healthmate_notification" 
            name="Push Notification"
            action="action_view_healthmate_push_notification"
            parent="mass_mailing_healthmate"/>
    </data>
</odoo>
