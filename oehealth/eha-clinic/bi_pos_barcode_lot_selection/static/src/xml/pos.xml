<?xml version="1.0" encoding="UTF-8"?>
<templates id="pos_wallet_odoo_template" inherit_id="point_of_sale.template" xml:space="preserve">

	<t t-name="CustomPackLotLinePopupWidget">
		<div role="dialog" class="modal-dialog">
			<div class="popup popup-text">
				<header class="title"><t t-esc=" widget.options.title || '' " /></header>
				<main class='packlot-lines'>
					<t t-if="widget.options.barcodes">
						<select class="lots barcode_selector" id="lots" name="lots">
							<option> --- Select Lot/Serial --- </option>
							<t t-foreach="widget.options.barcodes" t-as="brcd" t-key="brcd.id">
								<option t-att-value="brcd.name">
									<t t-esc='brcd.name'/>
									<t t-if="widget.pos.config.show_stock_location =='specific' ">
										[Qty :<t t-esc="brcd.loc_qty"/>]
									</t>
									<t t-else="">
										[Qty :<t t-esc="brcd.product_qty"/>]
									</t>
								</option>
							</t>
						</select>
					</t>
					<t t-if="widget.options.pack_lot_lines">
						<t t-set="focus_lot_line" t-value="widget.focus_model || widget.options.pack_lot_lines.get_empty_model()"/>
						<t t-foreach='widget.options.pack_lot_lines.models' t-as='lot_line'>
							<input type="text" t-att-cid="lot_line.cid"
								t-att-value="lot_line.get('lot_name')"
								t-att-autofocus="lot_line === focus_lot_line ? 'autofocus': undefined"
								class="popup-input packlot-line-input"
								placeholder="Serial/Lot Number"/>
							<i class="oe_link_icon remove-lot fa fa-trash-o" role="img" aria-label="Remove" title="Remove"></i>
						</t>
					</t>
				</main>
				<footer class="footer">
					<div class="button confirm">
						Ok
					</div>
					<div class="button cancel">
						Cancel
					</div>
				</footer>
			</div>
		</div>
	</t>

	<t t-extend="OrderReceipt">
		<t t-jquery=".orderlines" t-operation="replace">
			<div class="orderlines">
				<table style="width:100%;">
					<colgroup>
						<col width='50%' />
						<col width='25%' />
						<col width='25%' />
					</colgroup>
					<thead>
						<tr style="border-bottom: 2px solid black;">
							<th>Product</th>
							<th class="pos-right-align">Qty</th>
							<th class="pos-right-align">Price</th>
						</tr>
					</thead>
					<tbody>
						<tr t-foreach="orderlines" t-as="line" t-key="line.id">
							<td>
								<t t-esc="line.get_product().display_name" />
								<t t-if="line.get_discount() > 0">
									<div>
										Discount: <t t-esc='line.discount' />%
									</div>
								</t>
								<t t-if="line.get_lot_barcodes()">
									<li class="info">
										<t t-foreach="line.get_lot_barcodes()" t-as="lots">
											[<t t-esc="lots.name"/> ]
											<t t-if="lots.expiry_date">
												[<t t-esc="lots.expiry_date"/> ]
											</t>
											,
										</t>
									</li>
								</t>
							</td>
							<td class="pos-right-align">
								<t t-esc="line.get_quantity_str_with_unit()" />
							</td>
							<td class="pos-right-align">
								<t t-esc="widget.format_currency(line.get_display_price())" />
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</t>
	</t>

</templates>
	
	
