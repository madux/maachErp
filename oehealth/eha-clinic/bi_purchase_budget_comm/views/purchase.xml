<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="purchase_order_budget_integraton_form_view" model="ir.ui.view">
            <field name="name">purchase.budget.integration.module.form.view</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">



              <field name="company_id" position="after">
                <field name="analytic_account_id" options="{'no_create':True,'no_create_edit':True}"/>
                    
                    
              </field>

     		</field>

    </record>



    <record id="budget_integraton_form_view_inherit" model="ir.ui.view">
            <field name="name">budget.integration.module.form.view</field>
            <field name="model">crossovered.budget</field>
            <field name="inherit_id" ref="bi_account_budget.crossovered_budget_view_form"/>
            <field name="arch" type="xml">



              <field name="company_id" position="after">
                <field name="restrict_allow" widget="radio"/>
                    
                    
              </field>

        </field>

    </record>
</odoo>