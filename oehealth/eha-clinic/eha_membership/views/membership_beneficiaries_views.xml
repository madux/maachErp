<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="membership_beneficiaries_view_tree" model="ir.ui.view">
            <field name="name">membership_beneficiaries.view.tree</field>
            <field name="model">eha.membership.beneficiaries</field>
            <field name="arch" type="xml">
                <tree string="Beneficiaries" create='false' edit="false" delete="false">
                    <field name="membership_id" />
                    <field name="number" />
                    <field name="display_name" string="Beneficiary Number" />
                    <field name="partner_id" string="Contact" />
                    <field name="dob" />
                    <field name="gender" />
                    <field name="age" />
                    <field name="membership_status" />
                    <field name="beneficiary_dependents_ids"
                        widget="many2many_tags" />
                </tree>
            </field>
        </record>

        <record id="membership_beneficiaries_view_form" model="ir.ui.view">
            <field name="name">membership_beneficiaries.view.form</field>
            <field name="model">eha.membership.beneficiaries</field>
            <field name="arch" type="xml">
                <form string="Beneficiaries" create='false' edit="false" delete="false">
                    <sheet>
                        <div class="oe_title">
                            <label for="membership_id" string="Membership Number" />
                            <field name="membership_id" />
                        </div>
                        <group>
                            <group>
                                <field name="number" readonly="1"
                                    style="width: 50px !important;" />
                                <field name="display_name" string="Beneficiary Number"
                                    readonly="1" force_save="1" />
                                <field name="partner_id" string="Contact" />
                                <field name="dob" />
                            </group>
                            <group>
                                <field name="gender" />
                                <field name="age" />
                                <field name="membership_status" />
                                <field name="beneficiary_dependents_ids"
                                    widget="many2many_tags" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="membership_beneficiaries_view_search" model="ir.ui.view">
            <field name="name">membership.beneficiaries.view.search</field>
            <field name="model">eha.membership.beneficiaries</field>
            <field name="arch" type="xml">
                <search string="Beneficiaries">
                    <field name="membership_id" />
                    <field name="number" />
                    <field name="display_name" string="Beneficiary Number" />
                    <field name="partner_id" string="Contact" />
                    <field name="dob" />
                    <field name="gender" />
                    <field name="age" />
                    <field name="membership_status" />
                </search>
            </field>
        </record>

        <record id="membership_beneficiaries_action" model="ir.actions.act_window">
            <field name="name">Beneficiaries</field>
            <field name="res_model">eha.membership.beneficiaries</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="membership_beneficiaries_menu"
            name="Beneficiaries"
            parent="eha_membership_menu_root"
            action="membership_beneficiaries_action"
            sequence="1" />

    </data>
</odoo>