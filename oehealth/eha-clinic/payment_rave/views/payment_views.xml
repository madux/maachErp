<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Paystack Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group attrs="{'invisible': [('provider', '!=', 'rave')]}">
                    <field name="rave_public_key"  attrs="{'required':[('code', '=', 'rave'), ('state', '!=', 'disabled')]}" password="False"/>
                    <field name="rave_secret_key"  attrs="{'required':[('code', '=', 'rave'), ('state', '!=', 'disabled')]}" password="True"/>
                    <field name="rave_secret_hash" password="False"/>
                    <field name="environment"/>
                </group>
            </group>
        </field>
    </record>
