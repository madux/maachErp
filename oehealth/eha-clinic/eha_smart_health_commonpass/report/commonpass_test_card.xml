<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="view_card_covid19_test">
            <xpath expr="." position="inside">
                <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,700" rel="stylesheet" />
                <link href="/eha_smart_health_commonpass/static/src/css/main.css" rel="stylesheet" />
            </xpath>
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.patient.partner_id.lang or o.company_id.partner_id.lang"/>
                    <t t-set="company_id" t-value="o.patient.partner_id.company_id or user.company_id"/>
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>
                    <t t-call="web.basic_layout">
                        <div class="page">
                            <div class="record">
                                <div class="header" style="font-size: 0.875rem;">
                                    <div class="row">
                                        <div class="col-7">
                                            <h1 style="font-size: 2rem ! important;">COVID-19 Test Record Card</h1>
                                            <h2 style="font-size: 1.5rem ! important;">SMART® Health Card</h2>
                                        </div>
                                        <div class="col-5">
                                            <img class="logo" style="max-width:90%;" src="/eha_smart_health_commonpass/static/src/img/ehaclinic.png"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="section" style="background:#edf1f5;padding: 20px 0 20px 20px;">
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="row">
                                                <table class="container" style="margin-left: 10px;">
                                                    <tr>
                                                        <td>
                                                            <h4>COVID-19 Test<br/>
Record Card</h4>
                                                        </td>
                                                        <td><span></span></td>
                                                        <td style="padding-left:20px;" class="oe_right">
                                                            <img class="logo" style="max-width:120px;" src="/eha_smart_health_commonpass/static/src/img/ehaclinic.png"/>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                            <br/>
                                            <br/>
                                            <br/>
                                            <div class="row">
                                                <div class="col-6">NAME</div>
                                                <div class="col-6">DATE OF BIRTH</div>
                                            </div>
                                            <div class="row">
                                                <div class="col-6">
                                                    <t t-esc="o.patient.name"/>
                                                </div>
                                                <div class="col-6">
                                                    <t t-esc="o.patient.dob"/>
                                                </div>
                                            </div>
                                            <br/>
                                            <br/>
                                            <br/>
                                            <div class="row">
                                                <div class="col-2">1.</div>
                                                <div class="col-10">
                                                    <span>
                                                        <t t-esc="o.test_type.name"/>
, LT Number #<t t-esc="o.name"/>
                                                    </span>
                                                    <span>
                                                        <t t-esc="date_requested" />
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div>
                                                <img class="logo" t-attf-src="data:image/*;base64,{{o.qr_code_commonpass}}" style="width:250px;height:250px" align="center"/>
                                                <div class="row">
                                                    <div class="col-6">
                                                        <span>SMART® Health Card</span>
                                                    </div>
                                                    <div class="col-6">
                                                        <img class="logo" style="max-width:45px" src="/eha_smart_health_commonpass/static/src/img/logo-smart.png"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6"></div>
                                        <div class="col-6">
                                            <div class="row">
                                                <div class="col-6">WORKS WITH</div>
                                                <div class="col-6">
                                                    <img src="/eha_smart_health_commonpass/static/src/img/commonpass.png" style="max-width:50px;"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <br/>
                                <div class="section">
                                    <h3>What is a SMART® Health Card?</h3>
                                    <p class="list-item">
                                        <img class="list-image" src="/eha_smart_health_commonpass/static/src/img/check.svg"/>
                                        <span>Holds important test or lab report data</span>
                                    </p>
                                    <p class="list-item">
                                        <img class="list-image" src="/eha_smart_health_commonpass/static/src/img/check.svg"/>
                                        <span>Can be scanned to verify that the information has not been tampered with</span>
                                    </p>
                                    <p class="list-item">
                                        <img class="list-image" src="/eha_smart_health_commonpass/static/src/img/exclamation.svg"/>
                                        <span>
                                            <b>Don’t forget</b> - scanning this QR Code will share all of the information on your Vaccine Card, so make sure to only share with those you trust. </span>
                                    </p>
                                </div>
                                <br/>
                                <div class="section">
                                    <h3>Download and open your SMART® Health Card file or scan the SMART® QR Code in a compatible digital wallet app:</h3>
                                    <div class="container">
                                        <div class="row">
                                            <table class="table table-bordered">
                                                <tr>
                                                    <td style="border-bottom-left-radius: 5px;">
                                                        <img style="max-width: 200px;" src="/eha_smart_health_commonpass/static/src/img/commonpass.png"/>
                                                        <span>Available on Android and iOS</span>
                                                    </td>
                                                    <td>
                                                        <img style="max-width: 200px;" src="/eha_smart_health_commonpass/static/src/img/commonhealth.png"/>
                                                        <span>Available on Android</span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <br/>
                            <div class="section text-muted">
                                <p class="text-small">This test record is powered by SMART and works with any app or service where SMART Health Cards are accepted. For more information, please visit https://smarthealth.cards/.</p>
                                <p class="text-small">The IAL number on this document describes the way that your identity information was collected at the clinic. You can find more information about IAL encoding here: http://build.fhir.org/ig/dvci/vaccine-credential-ig/branches/main/ValueSet-identity-assurance-level-value-set.html</p>
                                <p class="text-small">Your record can be verified or imported into the app of your choice by scanning the QR Code at the top of the page.</p>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="action_report_patient_commonpass" model="ir.actions.report">
            <field name="name">Covid-19 Test Card</field>
            <field name="model">oeh.medical.lab.test</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">eha_smart_health_commonpass.view_card_covid19_test</field>
            <field name="report_file">eha_smart_health_commonpass.view_card_covid19_test</field>
            <field name="binding_model_id" ref="oehealth.model_oeh_medical_lab_test"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>
