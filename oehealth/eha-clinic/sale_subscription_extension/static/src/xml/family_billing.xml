<?xml version="1.0" encoding="UTF-8"?>
<templates id="family_billing_body" xml:space="preserve">
    <t t-name="sale_subscription_extension.family_billing">
        <div class="container">
        <h5>Billing Information</h5>
        <form>
            <div class="radio-selector mt-3">
                <input class="checkbox" name="billing" type="radio" value="old" checked="checked"/>
                <div class="selector-content">
                    <label class="mb-2">Same as Family Principal</label>
                    <div class="hidden-content mt-3">
                        <div class="row">
                            <div class="col-6">
                                <div>
                                    Name :
                                    <strong t-esc="beneficiary.middlename"/> <strong t-esc="beneficiary.firstname"/>
                                </div>
                                <div>
                                    Email :
                                    <strong t-esc="beneficiary.email"/>
                                </div>
                                <div>
                                    Phone :
                                    <strong t-esc="beneficiary.phone"/>
                                </div>
                                <div>
                                    City :
                                    <strong t-esc="beneficiary.city"/>
                                </div>
                                <div>
                                    Street :
                                    <strong t-esc="beneficiary.street"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="radio-selector mt-3">
                <input class="checkbox" name="billing" type="radio" value="new"/>
                <div class="selector-content">
                    <label class="mb-2">Different Billing</label>
                    <div class="hidden-content mt-3">
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label class="col-form-label">
                                    Surname
                                </label>
                                <input type="text" maxlength="75" required="required"
                                       placeholder="Surname" name="other_surname" class="form-control"/>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="col-form-label">
                                    Other Names
                                </label>
                                <input type="text" maxlength="75" required="required"
                                       placeholder="First Name, Middle Name" name="other_name"
                                       class="form-control"/>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label class="col-form-label">
                                    Email
                                </label>
                                <input type="email" maxlength="75" required="required" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,63}$"
                                       placeholder="Email" name="other_email" class="form-control"/>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="col-form-label">
                                    Phone
                                </label>
                                <input type="text" maxlength="75" required="required"
                                       placeholder="+234" name="other_phone" class="form-control"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </form>
    </div>
    </t>

    <t t-name="sale_subscription_extension.billing_form_paystack">
        <form id="fam_paystack" class="s_website_form container-fluid" enctype="multipart/form-data">
            <input type="text" class="d-none" name="url_token" id="url_token"
                   t-attf-value="{{ url_token }}"/>
            <input type="hidden" name="data_set" t-att-data-action-url="tx_url" data-remove-me=""/>
            <input id="acquirer_paystackAcquirer" type="hidden" name="acquirer"
                   t-att-value="acquirer.acquirer_id"/>

            <input type="hidden" name='merchant' t-att-value='acquirer.merchant'/>
            <input type="hidden" name='amount' t-att-value='amount'/>
            <input type="hidden" name='return_url' t-att-value='acquirer.return_url'/>
            <!--Order Information -->
            <input type="hidden" name='invoice_num' t-att-value='acquirer.invoice_num'/>
            <input type="hidden" name='currency' t-att-value='acquirer.currency'/>
            <input type="hidden" name='currency_id' t-att-value='acquirer.currency_id'/>
            <!-- Billing Information-->
            <input type="hidden" name='name' t-att-value='beneficiary.other_name'/>
            <input type="hidden" name='address_line1' t-att-value='beneficiary.street +","+ beneficiary.city '/>
            <input type="hidden" name='address_city' t-att-value='beneficiary.city'/>
            <input type="hidden" name='address_zip' t-att-value='"123456"'/>
            <input type="hidden" name='address_country' t-att-value='"Nigeria"'/>
            <input type="hidden" name='phone' t-att-value='beneficiary.phone'/>
            <input type="hidden" name='email' t-att-value='beneficiary.email'/>

            <input type="hidden" name="paystack_pub_key" t-att-value="acquirer.paystack_public_key"/>
            <input type="hidden" name="environment" t-att-value="acquirer.environment"/>
        </form>
    </t>

    <!--Rave Payment Form-->
    <t t-name="sale_subscription_extension.billing_form_payrave">
        <form id="fam_rave" class="s_website_form container-fluid" enctype="multipart/form-data">
            <input type="hidden" name="data_set" t-att-data-action-url="tx_url" data-remove-me=""/>
            <input id="acquirer_rave" type="hidden" name="acquirer" t-att-value="acquirer.acquirer_id"/>
            <input type="hidden" name='merchant' t-att-value='acquirer.merchant'/>
            <input type="hidden" name='amount' t-att-value="amount"/>
            <input type="hidden" name='return_url' t-att-value='acquirer.return_url'/>

            <!--Order Information -->
            <input type="hidden" name='invoice_num' t-att-value='acquirer.invoice_num'/>
            <input type="hidden" name='currency' t-att-value='acquirer.currency'/>
            <input type="hidden" name='currency_id' t-att-value='acquirer.currency_id'/>

            <!-- Billing Information-->
            <t t-if="other">
                <input type="hidden" name='name' t-att-value='other.other_lastname'/>
                <input type="hidden" name='phone' t-att-value='other.other_phone'/>
                <input type="hidden" name='email' t-att-value='other.other_email'/>
            </t>
            <t t-else="1">
                <input type="hidden" name='name' t-att-value='beneficiary.other_name'/>
                <input type="hidden" name='phone' t-att-value='beneficiary.phone'/>
                <input type="hidden" name='email' t-att-value='beneficiary.email'/>
            </t>
            <input type="hidden" name='address_line1' t-att-value='beneficiary.street +","+ beneficiary.city'/>
            <input type="hidden" name='address_city' t-att-value='beneficiary.city'/>
            <input type="hidden" name='address_zip' t-att-value='"123456"'/>
            <input type="hidden" name='address_country' t-att-value='"Nigeria"'/>

            <input type="hidden" name="rave_pub_key" t-att-value="acquirer.rave_pub_key"/>
            <input type="hidden" name="environment" t-att-value="acquirer.environment"/>
            <script type="text/javascript" src="/payment_rave/static/src/js/rave.js"></script>
        </form>
    </t>
</templates>