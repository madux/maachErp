<?xml version="1.0"?>
    <odoo>
        <record model="ir.ui.view" id="view_beneficiary_import_form">
            <field name="name">beneficiary_import.wizard.form</field>
            <field name="model">beneficiary_import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import Beneficiaries / Dependents">
                    <header>
                        <button name="action_import_record" 
                            string="Import Records" 
                            type="object" 
                            class="oe_highlight" 
                            />
                    </header>
                    <sheet>
                        <group name="outer">
                            <group name="left">
                                <field name="import_type" required="1"/>
                                <field name="data_file" filename="filename"/>
                                <field name="filename" invisible="1" readonly="1" force_save="1"/> 
                            </group>
                            <group name="right">
                                <field name="subscription_id" invisible="1" force_save="1"/>
                            </group>
                        </group>
                        <p class="clearfix"/>
                        <div class="oe_left">
                            <center>
                                <a href="https://docs.google.com/spreadsheets/d/1Y2k177lwAInCcUN2-J-ar95-4tJe-o94hWKjYbxa_mo/edit#gid=1904454307" 
                                target="_blank" attrs="{'invisible':[('import_type', 'in', ['Dependents'])]}">Click Here to See File Format to Use</a>
                            </center>
                        </div>
                        <div class="oe_left">
                            <center>
                                <a href="https://docs.google.com/spreadsheets/d/1ioUqdM4OLkrWXrlYU96E5a0wL5REibQqyWTqvsapc-4/edit#gid=1745613787" 
                                target="_blank" attrs="{'invisible':[('import_type', 'in', ['Both', 'Beneficiaries'])]}">Click Here to See File Format to Use</a>
                            </center>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_beneficiary_import_wizard_import_action" model="ir.actions.act_window">
            <field name="name">Beneficiary Import wizard</field>
            <field name="res_model">beneficiary_import.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sale_subscription_extension.view_beneficiary_import_form"/>
            <field name="target">new</field>
        </record>

    </odoo>