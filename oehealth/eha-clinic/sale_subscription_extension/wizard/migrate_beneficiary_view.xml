<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="sale_subscription_extension_beneficiary_migrate_view_form" model="ir.ui.view">
            <field name="name">sale_subscription_extension.beneficiary.migrate.view.form</field>
            <field name="model">sale_subscription_extension.beneficiary.migrate</field>
            <field name="arch" type="xml">
                <form string="Migrate">
                    <sheet>
                        <group>
                            <field name="subscription_ids" />
                        </group>
                    </sheet>
                    <footer>
                        <button name="do_migrate" string="Migrate" type="object" class="oe_highlight" />
                        <button special="cancel" string="Terminate" class="btn-danger" />
                    </footer>
                </form>
            </field>
        </record>
    </data>

    <record id="migrate_beneficiary_action" model="ir.actions.act_window">
        <field name="name">Migrate</field>
        <field name="res_model">sale_subscription_extension.beneficiary.migrate</field>
        <field name="binding_model_id" ref="sale_subscription.model_sale_order" />
        <field name="view_mode">form</field>
        <field name="context">{'default_subscription_ids': active_ids}</field>
        <field name="target">new</field>
        <field name="views">[[False, 'form']]</field>
    </record>

</odoo>
