<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="assets_frontend" name="eha_website_assets" inherit_id="website.assets_frontend">
            <xpath expr="//script[last()]" position="after">
                <script type="text/javascript" src="/sale_subscription_extension/static/src/lib/jquery.serialize.js"/>
                <script type="text/javascript" src="/sale_subscription_extension/static/src/js/membership.js"/>
                <script type="text/javascript" src="/sale_subscription_extension/static/src/js/family_members.js"/>
