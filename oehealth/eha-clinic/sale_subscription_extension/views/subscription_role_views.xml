<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="view_subscription_form_inherit">
        <field name="name">sale.order.form.view.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[1]" position="after">
                <page name="roles" string="Plans &amp; Packages" attrs="{'invisible': [('subscription_type', '=', 'family')]}">
                    <group string="Membership Roles" name="membership_roles">
                        <field name="role_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="plan_id"/>
                                <field name="package_ids" widget="many2many_tags"/>
                                <field name="budget"/>
                                <field name="billing_id"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>