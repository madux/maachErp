<?xml version="1.0"?>
    <odoo>
        <record model="ir.ui.view" id="sub_beneficiary_form_view">
            <field name="name">Sale Subscription Beneficiary</field>
            <field name="model">sale.subscription.beneficiaries</field>
            <field name="arch" type="xml">
                <form string="Beneficiary">
                    <header>
                        <button type="object" class="btn-sm oe_highlight" name="action_open_patient" string="Open Patient"/>    
                        <button type="object" class="btn-sm oe_highlight" name="action_add_packages" string="Add Packages"/>
                        <button type="object" class="btn-sm oe_highlight" name="action_upgrade_plan" string="Upgrade Plans"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="partner_id" required="1"/>
                                <field name="gender"/>
                                <field name="dob"/>
                                <field name="is_staff"/>
                                <field name="address"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="subscription_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="role_id" required="1" />
                                <field name="plan_id" required="1"/>
                                <!-- <field name="product_id" widget="many2many_tags" domain="[('plan_id', '=', plan_id)]" required="0"/> -->
                                <field name="product_id" widget="many2many_tags" required="0"/>
                                <field name="used_budget"/>
                                <field name="start_date" required="1"/>
                                <field name="end_date" required="1"/>
                                <field name="dependent_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="sub_beneficiary_list_view">
            <field name="name">sale.subscription.beneficiaries.list</field>
            <field name="model">sale.subscription.beneficiaries</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string='Beneficiaries'>
                    <field name="partner_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="is_staff"/>
                    <field name="plan_id"/>
                    <field name="product_id"/>
                    <field name="used_budget"/>
                </tree>
            </field>
        </record>

        <record id="view_subscription_beneficiary_action" model="ir.actions.act_window">
            <field name="name">sale.subscription.beneficiaries</field>
            <field name="res_model">sale.subscription.beneficiaries</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sale_subscription_extension.sub_beneficiary_form_view"/>
            <field name="target">new</field>
        </record>

    </odoo>