<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--Pages-->
    <template id="t_fourthpage" name="Fourth Page of membership">
        <t t-call="website.layout">
            <div class="family_blling_page">
                <div id="wrap" class="oe_structure oe_empty"/>
                <div class="section bgLight">
                    <div class="container pt-4 pb-3">
                        <h4>Subscribe to Membership Family <span class="membership_type" t-esc="membership_type" style="text-transform: capitalize;"/></h4>
                    </div>
                </div>
                <div class="section header bgLight">
                    <div class="container">
                        <div class="tabs">
                            <div class="step-tab pt-4 pb-4">
                                <div>
                                    <span class="badge badge-primary badge-m mr-2">1</span>
                                    Family Principal
                                </div>
                            </div>
                            <div class="step-tab pt-4 pb-4">
                                <div>
                                    <span class="badge badge-primary badge-m mr-2">2</span>
                                    Family Members
                                </div>
                            </div>
                            <div class="step-tab pt-4 pb-4 active">
                                <div>
                                    <span class="badge badge-primary badge-m mr-2">3</span>
                                    Billing
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="section family-body">
                    <div class="container mt-6 mb-5">
                        <div class="purchase-summary">
                            <div class="summary-header">
                                Family <span class="membership_type" t-esc="membership_type" style="text-transform: capitalize;"/>
                            </div>
                            <table>
                                <t t-set="total" t-value="0"/>
                                <tr>
                                    <td class="position">1</td>
                                    <td class="item">
                                        <span data-toggle="modal">
                                            <span/>
                                            (Family Principal)
                                            <span class="badge badge-white">
                                                <!--<span t-field="primary.family_class"/>-->
                                            </span>
                                        </span>
                                    </td>
                                    <td class="item-price">
                                        NGN 0
                                    </td>
                                </tr>
                                <t t-foreach="child_ids" t-as="child">
                                    <tr>
                                        <td class="position">
                                            <t t-esc="child_index+2"/>
                                        </td>
                                        <td class="item">
                                            <span data-toggle="modal">
                                                <span t-esc="child.name"/>
                                                <span class="badge badge-white">
                                                    <!--<span t-field="child.family_class"/>-->
                                                </span>
                                            </span>
                                        </td>
                                        <td class="item-price">
                                            NGN
                                            <t t-esc="rules.get(child.family_class)"/>
                                            <t t-set="total" t-value="total+rules.get(child.family_class)"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="summary-footer">
                                    <td colspan="2">Total</td>
                                    <td class="total-price" t-att-total_amount="total">NGN
                                        <t t-esc="total"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="section family-billing">
                    <div class="container">
                        <h5>Billing Information</h5>
                        <form>
                            <div class="radio-selector mt-3">
                                <input class="checkbox" name="billing" type="radio" value="old" checked="checked"/>
                                <div class="selector-content">
                                    <label class="mb-2">Same as Family Principal</label>
                                    <div class="hidden-content mt-3">
                                        <div class="row">
                                            <div class="col-6">
                                                <span>
                                                </span>
                                                <span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="radio-selector mt-3">
                                <input class="checkbox" name="billing" type="radio" value="new"/>
                                <div class="selector-content">
                                    <label class="mb-2">Different Billing</label>
                                    <div class="hidden-content mt-3">
                                        <div class="form-row">
                                            <div class="form-group col-md-6">
                                                <label class="col-form-label">
                                                    Surname
                                                </label>
                                                <input type="text" maxlength="75" required="required"
                                                       placeholder="Surname" name="email" class="form-control"/>
                                            </div>
                                            <div class="form-group col-md-6">
                                                <label class="col-form-label">
                                                    Other Names
                                                </label>
                                                <input type="text" maxlength="75" required="required"
                                                       placeholder="First Name, Middle Name" name="email"
                                                       class="form-control"/>
                                            </div>
                                        </div>
                                        <div class="form-row">
                                            <div class="form-group col-md-6">
                                                <label class="col-form-label">
                                                    Email
                                                </label>
                                                <input type="email" maxlength="75" required="required" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,63}$"
                                                       placeholder="Email" name="email" class="form-control"/>
                                            </div>
                                            <div class="form-group col-md-6">
                                                <label class="col-form-label">
                                                    Phone
                                                </label>
                                                <input type="text" maxlength="75" required="required"
                                                       placeholder="+234" name="email" class="form-control"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </form>
                    </div>
                </div>
                <div class="section footer">
                    <div class="row actions mt-6 mb-6 pt-4 border-top-blue">
                        <div class="col-8">
                            <div class="btn btn-outline-primary mr-3 mb-2 cancel_membership_purchase">Cancel Purchase</div>
                            <a href="/membership-step2/" class="back-button btn btn-outline-primary mb-2">Back</a>
                        </div>
                        <div class="col-4 text-right" id="pay_membership">
                            <button class="btn btn-primary">Pay Now</button>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="t_finalpage" name="Final Page of membership">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty"/>
            <div class="section bgLight pt-4">
                <div class="container pt-5 pb-4">
                    <h3>Thank you for choosing EHA Clinics.</h3>
                    <p class="text-lg pt-4">Your payment has been confirmed.</p>
                </div>
            </div>
            <div class="section pt-4 mb-5">
                <div class="container pt-4">
                    <h3>Your next steps</h3>
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mt-5 pl-5 pt-1 mr-3 list-icon">
                                <i class="fa fa-check rounded-icon"></i>
                                <p>
                                    <b>Find your invoice and membership details in the email that has been sent
                                        to you.
                                    </b>
                                </p>
                            </div>
                            <div class="mt-5 pl-5 pt-1 mr-3 list-icon">
                                <i class="fa fa-check rounded-icon"></i>
                                <p>
                                    <b>Do you want to check out your benefits? View our
                                        <a href="https://www.eha.ng/shop/plans/compare">memberships checklist
                                        </a>
                                        and our
                                        <a href="https://www.eha.ng/shop/terms">service level agreement</a>.
                                    </b>
                                </p>
                            </div>
                            <div class="mt-5 pl-5 pt-1 mr-3 list-icon">
                                <i class="fa fa-check rounded-icon"></i>
                                <p>
                                    <b>Upon your next clinic visit our helpdesk assistant will add you to our
                                        patient files and you can start benefitting from your membership.
                                    </b>
                                </p>
                                <a class="btn btn-primary"
                                   href="https://www.eha.ng/appointment/abuja-asbadantata">Book Clinic
                                    Appointment
                                </a>
                            </div>
                        </div>
                        <div class="col-md-4 text-center">
                            <img src="/eha_website_hr_recruitment/static/src/img/reach/partner.jpg" width="220"></img>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>