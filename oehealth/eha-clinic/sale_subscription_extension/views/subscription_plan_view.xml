<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="view_tree_subscription_plan" model="ir.ui.view">
            <field name="name">sale.subscription.plan.tree.view</field>
            <field name="model">sale.subscription.plan</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                    <field name="description" />
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_subscription_plan_form">
            <field name="name">sale.subscription.plan.form.view</field>
            <field name="model">sale.subscription.plan</field>
            <field name="arch" type="xml">
                <form string="Subscription Plan">
                    <sheet>
                        <group name="group_left">
                            <field name="name" />
                            <field name="description" />
                        </group>
                        <notebook>
                            <page string="Benefits">
                                <field name="line_ids">
                                    <tree editable="bottom" context="{'default_plan_id': active_id}">
                                        <field name="plan_id" invisible="1"/>
                                        <field name="name"/>
                                        <field name="product_id" domain="[('type', '=', 'service')]"/>
                                        <field name="qty"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="subscription_plan_action" model="ir.actions.act_window">
            <field name="name">Subscription Plans</field>
            <field name="res_model">sale.subscription.plan</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="subscription_plan_menu"
            name="Subscription Plans"
            action="subscription_plan_action"
            parent="sale_subscription.menu_sale_subscription_config"
            groups="base.group_system"
            sequence="11"
        />
            <!-- groups="base.group_system,oehealth_extension.group_oeh_medical_op_ass" -->

    </data>
</odoo>