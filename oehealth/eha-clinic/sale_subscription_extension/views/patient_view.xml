<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="oeh_medical_patient_view_ext">
        <field name="name">Patient.inherit</field>
        <field name="model">oeh.medical.patient</field>
        <field name="inherit_id" ref="oehealth.oeh_medical_patient_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position="after">
                <page string="Subscriptions">
                    <seperator string="Utilization"/>
                    <field name="active_subscription" class="table-dolphin" nolabel="1" context="{'tree_view_ref':'sale_subscription_extension.sale_subscription_view_form_custom_view'}"/>
                </page>
            </xpath>
            <field name="prescription_line" position="after">
                <div>
                    <label for="beneficiary_migrated" />
                    <field name="beneficiary_migrated" />
                </div>
                <field name="active_subscription" class="table-dolphin" nolabel="1" context="{'tree_view_ref':'sale_subscription_extension.sale_subscription_view_form_custom_view'}"/>

            </field>
            <field name="doctor" position="before">
                <field name="plan_id" invisible="0" force_save="1" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="sale_subscription_view_form_custom_view" model="ir.ui.view">
        <field name="name">sale.subscription.custom_view</field>
        <field name="model">sale.order</field>
        <field name="priority">17</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sale_order_template_id" string="Subscription" />
                <field name="code" />
                <field name="stage_id" />
            </tree>
        </field>
    </record>

</odoo>
