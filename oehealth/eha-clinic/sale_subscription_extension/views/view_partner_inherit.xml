<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="res_partner_view_form_short_inherit">
        <field name="name">res.partner.view.form.short.inherit.family</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']" position="after">
                <field name="family_class" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='child_ids']//form//field[@name='email']" position="after">
                <field name="gender"/>
                <field name="dob"/>
                <field name="family_class" invisible="1"/>
            </xpath>
        </field>
    </record>
    
    <record model="ir.ui.view" id="res_partner_view_beneficiaries_tree">
        <field name="name">Beneficiaries Lists</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Beneficiaries">
                <field name="name"/>
                <field name="phone" />
                <field name="email" string="Surname"/>
                <field name="parent_id" string="Parent Contact"/>
                <field name="gender"/>
                <field name="dob"/>
            </tree>
        </field>
    </record>
</odoo>