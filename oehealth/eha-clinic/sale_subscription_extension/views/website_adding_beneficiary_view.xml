<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Pages-->
    <template id="t_secondpage" name="Second Page of membership">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty"/>
            <div class="section bgLight">
                <div class="container pt-4 pb-3">
                    <h4>Subscribe to Membership Family <span class="membership_type" t-esc="membership_type" style="text-transform: capitalize;"/></h4>
                </div>
            </div>
            <div class="section bgLight">
                <div class="container">
                    <div class="tabs">
                        <div class="step-tab pt-4 pb-4 active">
                            <div>
                                <span class="badge badge-primary badge-m mr-2">1</span>
                                Family Principal
                            </div>
                        </div>
                        <div class="step-tab pt-4 pb-4">
                            <div>
                                <span class="badge badge-primary badge-m mr-2">2</span>
                                Family Members
                            </div>
                        </div>
                        <div class="step-tab pt-4 pb-4">
                            <div>
                                <span class="badge badge-primary badge-m mr-2">3</span>
                                Billing
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="section family-beneficiary">
                <div class="container mt-6 mb-5">
                    <form action="" method="post" id="first_step_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="row">
                            <div class="col-md-4 mt-2 mb-4 pr-5">
                                <h5>Family Principal</h5>
                                <p>The Family Principal will be managing the membership account for the whole
                                    family.
                                </p>
                                <small>
                                    <i>Note, all fields are mandatory.</i>
                                </small>
                            </div>
                            <div class="col-md-8">
                                <div class="radio-selector mt-3">
                                    <input class="checkbox" name="is_already_patient" type="checkbox"/>
                                    <div class="selector-content">
                                        <label class="mb-2">Is already a patient of EHA Clinics?</label>

                                        <div class="d-none existing_patient mt-3">
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <p>To match with the existing patient record, please provide
                                                        the Patient ID.
                                                    </p>
                                                </div>

                                                <div class="form-group col-md-6">
                                                    <label class="col-form-label" for="patientId">
                                                        Patient ID
                                                    </label>
                                                    <input type="text" maxlength="75"
                                                           placeholder="e.g. HP12345"
                                                           name="patientId" class="form-control patientId"/>
                                                </div>
                                                <div class="form-group col-md-6">
                                                    <label class="col-form-label" for="verify_dob">
                                                        Verify DOB
                                                    </label>
                                                    <div class="o_website_form_date input-group input-group-lg date">
                                                        <input name="verify_dob" type="text" autocomplete="off"
                                                               class="form-control o_website_form_input"
                                                               data-target="#verify_dob"/>
                                                        <div class="input-group-append" >
                                                            <div class="input-group-text">
                                                                <i class="fa fa-calendar"
                                                                   data-original-title="Date of Birth"
                                                                   title="Verify Date of Birth"
                                                                   aria-describedby="tooltip118921"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-6">
                                        <label class="col-form-label">Surname</label>
                                        <input type="text" maxlength="75" required="required"
                                               placeholder="Surname" name="lastname" class="form-control"/>
                                    </div>
                                    <div class="form-group col-md-3">
                                        <label class="col-form-label">First Name</label>
                                        <input type="text" maxlength="75" required="required"
                                               placeholder="First Name" name="firstname"
                                               class="form-control"/>
                                    </div>
                                    <div class="form-group col-md-3">
                                        <label class="col-form-label">Middle Name</label>
                                        <input type="text" maxlength="75"
                                               placeholder="Middle Name" name="middlename"
                                               class="form-control"/>
                                    </div>
                                    <input type="hidden" name="family_class" class="family_class form-control"/>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-6">
                                        <label class="col-form-label" for="gender">
                                            Gender
                                        </label>
                                        <select name="gender" required="required" data-init="1"
                                                class="form-control">
                                            <option value="">Gender</option>
                                            <option value="Male">
                                                Male
                                            </option>
                                            <option value="Female">
                                                Female
                                            </option>
                                            <option value="Other">
                                                Other
                                            </option>
                                        </select>
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label class="col-form-label" for="dob">
                                            Date of Birth
                                        </label>
                                        <div class="o_website_form_date input-group input-group-lg date">
                                            <input name="dob" required="required" type="text"
                                                   class="form-control o_website_form_input" autocomplete="off"
                                                   data-toggle="datetimepicker" data-target="#customer_dob"/>
                                            <div class="input-group-append" >
                                                <div class="input-group-text">
                                                    <i class="fa fa-calendar"
                                                       data-original-title="Date of Birth"
                                                       title="Date of Birth"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-row mt-4 pt-4 border-top-blue">
                                    <div class="form-group col-md-6">
                                        <label class="col-form-label">
                                            Email
                                        </label>
                                        <input type="email" maxlength="75" required="required" name="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,63}$"
                                               class="form-control"/>
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label class="col-form-label">
                                            Phone Number
                                        </label>
                                        <input type="text" maxlength="75" required="required" placeholder="+234"
                                               name="phone" class="form-control"/>
                                    </div>
                                </div>
                                <div class="form-row mt-4">
                                    <div class="form-group col-md-6">
                                        <label class="col-form-label">
                                            Street
                                        </label>
                                        <input type="text" maxlength="75" required="required"
                                               name="street"
                                               class="form-control"/>
                                    </div>
                                    <div class="form-group col-md-6">
                                        <label class="col-form-label">
                                            City
                                        </label>
                                        <input type="text"
                                               name="city"
                                               maxlength="75" required="required"
                                               class="form-control"/>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-6">
                                        <label class="col-form-label">
                                            State
                                        </label>
                                        <select name="state" required="required" class="form-control">
                                            <option value="">Choose State</option>
                                            <t t-foreach="state_ids" t-as="s">
                                                <option t-att-value="s.id">
                                                    <t t-esc="s.name"/>
                                                </option>
                                            </t>
                                        </select>

                                    </div>
                                    <div class="form-group col-md-6">
                                        <label class="col-form-label">
                                            LGA
                                        </label>
                                        <input type="text" name="lga" class="form-control"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row actions mt-5 pt-4 border-top-blue">
                            <div class="col-6">
                                <div class="btn btn-outline-primary cancel_membership_purchase">Cancel Purchase</div>
                            </div>
                            <div class="col-6 text-right">
                                <input type="submit" class="btn btn-primary" value="Continue"/>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>
</odoo>