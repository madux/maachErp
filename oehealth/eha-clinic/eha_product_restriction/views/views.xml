<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        
        <record model="ir.ui.view" id="eha_product_creation_tree">
            <field name="name">eha.product.creation.view.tree</field>
            <field name="model">eha.product.creation</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="requester_department_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

    <record model="ir.ui.view" id="eha_product_creation_form_view">
        <field name="name">eha.product.creation.form.view</field>
        <field name="model">eha.product.creation</field>
        <field name="priority" eval="2"/>
        <field name="arch" type="xml">
            <form string="product creation">
                <header>
                    <button name="submit" states="draft" string="Submit" type="object"/>
                    <button name="approve" states="submit" string="Approve" type="object" class="btn btn-primary" groups="eha_product_restriction.group_product_creation,eha_product_restriction.group_pharmacy_product_approval,eha_product_restriction.group_other_product_approval"/>
                    <button name="%(view_product_approval_rejection_reason_form_action)d" type="action" states="submit" string="Reject" class="btn btn-danger" groups="eha_product_restriction.group_product_creation,eha_product_restriction.group_pharmacy_product_approval,eha_product_restriction.group_other_product_approval"/>
                    <button name="reset" states="reject" string="Set to Draft" type="object" /> 
                    <button name="create_product" string="Create Product" type="object" attrs="{'invisible': ['|', ('product_id', '!=', False), ('state', 'not in', ('approved'))]}" groups="eha_product_restriction.group_product_creation"/> 
                    <field name="state" widget="statusbar" statusbar_visible="draft,submit,approved" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                        <div name="options" groups="base.group_user">
                            <div>
                                <field name="sale_ok"/>
                                <label for="sale_ok"/>
                            </div>
                            <div>
                                <field name="purchase_ok"/>
                                <label for="purchase_ok"/>
                            </div>
                            <div>
                                <field name="expense_ok"/>
                                <label for="expense_ok"/>
                            </div>
                            <div>
                                <field name="prescription_ok"/>
                                <label for="prescription_ok"/>
                            </div>
                        </div>
                    </div>
                    <group col="4">
                        <field name="requester_id"/>
                        <field name="requester_department_id"/>
                    </group>

                    <notebook>
                        <page string="General Information" id="general_info">
                            <group>
                                <group>
                                    <field name="type" attrs="{'required': [('state', '=', 'submit')]}"/>
                                    <field name="sales_price" attrs="{'required': [('state', '=', 'submit')]}"/>
                                    <field name="categ_id" attrs="{'required': [('state', '=', 'submit')]}"/>
                                    <field name="cost_price" attrs="{'required': [('state', '=', 'submit')]}"/>
                                    <field name="nafdac_number" />
                                    <field name="default_code" />
                                    <field name="product_classification" />
                                    <field name="uom_id" attrs="{'required': [('state', '=', 'submit')]}"/>
                                    <field name="create_for" widget="radio" options="{'horizontal': true}"/>
                                </group>
                                <group>
                                    <field name="tracking" attrs="{'required': [('state', '=', 'submit')]}"/>
                                    <field name="uom_po_id" attrs="{'required': [('state', '=', 'submit')]}"/>
                                    <field name="available_in_pos" attrs="{'required': [('state', '=', 'submit')]}"/>
                                    <field name="is_oeh_product" attrs="{'required': [('state', '=', 'submit')]}"/>
                                    <field name="product_id" invisible="0" readonly="1"/>
                                    <field name="medicament_type" attrs="{'invisible': [('is_oeh_product', '=', False)], 'required': [('is_oeh_product', '=', True)]}"/>
                                    <field name="is_returnable"/>
                                    <field name="requires_appointment"/>
                                </group>
                            </group>
                        </page>
                        <page string="Warehouse Information" id="warehouse_info" attrs="{'invisible': [('create_for', '!=', 'both')]}">
                            <group>
                                <group>
                                    <field name="warehouse_sales_price" attrs="{'invisible': [('create_for', '!=', 'both')], 'required': [('create_for', '=', 'both'), ('state', '=', 'submit')]}"/>
                                    <field name="warehouse_categ_id" attrs="{'invisible': [('create_for', '!=', 'both')], 'required': [('create_for', '=', 'both'), ('state', '=', 'submit')]}"/>
                                </group>
                                <group>
                                    <field name="warehouse_cost_price" attrs="{'invisible': [('create_for', '!=', 'both')], 'required': [('create_for', '=', 'both'), ('state', '=', 'submit')]}"/>
                                    <field name="associated_warehouse_product_id" readonly="1" attrs="{'invisible': [('create_for', '!=', 'both')]}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>

                    <group string='Notes'>
                        <field name="note"/>
                    </group>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="eha_product_creation_action_window">
      <field name="name">Product Creation</field>
      <field name="res_model">eha.product.creation</field>
      <field name="view_mode">tree,form</field>
      <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            let's create a new Product.
            </p><p>
            Once you have created your Product, submit it to Procurment who will approve it.
            </p>
        </field>
    </record>

    <!-- Top menu item -->

    <menuitem
        name="Product Creation"
        parent="material_request.menu_material_request"
        id="eha_product_creation_menu" action="eha_product_creation_action_window" sequence="20"/>

  </data>
</odoo>