<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="eha_product_view_product_form" model="ir.ui.view">
            <field name="name">eha.product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <div name="options" position="inside">
                    <div>
                        <field name="is_returnable"/>
                        <label for="is_returnable"/>
                    </div>
                    <div>
                        <field name="requires_appointment"/>
                        <label for="requires_appointment"/>
                    </div>
                </div>
            </field>
        </record>

    </data>
</odoo>