<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="ncdc_log_form_view" model="ir.ui.view">
            <field name="name">ncdc.log.form</field>
            <field name="model">ncdc.log</field>
            <field name="arch" type="xml">
                <form string="NCDC Log" create="false" edit="false">
                    <group>
                        <field name="labtest_no"/>
                        <field name="response_code"/>
                        <field name="is_success"/>
                        <field name="response_message"/>
                        <field name="date_attempted"/>
                    </group>
                    <separator/>
                    <h2>Body</h2>
                    <field name="response_message"/>
                </form>
            </field>
        </record>
        <record id="ncdc_log_tree_view" model="ir.ui.view">
            <field name="name">ncdc.log.tree</field>
            <field name="model">ncdc.log</field>
            <field name="arch" type="xml">
                <tree string="NCDC Log" default_order="create_date desc" create="false" edit="false">
                    <field name="labtest_no"/>
                    <field name="response_code"/>
                    <field name="is_success"/>
                    <field name="response_message"/>
                    <field name="create_date"/>
                </tree>
            </field>
        </record>
        <record id="action_ncdc_log" model="ir.actions.act_window">
            <field name="name">NCDC Log</field>
            <field name="res_model">ncdc.log</field>

            <field name="view_mode">tree,form</field>
            <field name="search_view_id" eval="False"/>
            <field name="context">{}</field>
            <field name="help">NCDC Log</field>
        </record>
        <menuitem name="Custom NCDC" id="ncdc_root_menu" parent="base.menu_custom" sequence="7"/>
        <menuitem action="action_ncdc_log" id="menu_action_ncdc_log" parent="ncdc_root_menu" sequence="1"/>
    </data>
</odoo>
