<odoo>
    <data>
        <record id="aether_sync_log_form" model="ir.ui.view">
            <field name="name">Aether Sync Log form</field>
            <field name="model">aether.sync.log</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="status_code" readonly="1"/>
                            <field name="message" readonly="1"/>
                            <field name="operation" readonly="1"/>
                            <field name="payload"/>

                        </group>
                        <group></group>
                    </group>
                </form>
            </field>
        </record>

        <record id="aether_sync_log_tree" model="ir.ui.view">
            <field name="name">Aether Sync Log Tree</field>
            <field name="model">aether.sync.log</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="operation" readonly="1"/>
                    <field name="status_code"/>
                    <field name="message"/>
                </tree>
            </field>
        </record>

        <record id="aether_sync_log_filter" model="ir.ui.view">
            <field name="name">Aether Sync Log filter</field>
            <field name="model">aether.sync.log</field>
            <field name="arch" type="xml">
                <search>
                    <field name="status_code"/>
                    <field name="message"/>
                    <filter string="Message" name="message" domain="[]" context="{'group_by':'message'}"/>
                    <filter string="Status Code" name="status_code" domain="[]" context="{'group_by':'status_code'}"/>
                    <filter string="Operation" name="operation" domain="[]" context="{'group_by':'operation'}"/>
                </search>
            </field>
        </record>

        <record id="aether_checkpoint_form" model="ir.ui.view">
            <field name="name">aether.sync.checkpoint.form</field>
            <field name="model">aether.sync.checkpoint</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="checkpoint_type" readonly="1"/>
                            <field name="checkpoint"/>
                        </group>
                        <group></group>
                    </group>
                </form>
            </field>
        </record>

        <record id="aether_checkpoint_tree" model="ir.ui.view">
            <field name="name">aether.sync.checkpoint.tree</field>
            <field name="model">aether.sync.checkpoint</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="checkpoint_type"/>
                    <field name="checkpoint"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="aether_checkpoint_action">
            <field name="name">Connector Sync Checkpoint</field>
            <field name="res_model">aether.sync.checkpoint</field>

            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Sync Checkpoint Yet
                </p>

            </field>
        </record>

        <record model="ir.actions.act_window" id="aether_sync_log_action">
            <field name="name">Aether Sync Log</field>
            <field name="res_model">aether.sync.log</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Sync Record Yet
                </p>

            </field>
        </record>

        <menuitem id="menu_aether"
                  name="Aether Syncing"
                  sequence="8"
                  parent="oehealth.oeh_medical_conf_menu"/>

        <menuitem id="menu_aether_sync_log"
                  name="Aether Sync Log"
                  sequence="1"
                  parent="menu_aether"
                  action="aether_sync_log_action"/>

        <menuitem id="menu_aether_checlpoint"
                  name="Sync Checkpoints"
                  sequence="0"
                  parent="menu_aether"
                  action="aether_checkpoint_action"/>
    </data>
</odoo>