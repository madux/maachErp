        <record id="cron_aether_odoo_connector_sync" model="ir.cron">
            <field name="name">Aether Connector: Sync Data to Aether</field>
            <field name="active" eval="False" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall">0</field>
            <field name="model_id" ref="model_aether_sync_ncdc"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_to_aether()</field>
        </record>

