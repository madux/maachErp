<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_with_provider_ng_shap_shap" model="ir.ui.view">
        <field name="name">delivery.carrier.form.provider.ng.shap.shap</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position='before'>
                <page string="Shap Shap Configuration" attrs="{'invisible': [('delivery_type', '!=', 'ng_shap_shap')]}">
                    <group>
                        <group>
                            <button type="object" name="auth_get_token_shap_shap" string="Authenticate" class="btn btn-primary" />
                            <field name="email" attrs="{'required': [('delivery_type', '=', 'ng_shap_shap')]}" />
                            <field name="password" password="True" attrs="{'required': [('delivery_type', '=', 'ng_shap_shap')]}" />
                            <field name="shap_shap_token" attrs="{'required': [('delivery_type', '=', 'ng_shap_shap')]}" />
                            <field name="shap_shap_api_key" attrs="{'required': [('delivery_type', '=', 'ng_shap_shap')]}" />
                            <field name="journeyType" attrs="{'required': [('delivery_type', '=', 'ng_shap_shap')]}" />
                        </group>
                        <group>
                            <field name="shap_shap_default_packaging_id" attrs="{'required': [('delivery_type', '=', 'ng_shap_shap')]}" domain="[('package_carrier_type', '=', 'ng_shap_shap')]" />
                            <field name="shap_shap_package_weight_unit" attrs="{'required': [('delivery_type', '=', 'ng_shap_shap')]}" />
                            <field name="shap_shap_package_dimension_unit" attrs="{'required': [('delivery_type', '=', 'ng_shap_shap')]}" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position='inside'>
                <button name="fetch_tracking" attrs="{'invisible': [('state', '!=', 'done')]}" string="Get Tracking" type="object" groups="base.group_user" />
            </xpath>
        </field>
    </record>
</odoo>