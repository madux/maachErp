<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <report
            string="Patient Card"
            id="action_report_patient_label"
            model="oeh.medical.patient"
            report_type="qweb-pdf"
            name="oehealth.report_patient_label"
            file="oehealth.report_patient_label"
        />

        <report
            string="Patient Medicines Report"
            id="report_patient_medicine"
            model="oeh.medical.patient"
            report_type="qweb-pdf"
            name="oehealth.report_patientmedicine"
            file="oehealth.report_patientmedicine"
        />

	    <report
            id="action_report_appointment_receipt"
            string="Appointment Receipt"
            model="oeh.medical.appointment"
            report_type="qweb-pdf"
            name="oehealth.report_appointment_receipt"
            file="oehealth.report_appointment_receipt"
            paperformat="oehealth.oeh_paperformat_appointmentreceipt"

        />
        <!-- Prescription Lable printing-->
        <record id="paperformat_prescription" model="report.paperformat">
            <field name="name">Prescription Label</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">50</field>
            <field name="page_width">65</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">1</field>
            <field name="margin_bottom">1</field>
            <field name="margin_left">1</field>
            <field name="margin_right">1</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">1</field>
            <field name="dpi">130</field>
        </record>

        <!-- Prescription Lable printing-->
        <record id="paperformat_prescription" model="report.paperformat">
            <field name="name">Prescription Label</field>
            <field name="default" eval="True"/>
            <field name="format">custom</field>
            <field name="page_height">50</field>
            <field name="page_width">65</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">1</field>
            <field name="margin_bottom">1</field>
            <field name="margin_left">1</field>
            <field name="margin_right">1</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">1</field>
            <field name="dpi">130</field>
        </record>

        <report
                string="Prescription Report"
                id="action_oeh_medical_report_patient_prescriptions"
                model="oeh.medical.prescription"
                report_type="qweb-pdf"
                name="oehealth.report_oeh_medical_patient_prescription"
                file="oehealth.report_oeh_medical_patient_prescription"
        />

        <report
                string="Prescription Label"
                id="action_oeh_medical_report_patient_prescriptions_label"
                model="oeh.medical.prescription"
                report_type="qweb-pdf"
                name="oehealth.report_oeh_medical_patient_prescription_label"
                file="oehealth.report_oeh_medical_patient_prescription_label"
        />

        <record id="oehealth.action_oeh_medical_report_patient_prescriptions_label" model="ir.actions.report">
            <field name="paperformat_id" ref="oehealth.paperformat_prescription"/>
        </record>

    </data>
</odoo>
