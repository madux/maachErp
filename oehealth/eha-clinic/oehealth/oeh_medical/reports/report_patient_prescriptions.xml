<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_oeh_medical_patient_prescription_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-foreach="o.prescription_line" t-as="line">
                    <t t-call="web.basic_layout">
                        <div class="page">
                            <div class="container" style="font:10pt 'Open Sans';letter-spacing: 0.008em;">
                                <div class="row">
                                    <div class="col-6">
                                        <img/>
                                        <img t-att-src="'/oehealth/static/src/img/ehaclinic_black.png'" width="140" alt="Logo"/>
                                    </div>
                                    <div class="col-6 text-right">
                                        <div t-field="o.branch_id"/>,
                                        <span t-field="o.branch_id.city"/>,
                                        <span t-field="o.branch_id.country_id"/>
                                    </div>
                                </div>
                                <div class="row mt-2" style="justify-content: space-between;">
                                    <div class="col-6">
                                        <label style="font:8pt; text-transform:uppercase;letter-spacing: 0.05em;">Prescription:
                                        </label>
                                        <strong style="font:8pt;" t-field="o.name"/>
                                    </div>
                                    <div class="col-6 text-right">
                                        <label style="text-transform: uppercase;letter-spacing: 0.05em;">Date:</label>
                                        <strong t-esc="o.date.strftime('%d %b %Y')"/>
                                    </div>
                                </div>
                                <hr/>
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <strong t-field="o.patient.name"/>
                                        <div t-field="o.patient.identification_code"/>
                                    </div>
                                </div>
                                <div class="row mt-4 text-left">
                                    <div class="col-10 text-left">
                                        <strong t-field="line.name"/>
                                    </div>
                                </div>
                                <div class="row mt-2 text-left">
                                    <div class="col-10 text-left">
                                        Take
                                        <span t-field="line.dose"/>
                                        <t t-if="line.dose_unit">
                                            <span t-field="line.dose_unit"/>,
                                        </t>
                                        <t t-else="">
                                            <span t-field="line.dose_form"/>,
                                        </t>
                                        <span t-field="line.common_dosage"/>,
                                        for
                                        <t t-esc="line.duration"/>
                                        <t t-esc="line.duration_period"/>
                                    </div>
                                </div>
                                <div class="row mt-2 text-left">
                                    <div class="col-12">
                                        <span t-field="line.auxiliary_instructions"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
    <template id="report_oeh_medical_patient_prescription_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context({'lang':o.patient.partner_id.lang})"/>
            <t t-set="address">
                <div t-field="o.patient.partner_id"
                     t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
            </t>
            <div class="page">
                <div class="oe_structure"/>

                <h2>Prescription Detail</h2>

                <div class="row mt32 mb32">
                    <div t-if="o.patient" class="col-3 bm-2">
                        <strong>Patient:</strong>
                        <p class="m-0" t-field="o.patient.name"/>
                    </div>
                    <div t-if="o.name" class="col-3 bm-2">
                        <strong>Prescription#:</strong>
                        <p class="m-0" t-field="o.name"/>
                    </div>
                    <div t-if="o.doctor" class="col-3 bm-2">
                        <strong>Physician:</strong>
                        <p class="m-0" t-field="o.doctor.name"/>
                    </div>
                </div>
                <div class="row mt32 mb32">
                    <div t-if="o.date" class="col-3 bm-2">
                        <strong>Date:</strong>
                        <p class="m-0" t-field="o.date"/>
                    </div>
                    <div t-if="o.pharmacy" class="col-3 bm-2">
                        <strong>Pharmacy:</strong>
                        <p class="m-0" t-field="o.pharmacy"/>
                    </div>
                </div>


                <table class="table table-condensed mt32">
                    <thead>
                        <tr>
                            <th class="text-left">MEDICINE</th>
                            <th class="text-left">DOSE</th>
                            <th class="text-left">UNIT</th>
                            <th class="text-left">FORM</th>
                            <th class="text-center">FREQUENCY</th>
                            <th class="text-left">DURATION</th>
                            <th class="text-left">TREATMENT PERIOD</th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <tr t-foreach="o.prescription_line" t-as="l">
                            <td class="text-left">
                                <strong>
                                    <span t-field="l.name.name"/>
                                </strong>
                            </td>
                            <td>
                                <span t-field="l.dose"/>
                            </td>
                            <td class="text-left">
                                <span t-field="l.dose_unit.name"/>
                            </td>
                            <td class="text-left">
                                <span t-field="l.dose_form.name"/>
                            </td>
                            <td class="text-center">
                                <span t-field="l.qty"/>
                            </td>
                            <td class="text-left">
                                <span t-field="l.duration"/>
                            </td>
                            <td class="text-left">
                                <span t-field="l.duration_period"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template id="report_oeh_medical_patient_prescription">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="oehealth.report_oeh_medical_patient_prescription_document"
                   t-lang="o.patient.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
