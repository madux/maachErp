<?xml version="1.0" encoding="UTF-8"?>
<templates id="prescription_modal" xml:space="preserve">
    <t t-name="eha_website_sale.get_prescription">
        <div class="modal" id="appointment_booking_modal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <!-- Modal Header -->
                    <div class="modal-header">
                        <h4 class="modal-title">Get a Prescription</h4>
                        <button type="button" class="close" data-dismiss="modal">&amp;times;</button>
                    </div>

                    <!-- Modal body -->
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12">
                                <p>Prescription medications require a direct prescription by our doctor. Please book an appointment for a medical diagnosis.</p>
                            </div>
                        </div>
                        <div class="row border-top-blue p-4">
                            <div class="col-sm-4">
                                <img class="img-contain" src="/eha_website/static/src/img/illu-telehealth-small.png" />
                            </div>
                            <div class="col-sm-8">
                                <p>Have a virtual consultation with one of our doctors right from the comfort of your home. If this is your first visit, you will be required to pay a registration fee of ₦5500. The consultation with the doctor costs ₦7500, but is free for members</p>
                                <button id="telehealth_book" class="btn btn-primary">
                                    BOOK TELEHEALTH CONSULTATION
                                </button>
                            </div>
                        </div>
                        <div class="row border-top-blue p-4">
                            <div class="col-sm-4">
                                <img class="img-contain" src="/eha_website/static/src/img/illu-doctor-appointment.png" />
                            </div>
                            <div class="col-sm-8">
                                <p>See a doctor at a clinic location most convenient for you. If this is your first visit, you will be required to pay a registration fee of ₦5500. The consultation with the doctor costs ₦7500, but is free for members</p>
                                <button id="clinic_appointment_book" class="btn btn-primary">
                                    BOOK CLINICS APPOINTMENT
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="eha_website_sale.telehealth">
        <iframe name="content" src='/telehealth-page' frameborder="no" border="0" width="600" height="800">
        </iframe>
    </t>

    <t t-name="eha_website_sale.appointment">
        <iframe name="content" src='/appointment_page' frameborder="no" border="0" width="600" height="800">
        </iframe>
    </t>

    <t t-name="eha_website_sale.verify_dob_modal">
        <div class="container">
            <div class="row">
                <p>Please enter the date of birth of the patient, that received the prescription.</p>
            </div>

            <div class="row">
                <label class="mb-2">Date Of Birth: </label>
                <input name="verify_dob" type="date" autocomplete="off" class="form-control o_website_form_input" data-target="#verify_dob"/>
            </div>
        </div>
    </t>

    <t t-name="eha_website_sale.prescription_details">
        <label class="small">Prescription ID</label>
        <p class="prescription_id">
            <t t-esc="data.prescription_id"/>
        </p>
        <label class="small">Prescription Date</label>
        <p class="prescription_date">
            <t t-esc="formated_date"/>
        </p>
        <label class="small">Prescribed by</label>
        <p class="prescriber">
            <t t-esc="data.prescribed_by"/>
        </p>
    </t>

    <t t-name="eha_website_sale.prescription_lines">
        <t t-foreach="lines" t-as="line">
            <div class="oe_product">
                <div class="prescription-product card oe_product_cart">
                    <div class="card-body p-1 oe_product_image">
                        <div class="ribbon-wrapper">
                            <a href="#" role="button" class="ribbon btn btn-danger">Sale</a>
                        </div>
                        <a class="d-block h-100" t-att-href="line.product_url">
                            <span class="d-flex h-100 justify-content-center align-items-center">
                                <img t-att-src="'/web/image?model=product.product&amp;id='+line.product_id+'&amp;field=image_128'" class="img img-fluid"/>
                            </span>
                        </a>
                    </div>
                    <div class="card-body o_wsale_product_information">
                        <div class="p-2 o_wsale_product_information_text">
                            <h6 class="o_wsale_products_item_title">
                                <a itemprop="name" t-att-href="line.product_url">
                                    <t t-esc="line.name"/>
                                </a>
                            </h6>
                            <div class="product_price">
                                <strong>
                                    ₦ <span t-esc="line.price.toFixed(2)"/>
                                </strong>
                            </div>
                            <div class="product_description">
                                    <t t-raw="line.description_sale"/>
                            </div>
                        </div>
                        <div class="prescription_product_btn">
                            <a t-if="(line.purchased_qty &lt; line.qty) &amp; !line.is_refillable" type="button" role="button" class="btn btn-primary btn-icon o_add_cart" title="Add to Cart" t-att-product-template-id="line.product_tmpl_id" t-att-prescription_id="line.prescription_id" t-att-qty="line.qty" t-att-purchased-qty="line.purchased_qty" t-att-product-product-id="line.product_id" style="width:fit-content;">
                                <img src="/eha_website_sale/static/src/img/icon-cart-white.svg" height="16px" class="icon-cart"/>
                            </a>
                            <button t-if="(line.refill_qty &lt; line.qty) &amp; line.is_refillable &amp; !line.expired" type="button" role="button" class="btn btn-primary is_refillable o_add_cart" title="Refill Cart" t-att-product-template-id="line.product_tmpl_id" t-att-prescription_id="line.prescription_id" t-att-qty="line.qty" t-att-purchased-qty="line.purchased_qty" t-att-product-product-id="line.product_id" t-att-line-id="line.id" style="width:fit-content;">
                                Refill
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </t>
</templates>
