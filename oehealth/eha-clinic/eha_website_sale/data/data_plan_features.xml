        <!-- Mail Template for pharmacy -->
        <record id="email_template_sale_order_link" model="mail.template">
            <field name="name">Sale</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="partner_to">${object.partner_id.id}</field>
            <field name="subject">Successful Online Purchase (Ref ${object.name or 'n/a'})</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear
                        % if object.partner_id.parent_id:
                            ${object.partner_id.name} (${object.partner_id.parent_id.name}),
                        % else:
                            ${object.partner_id.name},
                        % endif
                        <br /><br />
                        A successful purchase with Sale Order number ${object.name or 'n/a'} has been made on the online pharmacy. <br />
                        Please log into the ERP to process the items for delivery. <br />
                        Do not hesitate to contact us if you have any questions. <br />
                        <t t-elif="record.state not in ('draft', 'sent')">
                            <t t-set="access_name">View SaleOrder</t>
                        </t>
                        % set website_url = object.env['ir.config_parameter'].sudo().get_param('web.base.url')
                        <a href='${website_url}/${object.access_url}'>View Sales Order</a>
                    </p>
                </div>
            </field>
            <field name="report_template" ref="sale.action_report_saleorder"/>
            <field name="report_name">${(object.name or '').replace('/','_')}</field>
            <field name="lang">${object.partner_id.lang}</field>
        </record>
