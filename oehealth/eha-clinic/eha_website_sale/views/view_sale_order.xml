<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="eha_sale_order_view_search_inherit" model="ir.ui.view">
                <field name="name">eha.sale.order.search.inherit</field>
                <field name="model">sale.order</field>
                <field name="inherit_id" ref="sale.view_sales_order_filter"/>
                <field name="arch" type="xml">
                    <xpath expr="//filter" position="inside">
                        <filter string="Delivered Orders" name="delivered_orders" domain="[('order_status','=','delivered')]"/>
                    </xpath>
                </field>
        </record>
        
        <record id="sale_order_view_form" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.event.sale</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <field name="payment_term_id" position="after">
                    <field name="order_status"/>
                </field>
            </field>
        </record>
        
        <!-- Sales Order -->
        <record id="action_update_order_status" model="ir.actions.server">
            <field name="name">Update Delivery Status</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = records.update_order_status()</field>
        </record>

        <!-- Stock Picking -->
        <record id="action_update_stock_order_status" model="ir.actions.server">
            <field name="name">Update Delivery Status</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">action = records.update_order_status()</field>
        </record>

        <!-- Picking View -->
        <record id="picking_view_form" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.eha</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <field name="origin" position="after">
                    <field name="order_status"/>
                </field>
            </field>
        </record>
    </data>
</odoo>