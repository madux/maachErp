<odoo>
    <data>
        <template id="website_prescription_booking" name="Prescription Booking">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty">
                    <div class="oe_structure" id="oe_structure_website_sale_products_1">
                        <t t-call="eha_website_sale.banner">
                            <t t-set="collapsed" t-value="true"></t>
                        </t>
                    </div>
                    <t t-call="eha_website_sale.pharmacy-nav">
                        <t t-set="prescriptions" t-value="true"></t>
                    </t>
                    <div t-if="not is_public" class="container eha_prescription">
                        <div class="row mt-5">
                            <div class="col-md-12">
                                <h3>My EHA Clinics prescriptions</h3>
                            </div>
                        </div>
                        <div class="row mt-5">
                            <div class="col-md-6 pt-3">
                                <h5>You have a prescription from EHA Clinics and want to order?</h5>
                                <p>Please enter the ID of your prescription. You can find the ID at the top of the prescription that was sent to you by email.</p>
                            </div>
                            <div class="col-md-6">
                                <div class="box-rounded light-blue">
                                    <form>
                                        <label class="mb-2">Prescription ID</label>
                                        <div class="input-group rounded">
                                            <div class="input-group-append">
                                                <input type="text" name="prescriptionID" class="form-control" placeholder="P00000..." value="" />
                                                <button type="button" class="btn btn-primary prescriptionID" aria-label="Submit" title="Submit">VERIFY</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="row mt-4 pt-4 pb-4 border-top-blue">

                            <div class="col-sm-3">

                            </div>
                            <div class="col-sm-9">
                                    Please add a prescription ID to purchase online!
                            </div>
                        </div>
                    </div>
                    <div t-else="1">
                        <div class="container">
                            <div class="row mb-5">
                                <div class="col-md-6 mt-5">
                                    <h3>You have a prescription from EHA Clinics?</h3>
                                    <p>You can order items from our pharmacy that have been prescribed by one of our EHA Clinics doctors.</p>
                                    <a href='/web/login?redirect=/shop/prescription_booking' class="btn btn-primary">SIGN IN</a>
                                    <h5 class="mt-5">You haven't been registered with EHA Clinics yet?</h5>
                                    <p>Register now to unlock more features such as ordering and refilling your prescriptions.</p>
                                    <a href='/web/signup?redirect=/shop/prescription_booking' class="btn btn-primary">REGISTER</a>

                                </div>
                                <div class="col-md-6 mt-5">
                                    <h3>Why do I need a Prescription?</h3>
                                    <p>All medications that are not over the counter require a direct prescription by our Doctor. Prescription medications are specially tailored for use by a specific person for specific use as they may cause different reactions in some individuals. Prescription medications require a medical diagnosis before they can be purchased at EHACLINICS. Using prescription medications unsupervised can lead to harm if misused, or abused.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Bootstrap Modals -->
                <div class="modal fade in" tabindex="-1" role="dialog" id="verify_dob_modal">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h2 class="modal-title">Patient's Date Of Birth</h2>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    &amp;times;
                                </button>
                            </div>
                            <div class="modal-body">
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-primary mr-auto" data-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-primary">Confirm</button>
                                
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>


    </data>
</odoo>
