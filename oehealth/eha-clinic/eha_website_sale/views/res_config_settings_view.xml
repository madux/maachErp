<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.ecommerce</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="website.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='website_info_settings']" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box" id="live_chat_install_setting">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Zip Code Link</span>
                            <div class="text-muted">
                                Live chat channel of your website
                            </div>
                            <div class="content-group mt16">
                                <div class="row">
                                    <label class="col-lg-3 o_light_label" string="Zip Code URL" for="ecommerce_zip_code_link"/>
                                    <field name="ecommerce_zip_code_link" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box" id="live_chat_install_setting">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Ecommerce Product Pricelist</span>
                            <div class="text-muted">
                                Pricelists for Online Pharmacy and co.
                            </div>
                            <div class="content-group mt16">
                                <div class="row">
                                    <label class="col-lg-3 o_light_label" string="Members Pricelist" for="member_pricelist"/>
                                    <field name="member_pricelist" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="content-group mt16">
                                <div class="row">
                                    <label class="col-lg-3 o_light_label" string="Non-members Pricelist" for="non_member_pricelist"/>
                                    <field name="non_member_pricelist" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="website_sale_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.website.sale</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='sale_product_catalog_settings']" position="inside">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Product Tagline</span>
                            <div class="content-group mt16">
                                <div class="row">
                                    <field name="website_product_tagline" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
                
            </field>
        </record>

    </data>
</odoo>
