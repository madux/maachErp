<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="product_template_only_form_website_extension" model="ir.ui.view">
            <field name="name">product.template.product.form.website.extension</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='barcode']" position="before">
                    <field name="child_product_ids" widget="many2many_tags"/>
                    <field name="display_price_on_website"/>
                    <field name="display_product_on_website"/>
                    <field name="is_featured"/>
                </xpath>
            </field>
        </record>

        <record id="product_template_extension" model="ir.ui.view">
            <field name="name">product.template.form.extension</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//group[@name='group_standard_price']/label" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group[@name='group_standard_price']/div/field[@name='list_price']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group[@name='group_standard_price']/div[@name='pricing']" position="before">
                    <field name="categ_name" invisible="1"/>
                    <field name="sequence" invisible="0"/>
                    <field name="list_price" attrs="{'invisible': [('categ_name', '=', 'Direct Care Membership')]}"/>
                </xpath>
                <xpath expr="//group[@name='group_standard_price']/div[@name='pricing']/field[@name='list_price']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@name='general_information']" position="after">
                    <page name="Features" string="Product Features">
                        <field name="product_feature_ids" widget="many2many" context="{'default_product_id' : active_id}">
                            <tree>
                                <field name="name"/>
                                <field name="category"/>
                            </tree>
                            <form>
                                <group>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="description"/>
                                </group>
                            </form>
                        </field>
                        <p class="oe_grey">
                            <strong>Warning</strong>:
                        </p>
                    </page>
                </xpath>

                <field name="type" position="before">
                    <field name="plan_id" attrs="{'invisible': [('categ_name', '!=', 'Direct Care Membership')]}"/>
                </field>

                <div name="options" position="inside">
                    <div>
                        <field name="is_prescription_product"/>
                        <label for="is_prescription_product"/>
                    </div>
                </div>
                
                <group name="description" position="after">
                    <group name="html_description_sale">
                        <separator string="HTML Sales Description (For healthmate Use)"/>
                        <field name="html_description_sale" widget = "html" nolabel="1"/>
                    </group>
                    <group>
                        <field name="product_description_prescription" nolabel="1" placeholder="This note is added for prescription description on website product page."/>
                    </group>
                </group>
            </field>
        </record>

        <record id="product_public_category_form_view_extension" model="ir.ui.view">
            <field name="name">product.public.category.form.extension</field>
            <field name="model">product.public.category</field>
            <field name="inherit_id" ref="website_sale.product_public_category_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sequence']" position="after">
                    <field name="code"/>
                </xpath>
            </field>
        </record>
    
    </data>
</odoo>
