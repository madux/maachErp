<?xml version="1.0" ?>
<odoo>
    <data>
        <template id="product_card">
            <div class="oe_product">
                <form class="card oe_product_cart">
                    <div class="ribbon-wrapper">
                        <div class="ribbon ribbon-info">Home
                            
                            <br/>TEST KIT
                        
                        </div>
                    </div>
                    <div class="card-body p-0 o_wsale_product_information">
                        <div class="o_wsale_product_information_text">
                            <h6 class="o_wsale_products_item_title">
                                <a itemprop="name" t-att-href="product.website_url" content="Health Test"><t t-esc="product.name" /></a>
                            </h6>
                        </div>
                        <div class="image">
                          <img class="rounded w-100 mb-2" t-att-src="image_data_uri(product.image_512)" alt="Product Image"/>
                       </div>
                        <div class="description" contenteditable="false">
                            <p t-raw="product.description_sale" />
                            <ul t-if="product.product_feature_ids" class="product-features">
                                <t t-foreach="product.product_feature_ids" t-as="pf">
                                    <li><t t-esc="pf.name"/></li>
                                </t>   
                            </ul>
                            <a t-att-href="product.website_url" class="btn btn-outline-primary">learn more</a>
                        </div>
                        <div class="product_price" itemprop="offers" itemscope="itemscope" itemtype="http://schema.org/Offer">
                            <span itemprop="price"><t t-esc="product.list_price" /></span>
                            <span itemprop="priceCurrency">NGN</span>
                        </div>
                        <div class="o_wsale_product_btn">
                            <a name="cart_add" t-attf-data-id="{{product.id}}" role="button" class="btn btn-primary btn-icon a-submit" aria-label="Shopping cart" title="Shopping cart" data-oe-model="ir.ui.view" data-oe-id="2736" data-oe-field="arch" data-oe-xpath="/data/xpath/t[2]/a[1]">
                                <img t-attf-data-id="{{product.id}}" src="/eha_website_sale/static/src/img/icon-cart-white.svg" height="16px" class="icon-cart" />
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </template>
        <!--Health Tests-->
        <template id="topic_healthtests" name="Health Tests">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty"></div>
                <div style="overflow: hidden; position:fixed; z-index:1; left: 85%; margin-top:30px" class="toast d-none" data-autohide="false">
                    <div class="toast-header">
                        <strong class="mr-auto text-success"><b>Item Added to Cart</b></strong>
                        <button type="button" class="ml-2 mb-1 close" data-dismiss="toast">x</button>
                    </div>
                    <div style="color:black" class="toast-body">
                        <b>Item have been added to cart</b><br/>
                        click <a href="/shop/cart/">here</a> to go to the cart
                    </div>
                </div>
                <section class="s_cover parallax s_parallax_no_overflow_hidden" data-scroll-background-ratio="0" style="background-image: none;">
                  <span class="s_parallax_bg oe_img_bg oe_custom_bg" style="background-image: url(&quot;/eha_website/static/src/img/bg-healthtests.jpg&quot;); background-position: 48.83% 30.35%;"/>
                  <div class="container">
                    <div class="row s_nb_column_fixed">
                      <div class="col-lg-12 s_title pt48 pb0" data-name="Title">
                        <h1 class="title-banner text-center">
                          <span class="text-highlight">Health Tests</span>
                        </h1>
                        <p class="subtitle-banner text-center">Know yourself, know your health. </p>
                      </div>
                    </div>
                    <div class="p-4 px-lg-5 row justify-content-center">
                      <div class="box-rounded shadow no-plan mx-lg-5">
                        <h5 class="text-center">Find your tests</h5>
                        <div class="row">
                          <div class="col-6 col-sm-3 text-center py-2 py-sm-0 px-1">
                            <a class="scrollLink" href="#womens-health">
                              <img class="rounded rounded-circle w-50 mb-2" src="/eha_website/static/src/img/test-female.jpg" width="60px"/>
                              <div>Women's Health</div>
                            </a>
                          </div>
                          <div class="col-6 col-sm-3 text-center py-2 py-sm-0 px-1">
                            <a href="#mens-health">
                              <img class="rounded rounded-circle w-50 mb-2" src="/eha_website/static/src/img/tests-men.jpg" width="60px" data-original-title="" title="" aria-describedby="tooltip201587"/>
                              <div>Men's Health</div>
                            </a>
                          </div>
                          <div class="col-6 col-sm-3 text-center py-2 py-sm-0 px-1">
                            <a href="#wellness">
                              <img class="rounded rounded-circle w-50 mb-2" src="/eha_website/static/src/img/test-diagnosis.jpg" width="60px" data-original-title="" title="" aria-describedby="tooltip711293"/>
                              <div>Wellness</div>
                            </a>
                          </div>
                          <div class="col-6 col-sm-3 text-center py-2 py-sm-0 px-1">
                            <a href="#health-packages">
                              <img class="rounded rounded-circle w-50 mb-2" src="/eha_website/static/src/img/test-package.jpg" width="60px" data-original-title="" title="" aria-describedby="tooltip905941"/>
                              <div>Health Packages</div>
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </section>
                <div class="container mt-2">
                    <div class="row">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="/get-care">Get Care</a>
                            </li>
                            <li class="breadcrumb-item active">
                                <span>Health Tests</span>
                            </li>
                        </ol>
                    </div>
                </div>
                 <div class="container my-4">
                    <div class="row">
                        <div class="col-md-8">
                             <h3>A simple test you can do at home unlocks valuable insights into your health.</h3>
                            <p class="text-lg">With quick analysis at our labs, and direct consultations with our medical team, we’re here to help you stay healthy and active now and in the years ahead.</p>
                        </div>
                        <div class="col-md-4">
                            <div class="box-rounded p-3 m-0">
                                <h5>You have purchased a health test and want to come to the Clinic to collect your sample?</h5>
                                <t t-call="eha_website_sale.labtest-booking"></t>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="container dashed-border-top">
                  <div class="p-5 text-center">
                    <p class="text-center uppercase small text-purple">HOW IT WORKS</p>
                    <h2 class="text-center mb-2">Get tested with EHA Clinics</h2>
                  </div>
                </div>
                <div class="container">
                  <div class="row">
                    <div class="col-md-8 p-2 px-4 order-md-0 order-1">
                      <div class="row">
                        <div class="col-3 text-right">
                          <i class="fa fa-2x background eha-cart rounded-leaf text-purple" data-original-title="" title="" aria-describedby="tooltip857382" style="background-color: rgb(206, 231, 247);"/>
                        </div>
                        <div class="col-9">
                          <h4 class="text-purple">Order your test oline</h4>
                          <p>Pick from our tests, add them to your cart and conveniently pay online.</p>
                        </div>
                      </div>
                      <div class="row mt-3">
                        <div class="col-3 text-right">
                          <i class="fa fa-2x background eha-lab rounded-leaf text-purple" data-original-title="" title="" aria-describedby="tooltip857382" style="background-color: rgb(206, 231, 247);"/>
                        </div>
                        <div class="col-9">
                          <h4 class="text-purple">Get your sample collected</h4>
                          <p>For a home test kit, your test will be delivered to your home. Simply follow the instructions for your test.</p>
                          <p>For other tests visit our Lab at EHAClinics. Conveniently book your appointment <a href="">here</a>.</p>
                        </div>
                      </div>
                      <div class="row mt-3">
                        <div class="col-3 text-right">
                          <i class="fa fa-2x background eha-telemedicine rounded-leaf text-purple" data-original-title="" title="" aria-describedby="tooltip857382" style="background-color: rgb(206, 231, 247);"/>
                        </div>
                        <div class="col-9">
                          <h4 class="text-purple">Consult a doctor</h4>
                          <p>You have questions about your test result? Consult a doctor in a <a href="">Telehealth</a>Appointment.</p>
                        </div>
                      </div>
                    </div>
                    <div class="col-md-4 p-2 px-4 d-flex align-items-center justify-content-center order-md-1 order-0">
                      <img class="align-self-center" src="/eha_website/static/src/img/illu-mobile-pharmacy.png" width="250px"/>
                    </div>
                  </div>
                </div>
                <div id="womens-health" class="background-gradient-pink mt-4">
                  <div class="container pt-5 pb-3">
                    <div class="row align-items-start">
                      <div class="col-md-4 text-white mb-5">
                        <h3 class="text-white">Women's Health</h3>
                        <p>Screenings are tests that look for diseases before you have symptoms. They can find diseases or viruses early, so that they're easier to treat or vaccines administered if need be.</p>
                        <h5 class="mt-4">Do you have questions about our DIY tests?</h5>
                        <button class="btn btn-primary Linkify" onclick="LC_API.open_chat_window();return false;">Chat with us</button>
                      </div>
                      <div class="col-md-8 grid products-grid">
                        <t t-foreach="hsWomen_products" t-as="product">
                            <t t-call="eha_website_sale.product_card" />
                        </t>
                        </div>
                      </div>
                    </div>
                  </div>
                <div id="mens-health" class="background-gradient-green border-top-white">
                  <div class="container pt-5 pb-3">
                    <div class="row align-items-start">
                      <div class="col-md-4 text-white mb-4">
                        <h3 class="text-white">Men's Health</h3>
                        <p>Screenings are tests that look for diseases before you have symptoms. They can find diseases or viruses early, so that they're easier to treat or vaccines administered if need be.</p>
                        <h5 class="mt-4">You have a question about Sexually Transmitted Diseases?</h5>
                        <button class="btn btn-primary" onclick="LC_API.open_chat_window();return false;">Chat with us</button>
                      </div>
                      <div class="col-md-8 grid products-grid">
                        <t t-foreach="hsMen_products" t-as="product">
                            <t t-call="eha_website_sale.product_card" />
                        </t>
                        </div>
                    </div>
                  </div>
                </div>
                <div id="wellness" class="background-gradient-blue border-top-white">
                  <div class="container">
                    <div class="row align-items-start pt-5 pb-5">
                      <div class="col-md-4 text-white mb-4">
                        <h3 class="text-white">Wellness and Diagnosis</h3>
                        <p>Screenings are tests that look for diseases before you have symptoms. They can find diseases or viruses early, so that they're easier to treat or vaccines administered if need be.</p>
                        <h5 class="mt-4">You have a question about Sexually Transmitted Diseases?</h5>
                        <button class="btn btn-primary" onclick="LC_API.open_chat_window();return false;">Chat with us</button>
                      </div>
                      <div class="col-md-8 grid products-grid">
                        <t t-foreach="hsDiagnosis_products" t-as="product">
                            <t t-call="eha_website_sale.product_card" />
                        </t>
                        </div>
                    </div>
                  </div>
                </div>
                <div id="health-packages" class="background-purple border-top-white">
                  <div class="container">
                    <div class="row align-items-start pt-5 pb-5">
                      <div class="col-md-4 text-white mb-4">
                        <h3 class="text-white">Health Packages</h3>
                        <p>Screenings are tests that look for diseases before you have symptoms. They can find diseases or viruses early, so that they're easier to treat or vaccines administered if need be.</p>
                        <h5 class="mt-4">You have a question about Sexually Transmitted Diseases?</h5>
                        <button class="btn btn-primary" onclick="LC_API.open_chat_window();return false;">Chat with us</button>
                      </div>
                      <div class="col-md-8 grid products-grid">
                        <t t-foreach="hsPackages_products" t-as="product">
                            <t t-call="eha_website_sale.product_card" />
                        </t>
                        </div>
                    </div>
                  </div>
                </div>
            </t>
        </template>
    </data>
</odoo>
