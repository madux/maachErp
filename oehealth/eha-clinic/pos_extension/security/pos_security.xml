<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--########################### Groups ###############################-->

    <record id="point_of_sale.group_pos_user" model="res.groups"> 
        <field name="name">Field Nurse</field>
        <!-- <field name="implied_ids" eval="[(4, ref('sale_subscription_extension.group_sale_subscription_manager'))]"/> -->
        <field name="category_id" ref="base.module_category_point_of_sale"/>
    </record>

    <!--POS Accountant-->
    <record id="group_pos_accountant" model="res.groups">
        <field name="name">POS Accountant</field>
        <field name="category_id" ref="base.module_category_point_of_sale"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>


    <!--############################ Menus ###############################-->

    <!--Add POS Menu to POS Accountant-->
    <record model='ir.ui.menu' id='point_of_sale.menu_point_root'>
        <field name="groups_id" eval="[(4,ref('pos_extension.group_pos_accountant')),]"/>
    </record>


    <!-- ############################# Record Rules ##################################-->

    <!-- Field Nurse Order -->
    <record id="point_of_sale.rule_pos_multi_company" model="ir.rule">
        <field name="name"> Field Nurse to see only own orders</field>
        <field name="model_id" ref="point_of_sale.model_pos_order" />
        <field name="domain_force">[('company_id', '=', user.company_id.id),('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <!-- Admin and POS Accountant order-->
    <record id="rule_pos_all_multi_company" model="ir.rule">
        <field name="name">Access all orders</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <!-- <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager')), (4, ref('pos_extension.group_pos_accountant'))]"/> -->
    </record>
    
    <!-- Field Nurse POS Config-->
    <record id="point_of_sale.rule_pos_config_multi_company" model="ir.rule">
        <field name="name">Field Nurse to Access Own POS Config</field>
        <field name="model_id" ref="point_of_sale.model_pos_config" />
        <field name="domain_force">[('company_id','child_of',[user.company_id.id]),('pos_session_assigned.id','=',user.id)]</field>
        <!-- <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/> -->
    </record>

    <!-- Admin and POS Accountant POS Config-->
    <record id="rule_pos_config_multi_company" model="ir.rule">
        <field name="name">Access all POS Configs</field>
        <field name="model_id" ref="point_of_sale.model_pos_config" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <!-- <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager')), (4, ref('pos_extension.group_pos_accountant'))]"/> -->
    </record>
</odoo>