    <t t-extend="ClientDetails">
        <t t-jquery="div.client-details-right" t-operation="append">
            <div class="client-detail">
                <!-- <span class="label">HP No: </span> -->
                <span class='label'>HP No:</span>
                <t t-if='!partner.hp_number'>
                    <span class='detail hp_number empty'>N/As</span>
                </t>
                <t t-if='partner.hp_number'>
                   <span class='detail hp_number'><t t-esc='partner.hp_number'/></span>
                </t> 
                
            </div> 
            <div class="client-detail">
                <!-- <span class="label">HP No: </span> -->
                <span class='label'>Parent Company:</span>
                <t t-if='!partner.parent_id'>
                    <span class='detail parent_id empty'>N/As</span>
                </t>
                <t t-if='partner.parent_id'>
                   <span class='detail parent_id'><t t-esc='partner.parent_id'/></span>
                </t> 
            </div> 
            <div class='client-detail'>
                <t t-if='!partner.company_type'>
                    <span class='label'>Company type: </span>
                   <span class='detail company_type'>N/A</span>
                </t>
                <t t-if="partner.company_type">
                    <span class='label client-address-country'>Company type: </span>
                     <select class='detail client-address-country needsclick' name='company_type'>
                        <option t-att-value='person' t-att-selected="partner.company_type === 'person' ? true : undefined">Individual</option>
                        <option t-att-value='company' t-att-selected="partner.company_type === 'company' ? true : undefined">Company</option>
                    </select>
                </t>
            </div> 
                

            
        </t>
    </t>

    <t t-extend="ClientListScreenWidget">
        <t t-jquery="table.client-list" t-operation="replace">
            <table class='client-list'>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Address</th>
                        <th>Phone</th>
                        <th>HP No.</th>
                    </tr>
                </thead>
                <tbody class='client-list-contents'>
                </tbody>
            </table>

        </t>
    </t>

    <t t-extend="ClientLine">
        <t t-jquery="tr.client-line" t-operation="replace">
            <tr class='client-line' t-att-data-id='partner.id'>
                <td><t t-esc='partner.name' /></td>
                <td><t t-esc='partner.address' /></td>
                <td><t t-esc='partner.phone or partner.mobile or ""' /></td>
                <td>
                    <t t-if="partner.hp_number">
                        <t t-esc='partner.hp_number' />
                    </t>
                </td>
            </tr>
        </t>
    </t>
</templates>