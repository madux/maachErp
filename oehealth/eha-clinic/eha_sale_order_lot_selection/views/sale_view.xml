<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_tree_lot" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_template_id']" position="before">
                <field name="product_type" invisible="1"/>
                <field name="lot_scan"/>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='product_template_id']"
                position="after"
            >
                <field
                    name="lot_id"
                    domain="[('product_id','=', product_id)]"
                    context="{'default_product_id': product_id}"
                    groups="stock.group_production_lot"
                    optional="hide"
                />
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="before">
                <field name="lot_expiry_date" optional="show"/>
                <field name="lot_expiry_notice_date" invisible="1"/>
                <field name="days_to_expire" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form/group/group/field[@name='product_id']" position="before">
                <field name="product_type" invisible="1"/>
                <field name="lot_scan"/>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form/group/group/field[@name='product_id']"
                position="after"
            >
                <field
                    name="lot_id"
                    domain="[('product_id','=', product_id)]"
                    context="{'default_product_id': product_id}"
                    groups="stock.group_production_lot"
                    optional="hide"
                />
            </xpath>
            <xpath expr="//field[@name='order_line']/form/group/group/field[@name='price_unit']" position="before">
                <field name="lot_expiry_date" optional="show"/>
            </xpath>
            <!-- <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="decoration-danger">lot_id != False and state not in ('sale', 'done') and current_date &gt; lot_expiry_notice_date</attribute>
            </xpath> -->
        </field>
    </record>
</odoo>
