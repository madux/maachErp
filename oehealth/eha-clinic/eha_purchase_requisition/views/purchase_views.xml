<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="eha_view_purchase_order_filter" model="ir.ui.view">
            <field name="name">eha.request.quotation.select</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
            <field name="arch" type="xml">
                <field name="product_id" position="after">
                    <field name="order_line" string="Description" filter_domain="[('order_line.name', 'ilike', self)]"/>
                    <field name="order_line" string="Product Category" filter_domain="[('order_line.product_id.categ_id', 'child_of', self)]"/>
                </field>
            </field>
        </record>

    </data>
</odoo>