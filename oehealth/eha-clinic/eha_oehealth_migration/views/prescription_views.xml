<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="oeh_medical_prescription_migration_view_inherites" model="ir.ui.view">
            <field name="name">oeh.medical.prescription.view.form.inherit</field>
            <field name="model">oeh.medical.prescription</field>
            <field name="inherit_id" ref="oehealth_extension.oeh_medical_prescription_view_inherites" />
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='dispenser']" position="after">
                    <field name="migrated_prescription_to_emr" string="Migrated Prescription" />
                    <field name="evaluation_id" string="Evaluation ID" invisible="1"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>

