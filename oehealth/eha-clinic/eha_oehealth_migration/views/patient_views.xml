<odoo>
  <data>

    <record id="oeh_medical_patient_view" model="ir.ui.view">
      <field name="name">oeh.medical.patient.view.form.inherit.eha_oehealth_migration</field>
      <field name="model">oeh.medical.patient</field>
      <field name="inherit_id" ref="oehealth.oeh_medical_patient_view" />
      <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
          <button name="migrate_patient_to_emr" type="object" string="Migrate to EMR" class="oe_highlight" groups="eha_oehealth_migration.group_migration_user" attrs="{'invisible': [('migrated_to_emr', '=', True)]}" />
        </xpath>
        <xpath expr="//notebook" position="inside">
          <page name="migration_info" string="Migration Information" groups="eha_oehealth_migration.group_migration_user">
            <group>
              <group>
                <field name="migrate_to_emr" />
                <field name="migrated_to_emr" readonly="True" />
              </group>
              <group>
                <field name="ehr_id" />
                <field name="demographics_id" />
              </group>
              <group string="Allergies Migration">
                <field name="migrated_allergies_to_emr" />
                <field name="allergy_ids" widget="many2many_tags" />
              </group>
              <group string="Blood Group Migration">
                <field name="migrated_blood_group_to_emr" />
              </group>
              <group string="Past medical history">
                <field name="migrated_past_medical_history_to_emr" />
              </group>
              <group string="">
              </group>
            </group>
          </page>
        </xpath>
      </field>
    </record>

    <!-- Select a number of patients and migrate them to EMR -->
    <record model="ir.actions.server" id="action_migrate_patient_to_emr">
      <field name="name">Migrate Patient To EMR</field>
      <field name="model_id" ref="oehealth.model_oeh_medical_patient" />
      <field name="binding_model_id" ref="oehealth.model_oeh_medical_patient" />
      <field name="state">code</field>
      <field name="code">
          if records:
              action = records.migrate_patient_to_emr()
      </field>
    </record>

    <record model="ir.actions.server" id="action_migrate_blood_group_to_emr">
      <field name="name">Migrate Blood Group To EMR</field>
      <field name="model_id" ref="oehealth.model_oeh_medical_patient" />
      <field name="binding_model_id" ref="oehealth.model_oeh_medical_patient" />
      <field name="state">code</field>
      <field name="code">
          if records:
              action = records.migrate_blood_group_to_emr()
      </field>
    </record>

    <record model="ir.actions.server" id="action_migrate_allergies_to_emr">
      <field name="name">Migrate Allergies To EMR</field>
      <field name="model_id" ref="oehealth.model_oeh_medical_patient" />
      <field name="binding_model_id" ref="oehealth.model_oeh_medical_patient" />
      <field name="state">code</field>
      <field name="code">
          if records:
              action = records.migrate_allergies_to_emr()
      </field>
    </record>

  </data>
</odoo>