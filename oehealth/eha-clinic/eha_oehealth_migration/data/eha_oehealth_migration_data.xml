<odoo>
  <data noupdate="0">

    <record id="composition_url" model="ir.config_parameter">
      <field name="key">eha_oehealth_migration.composition_url</field>
      <field name="value">https://dev-bettercare.eha.ng/ehr/rest/v1/composition</field>
    </record>

    <record id="patient_migration_cron" model="ir.cron">
      <field name="name">EMR Patient Migration</field>
      <field name="model_id" ref="model_oeh_medical_patient" />
      <field name="state">code</field>
      <field name="code">model._migrate_patient_to_emr()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field name="active" eval="False" />
      <field name="doall" eval="False" />
    </record>

    <record id="blood_group_migration_cron" model="ir.cron">
      <field name="name">EMR Blood Group Migration</field>
      <field name="model_id" ref="model_oeh_medical_patient" />
