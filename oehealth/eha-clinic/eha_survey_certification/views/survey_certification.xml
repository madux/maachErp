<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="survey_certification_inherit_form" model="ir.ui.view">
            <field name="name">	survey.survey.inherit</field>
            <field name="model">survey.survey</field>
            <field name="inherit_id" ref="survey.survey_survey_view_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page name="signatory" string="Signatory">
                        <group>
                            <group string="Coordinator">
                                <field name="coordinator_id"/>
                                <field name="coordinator_sign_signature" widget="signature" options="{'size': ['',100]}"/>
                            </group>
                            <group string="Facilitator">
                                <field name="facilitator_id"/>
                                <field name="facilitator_sign_signature" widget="signature" options="{'size': ['',100]}"/>
                            </group>
                            
                        </group>
                        
                    </page>
                </notebook>
            </field>
        </record>

    </data>
</odoo>