<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="covid_19_appointment_booking" inherit_id="eha_website.covid_19_appointment_booking">
            <xpath expr="//select[@id='simplybook_location']" position="replace">
                <select id="simplybook_location" name='location' class="form-control o_website_form_input">
                    <option></option>
                    <t t-foreach="locations" t-as="location" t-if="locations">
                        <option t-att-value="location.id">
                            <t t-esc="location.name" />
                        </option>
                    </t>
                </select>
            </xpath>
            <xpath expr="//div[@class='col-md-3 test-details']/div[last()]" position="after">
                <div class="d-none">
                    <label>Date of Birth</label>
                    <p id="dob">
                        <t t-esc="clientDob"/>
                    </p>
                </div>
                <div class="d-none">
                    <label>First Name</label>
                    <p id="firstname">
                        <t t-esc="clientFirstName"/>
                    </p>
                </div>
                <div class="d-none">
                    <label>Last Name</label>
                    <p id="lastname">
                        <t t-esc="clientLastName"/>
                    </p>
                </div>
                <div class="d-none">
                    <label>Last Name2</label>
                    <p id="lastname2">
                        <t t-esc="clientLastName2"/>
                    </p>
                </div>
                <div class="d-none">
                    <label>Gender</label>
                    <p id="gender">
                        <t t-esc="clientGender"/>
                    </p>
                </div>
                <div class="d-none">
                    <label>Patient Database ID</label>
                    <p id="patientDbId">
                        <t t-esc="patientDatabaseID"/>
                    </p>
                </div>
            </xpath>
            <xpath expr="//form//div[@class='form-group form-field o_website_form_required']" position="after">
                <div class="form-group form-field o_website_form_required">
                    <label class="col-form-label" for="service">Service</label>
                    <select class="form-control o_website_form_input" id="service_id" name="service_id">
                        <option></option>
                    </select>
                </div>
            </xpath>
        </template>

    </data>
</odoo>
