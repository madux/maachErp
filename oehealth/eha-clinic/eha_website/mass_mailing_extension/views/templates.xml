        <!-- eha_website newsletter popup -->
        <template id="s_newsletter_subscribe_popup" name="EHA Website Newsletter Popup">
            <div class="section_newsletter " data-list-id="1">
                <div id="newsletterModal" class="modal fade">
                    <div class="modal-dialog modal-newsletter">
                        <div class="modal-content">
                            <form action="#" method="POST">
                                <div class="modal-header">
                                    <h4>Subscribe to our newsletter</h4>	
                                </div>
                                <div class="modal-body">
                                    <p>Signup for our newsletter to get the latest news, updates and amazing health tips delivered directly in your inbox.</p>
                                    <!--message-->
                                    <div class="alert alert-success hidden" role="status">
                                        <strong>Thanks!</strong> for subscribing to our newsletter
                                    </div>

                                    <div id="section-input" class="">
                                        <div class="form-group">
                                            <input type="text" maxlength="50"  class="form-control subscribe_name" placeholder="Enter your full name"/>
                                        </div>
                                        <div class="form-group text-left">
                                            <input type="text" maxlength="20" class="form-control subscribe_phone" placeholder="Enter your mobile number"/>
                                            <small> MUST be in international format eg. +234803527900 </small>
                                        </div>
                                    
                                        <div class="form-group">
                                            <input type="email" id="modalEmail" class="form-control subscribe_email" placeholder="Enter your email" required="required"/>
                                        </div>
                                        <div class="form-group text-right">
                                            <input type="submit" class="btn btn-primary subscribe_btn" value="Subscribe"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn" data-dismiss="modal">Close</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <p class="form-label">Subscribe to our newsletter to receive tips on how to live a happier and healthier life.</p>

                <div class="newsletter">
                    <form>
                        <input class="form-email" id="formEmail" type="email" placeholder="Your Email"/>
                        <center><button href="#newsletterModal" data-toggle="modal" maxlength="20" class="btn-primary form-button" type="button">SUBSCRIBE</button></center>
                    </form>
                </div>
            </div>
        </template>

    </data>
</odoo>