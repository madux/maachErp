<odoo>
    <data noupdate="1">
        <record id="eha_website_mailing_list_cron" model="ir.cron">
            <field name="name">Sync Patient and Direct Care Mailing List</field>
            <field name="active" eval="False" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">0</field>
            <field name="model_id" ref="model_mailing_contact" />
            <field name="state">code</field>
            <field name="code">model.cron_patient_dc_mailing_list()</field>
        </record>
    </data>
</odoo>