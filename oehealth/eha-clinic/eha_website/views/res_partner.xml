<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="view_partner_form_extended1" model="ir.ui.view">
            <field name="name">base.contact.form.extended</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[last()]" position="after">
                    <page name="others" string="Partnership Details">
                        <group>
                            <group>
                                <field name="default_code" placeholder="eg. VFS" string="Internal Reference"/>
                                <field name="short_description" placeholder="Short description of the partnership" />
                                <field name="long_description" placeholder="Long Description"  colspan="4" />
                                <field name="coupon_code" placeholder="Coupon Code" />
                                <field name="extra_info" string="Extra Information" placeholder="Extra Information about the partnership"/>
                                <field name="is_invoicing_required"/>
                            </group>
                            <group>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>