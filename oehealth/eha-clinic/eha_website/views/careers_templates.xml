
<!DOCTYPE html>
<odoo>
    <data>
        <template id="website_hr_recruitment.index" name="Jobs">
          <t name="Jobs" t-name="website_hr_recruitment.index">
            <t t-call="website.layout">
                <div id="wrap">
                    <div class="oe_structure">
                        <section class="s_cover parallax page" data-scroll-background-ratio="0" style="background-image: none;">
                            <span class="s_parallax_bg oe_img_bg oe_custom_bg" style="background-image: url(&quot;/eha_website/static/src/img/bg-careers.jpg&quot;); background-position: 48.83% 30.35%;"/>
                            <div class="container">
                                <div class="row s_nb_column_fixed">
                                    <div class="col-lg-12 s_title pt48 pb0" data-name="Title">
                                        <h1 class="title-banner">
                                            <span>Your Career with </span>
                                            <br />
                                            <span class="text-highlight">EHA Clinics.</span>
                                        </h1>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                    <div class="container mt-5">
                        <div class="row">
                            <div class="col-md-6">
                                <p class="text-lg">Our clinics are staffed by a <b>dedicated team</b> of highly-qualified and experienced healthcare professionals providing healthcare services that are at par with global health standards.</p>
                            </div>
                            <div class="col-md-6">
                                <p class="text-lg">We aim to <b>bridge the gap</b> between patients and healthcare services in any setting: the clinic, the home or through innovative online and mobile solutions.</p>
                            </div>
                        </div>
                    </div>

                    <div class="container oe_website_jobs mt-5">
                        <h2>Our Job Offers</h2>
                        <div class="row mt-4">
                            <div class="d-none" id="jobs_grid_left">

                            </div>
                            <div class="col-lg-12" id="jobs_grid">
                                <div t-if="not jobs">
                                    <div class="text-center text-muted">
                                        <h3 class="css_editable_hidden"><a t-attf-href="/contactus">Contact us</a> for job opportunities.</h3>
                                        <h4 groups="hr_recruitment.group_hr_recruitment_manager">
                                            Create new job pages from the <strong><i>+New</i></strong> top-right button.
                                        </h4>
                                    </div>
                                </div>
                                <ul class="list-unstyled" t-if="jobs">
                                    <li t-foreach="jobs" t-as="job" t-attf-class="media#{' mt-3' if job_index else ''}">
                                        <div class="media-body" t-att-data-publish="job.website_published and 'on' or 'off'">
                                            <h3>
                                                <a t-attf-href="/jobs/detail/#{ slug(job) }">
                                                    <span t-field="job.name"/>
                                                </a>
                                                <small t-if="job.no_of_recruitment &gt; 1">
                                                    <t t-esc="job.no_of_recruitment"/> open positions
                                                </small>
                                            </h3>

                                            <span t-field="job.address_id" t-options="{                                         &quot;widget&quot;: &quot;contact&quot;,                                         &quot;fields&quot;: [&quot;address&quot;],                                         &quot;no_tag_br&quot;: True                                         }"/>
                                            <span t-if="not job.website_published" class="badge badge-danger">unpublished</span>
                                            <div class="text-muted">
                                                <i class="fa fa-clock-o" title="Publication date" role="img" aria-label="Publication date"/> <span t-field="job.write_date"/>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
          </t>
        </template>

        <template name="Job Detail" t-name="website_hr_recruitment.detail">
          <t t-call="website.layout">
              <t t-set="additional_title">Job Detail</t>
              <div id="wrap" class="js_hr_recruitment">
                  <div class="oe_structure" id="oe_structure_website_hr_recruitment_detail_1"/>
                  <section class="s_cover parallax page banner-small" data-scroll-background-ratio="0" style="background-image: none;">
                      <span class="s_parallax_bg oe_img_bg oe_custom_bg" style="background-image: url(&quot;/eha_website/static/src/img/bg-get-care.jpg&quot;); background-position: 48.83% 30.35%;"/>
                      <div class="container">
                          <div class="row s_nb_column_fixed">
                              <div class="col-lg-8 offset-lg-2 s_title pt-3 pb-3" data-name="Title">
                                  <h1 class="title-banner text-white" t-field="job.name"/>
                                  <h4 t-field="job.address_id" t-options="{                         &quot;widget&quot;: &quot;contact&quot;,                         &quot;fields&quot;: [&quot;city&quot;],                         &quot;no_tag_br&quot;: True                     }"/>
                                  <a role="button" t-attf-href="/jobs/apply/#{job.id}" class="btn btn-primary mt-3">APPLY NOW</a>
                              </div>
                          </div>
                      </div>
                  </section>
                  <section>
                    <div class="container">
                        <div class="row">
                            <ul class="breadcrumb col-lg-8 offset-lg-2">
                                <li class="breadcrumb-item">
                                    <a href="/jobs" class="uppercase">// Jobs</a>
                                </li>
                                <li class="breadcrumb-item"><span t-field="job.name"/></li>
                            </ul>
                        </div>
                    </div>
                  </section>
                  <section>
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-8 offset-lg-2">
                              <div t-field="job.website_description">
                              </div>
                            </div>
                        </div>
                    </div>
                  </section>
                  
                  <div class="oe_structure">
                      <section class="o_job_bottom_bar mt32 mb32">
                          <div class="text-center">
                              <a role="button" t-attf-href="/jobs/apply/#{job.id}" class="btn btn-primary btn-lg">Apply Now!</a>
                          </div>
                      </section>
                  </div>
              </div>
          </t>
      </template>


      <template t-name="website_hr_recruitment.apply">
          <t t-call="website.layout">
              <t t-set="additional_title">Apply Job</t>

              <div id="wrap">

                <section class="s_cover parallax page banner-small" data-scroll-background-ratio="0" style="background-image: none;">
                      <span class="s_parallax_bg oe_img_bg oe_custom_bg" style="background-image: url(&quot;/eha_website/static/src/img/bg-get-care.jpg&quot;); background-position: 48.83% 30.35%;"/>
                      <div class="container">
                          <div class="row s_nb_column_fixed">
                              <div class="col-lg-8 offset-lg-2 s_title pt-3 pb-3" data-name="Title">
                                  <h1 class="title-banner text-center mt-2">
                                      Job Application Form
                                  </h1>
                                  <h2 t-if="job" class="text-white text-center">
                                      <span t-field="job.name"/>
                                  </h2>
                              </div>
                          </div>
                      </div>
                  </section>

                  <div class="container">
                    <div class="row mt-3">
                        <section id="forms" class="col">
                            <span class="hidden" data-for="hr_recruitment_form2" t-att-data-values="{'department_id': job and job.department_id.id or '', 'job_id': job and job.id or ''}"/>
                            <!-- <form id="hr_recruitment_form" action="/website_form/" method="post" class="s_website_form" enctype="multipart/form-data" data-model_name="hr.applicant" data-success_page="/job-thank-you" hide-change-model="true"> -->
                            <!-- <form id="hr_recruitment_form2" class="s_website_form" enctype="multipart/form-data" data-model_name="hr.applicant" data-success_page="/job-thank-you" hide-change-model="true"> -->
                            <form id="hr_recruitment_form2" data-force_action="/complete/recruitment/" enctype="multipart/form-data" action="/complete/recruitment/" method="post" class="o_mark_required" data-mark="*" data-pre-fill="true" data-model_name=""> 
                                <input type="hidden" name="job_id" t-att-data-id="job.id" t-att-value="job.id"/>
                                <input type="hidden" name="department_id" t-att-data-id="job.department_id.id" t-att-value="job.department_id.id"/>
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="form-group row form-field o_website_form_required_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <label class="col-form-label" for="partner_name">First Name</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="text" class="form-control o_website_form_input" name="partner_name" id="partner_name" required="1"/>
                                    </div>
                                </div>
                                <div class="form-group row form-field o_website_form_required_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <label for="middle_name">Middle Name</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="text" class="form-control o_website_form_input" name="middle_name" id="middle_name"/>
                                    </div>
                                </div>
                                <div class="form-group row form-field o_website_form_required_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <label class="col-form-label" for="last_name">Last Name</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="text" class="form-control o_website_form_input" name="last_name" id="last_name" required="1"/>
                                    </div>
                                </div>
                                 
                                <div class="form-group row form-field o_website_form_required_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <label class="col-form-label" for="email_from">Email</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="email" class="form-control o_website_form_input" name="email_from" id="email_from" required="1"/>
                                    </div>
                                </div>
                                <div class="form-group row form-field o_website_form_required_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <label class="col-form-label" for="partner_phone">Phone Number</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="text" class="form-control o_website_form_input" name="partner_phone" id="partner_phone" required="1"/>
                                    </div>
                                </div>
                                <div class="form-group row form-field">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <label class="col-form-label" for="description">Short Introduction *</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <textarea class="form-control o_website_form_input" name="description" id="description" required="1"/>
                                    </div>
                                </div>
                                <div class="form-group row form-field o_website_form_custom">
                                  <div class="col-lg-3 col-md-4 text-right">
                                    <label class="col-form-label" for="Resume">Resume (*pdf)</label>
                                  </div>
                                  <div class="col-lg-7 col-md-8">
                                    <input type="file" class="form-control o_website_form_input" name="Resume" id="Resume" required="1" accept="application/pdf"/>
                                  </div>
                                </div>

                                <div class="form-group row form-field o_website_form_custom">
                                  <div class="col-lg-3 col-md-4 text-right">
                                    <label class="col-form-label" for="other_docs">Other Required Documents (e.g NYSC, Cover Letter, etc.)</label>
                                  </div>
                                  <div class="col-lg-7 col-md-8">
                                    <input type="file" class="form-control o_website_form_input" name="other_docs" id="other_docs" multiple="1"/>
                                  </div>
                                </div>

                                <div class="form-group row form-field o_website_form_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <h5 id="completed_nysc_heading" class="completed_nysc_heading">Have you completed your compulsory NYSC ?</h5>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <label>
                                            <input type="radio" t-att-value="completed_nysc_yes" class="o_website_form_input checkboxcls" id="completed_nysc_yes" name="completed_nysc_yes" value="Option 1"/>
                                            <span>
                                                Yes
                                            </span>
                                        </label>
                                        <label>
                                            <input type="radio" t-att-value="completed_nysc_no" class="o_website_form_input checkboxcls" id="completed_nysc_no" name="completed_nysc_no" value="Option 2" checked="true"/>
                                            <span>
                                            No
                                            </span>
                                        </label>
                                    </div>
                                </div>

                                <div class="form-group row form-field o_website_form_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <h5 id="capacity_headings" class="capacity_headings">Do you know anyone at EHA Clinics in a personal capacity (eg family and friends), Please provide details:</h5>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <label>
                                            <input type="radio" t-att-value="personal_capacity_headings_yes" class="o_website_form_input checkboxcls" id="personal_capacity_headings_yes" name="personal_capacity_headings_yes" value="Option 1"/>
                                            <span>
                                                Yes 
                                            </span>
                                        </label>
                                        <label>
                                            <input type="radio" t-att-value="personal_capacity_headings_no" class="o_website_form_input checkboxcls" id="personal_capacity_headings_no" name="personal_capacity_headings_no" value="Option 2" checked="true"/>
                                            <span>
                                            No
                                            </span>
                                        </label>
                                    </div> 
                                </div>

                                <div class="form-group row form-field o_website_form_custom d-none" id="specify_personal_personality_div_form">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <h5 id="specify_personal_personality_label">Specify personality:</h5>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <textarea class="form-control o_website_form_input" name="specify_personal_personality" placeholder="Specify "/>
                                    </div>
                                </div>

                                <div class="form-group row form-field o_website_form_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <h5 id="level_qualification_header" class="level_qualification_header">Do you have a degree level qualification in a relevant field or equivalent experience?</h5>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <label>
                                            <input type="radio" t-att-value="level_qualification_header_yes" class="o_website_form_input checkboxcls" id="level_qualification_header_yes" name="level_qualification_header_yes" value="Option 1"/>
                                            <span>
                                                Yes
                                            </span>
                                        </label>
                                        <label>
                                            <input type="radio" t-att-value="level_qualification_header_no" class="o_website_form_input checkboxcls" id="level_qualification_header_no" name="level_qualification_header_no" value="Option 2" checked="true"/>
                                            <span>
                                            No
                                            </span>
                                        </label>
                                    </div>
                                </div>
                                <div class="form-group row form-field o_website_form_custom" id="level_qualification_header_div_form">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <h5 id="specify_qualification" class="specifylevel_qualification_header">Specify qualification:</h5>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="number" step="1" class="form-control o_website_form_input" id="specifylevel_qualification" name="specifylevel_qualification" placeholder="Total years of experience:"/>
                                        <!-- <textarea class="form-control o_website_form_input" name="specifylevel_qualification" required="" placeholder="Total years of experience:"/> -->
                                    </div>
                                </div>


                                <div class="form-group row form-field o_website_form_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <h5 id="reside_job_location_header" class="level_qualification_header">Do you reside within the Job location: </h5>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <label>
                                            <input type="radio" t-att-value="reside_job_location_yes" class="o_website_form_input checkboxcls" id="reside_job_location_yes" name="reside_job_location_yes" value="Option 1" checked="true"/>
                                            <span>
                                                Yes
                                            </span>
                                        </label>
                                        <label>
                                            <input type="radio" t-att-value="reside_job_location_no" class="o_website_form_input checkboxcls" id="reside_job_location_no" name="reside_job_location_no" value="Option 2"/>
                                            <span>
                                            No
                                            </span>
                                        </label>
                                    </div>
                                </div>

                                <div class="form-group row form-field o_website_form_custom d-none" id="relocation_plans_header_div_form">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <h5 id="relocation_plans_header" class="relocation_plans_header">If “No”, do you have relocation plans?: </h5>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <label>
                                            <input type="radio" t-att-value="relocation_plans_yes" class="o_website_form_input checkboxcls" id="relocation_plans_yes" name="relocation_plans_yes" value="Option 1" checked="true"/>
                                            <span>
                                                Yes
                                            </span>
                                        </label>
                                        <label>
                                            <input type="radio" t-att-value="relocation_plans_no" class="o_website_form_input checkboxcls" id="relocation_plans_no" name="relocation_plans_no" value="Option 2"/>
                                            <span>
                                                No
                                            </span>
                                        </label>
                                    </div>
                                </div>

                                <div class="form-group row form-field o_website_form_required_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <label for="current_salary">Current Salary (Monthly Net Pay)</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="number" step="10000" class="form-control o_website_form_input" name="current_salary" id="current_salary" placeholder="e.g 100,000"/>
                                    </div>
                                </div>

                                <div class="form-group row form-field o_website_form_required_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <label for="salary_expection">Salary Expectation (Monthly Net Pay):</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="number" step="10000" class="form-control o_website_form_input" name="salary_expection" id="salary_expection" placeholder="e.g 200,000"/>
                                    </div>
                                </div>

                                <div class="form-group row form-field o_website_form_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <h5 id="resumption_period_header" class="resumption_period_header">If successful, how soon will you be able to resume?:</h5>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        
                                          <select name="periodselect" id="periodselect" data-init="1" class="form-control">
                                              <option disabled="true" selected="true" value="">Select Period</option>
                                              <option value="1 to 2 Weeks">1 to 2 Weeks</option>
                                              <option value="1 month">1 month</option>
                                              <option value="2 months or more">2 months or more</option>
                                          </select>
                                          <p class="help-block text-danger"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <h3 class="col-form-label">Job reference</h3>
                                </div>
                                <div class="form-group row form-field o_website_form_required_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <label for="reference_name">Name</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="text" class="form-control o_website_form_input" name="reference_name" id="reference_name" />
                                    </div>
                                </div>
                                <div class="form-group row form-field o_website_form_required_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <label for="reference_title">Title</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="text" class="form-control o_website_form_input" name="reference_title" id="reference_title"/>
                                    </div>
                                </div>
                                <div class="form-group row form-field o_website_form_required_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <label for="reference_email">Email</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="text" class="form-control o_website_form_input" name="reference_email" id="reference_email"/>
                                    </div>
                                </div>

                                <div class="form-group row form-field o_website_form_required_custom">
                                    <div class="col-lg-3 col-md-4 text-right">
                                        <label for="reference_phone">Phone</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="text" class="form-control o_website_form_input" name="reference_phone" id="reference_phone"/>
                                    </div>
                                </div>

                                <div class="form-group row form-field d-none">
                                    <div class="col-lg-3 col-md-4">
                                        <label class="col-form-label" for="job_id">Job</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="hidden" class="form-control o_website_form_input" name="job_id"/>
                                    </div>
                                </div>
                                <div class="form-group row form-field d-none">
                                    <div class="col-lg-3 col-md-4">
                                        <label class="col-form-label" for="department_id">Department</label>
                                    </div>
                                    <div class="col-lg-7 col-md-8">
                                        <input type="hidden" class="form-control o_website_form_input" name="department_id"/>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="offset-lg-3 offset-md-4 col-md-8 col-lg-7">
                                        <button type="submit" id="submit_recruitment_form" class="btn btn-primary o_website_form_send">Submit</button>
                                        <span id="o_website_form_result"/>
                                    </div>
                                </div>
                            </form>
                        </section>
                    </div>
                  </div>
              </div>
          </t>
      </template>






    </data>
</odoo>