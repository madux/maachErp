<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="product_template_extension" model="ir.ui.view">
            <field name="name">product.template.form.extension</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//label[@for='list_price']" position="before">
                    <field name="categ_name" invisible="1"/>
                    <field name="sequence" invisible="0"/>
                </xpath>
                <xpath expr="//field[@name='list_price']" position="replace">
                    <field name="list_price"
                           attrs="{'invisible': [('categ_name', '=', 'Direct Care Membership')]}"/>  <!--For Non Direct Care Membership-->
                    <field name="list_price" string="Monthly Price"
                           attrs="{'invisible': [('categ_name', '!=', 'Direct Care Membership')]}"/>  <!--Direct Care Membership-->
                    <field name="yearly_price" string="Yearly Price"
                           attrs="{'invisible': [('categ_name', '!=', 'Direct Care Membership')]}"/>
                </xpath>
                <xpath expr="//page[@name='general_information']" position="after">
                    <page name="Features" string="Product Features"
                          attrs="{'invisible': [('categ_name', '!=', 'Direct Care Membership')]}">
                        <field name="product_feature_ids" widget="many2many"
                               context="{'default_product_id' : active_id}">
                            <tree>
                                <field name="name"/>
                                <field name="category"/>
                            </tree>
                            <form>
                                <group>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="description"/>
                                </group>
                            </form>
                        </field>
                        <p class="oe_grey">
                            <strong>Warning</strong>:
                        </p>
                    </page>
                </xpath>

                <field name="type" position="before">
                    <field name="plan_id" attrs="{'invisible': [('categ_name', '!=', 'Direct Care Membership')]}"/>
                </field>
            </field>
        </record>

    </data>
</odoo>