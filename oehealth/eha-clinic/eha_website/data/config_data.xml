<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="eha_website.model_res_partner" model="ir.model">
        <field name="website_form_access">True</field>
        <field name="website_form_label">Membership SignUp </field>
    </record>
    <function model="ir.model.fields" name="formbuilder_whitelist">
        <value>res.partner</value>
        <value eval="[
           'name',
           'email',
           'phone',
           'mobile',
           'street'
         ]"/>
    </function>

    <record id="otp_secret_key1" model="ir.config_parameter">
        <field name="key">eha_website.otp_secret_key1</field>
        <field name="value">base32ehaotp5432</field>
    </record> 
</odoo>