            <field name="website_id" ref="website.default_website" />
        </record>

        <record id="submenu_appointment" model="website.menu">
            <field name="name">Book Appointment</field>
            <field name="url">/appointment/abuja-asbadantata</field>
            <field name="sequence" type="int">105</field>
            <field name="website_id" ref="website.default_website" />
        </record>

        <record id="submenu_send_us_message" model="website.menu">
            <field name="name">Send Us A Message</field>
            <field name="url">/contact-us/</field>
            <field name="sequence" type="int">106</field>
            <field name="website_id" ref="website.default_website" />
        </record>

        <record id="submenu-covid-19-testing" model="website.menu">
            <field name="name">COVID-19 Testing</field>
            <field name="url">/services/covid-19-testing</field>
            <field name="sequence" type="int">107</field>
            <field name="website_id" ref="website.default_website" />
        </record>

        <!-- menus-->
        <record id="menu_donate" model="website.menu">
            <field name="name">DONATE</field>
            <field name="url">/emergency-fund</field>
            <field name="website_id" ref="website.default_website" />
            <field name="parent_id" eval="1"/>
            <field name="sequence" type="int">13</field>
        </record> 

        <record id="submenu-isolation-center" model="website.menu">
            <field name="name">COVID-19 Treatment Center</field>
            <field name="url">/services/treatment-center</field>
            <field name="sequence" type="int">108</field>
            <field name="website_id" ref="website.default_website" />
        </record>
        <record id="submenu_faq" model="website.menu">
            <field name="name">FAQ</field>
            <field name="url">/faq/about-covid-19</field>
            <field name="sequence" type="int">110</field>
            <field name="website_id" ref="website.default_website" />
        </record>
        <record id="submenu_test_result" model="website.menu">
            <field name="name">Check Test Result</field>
            <field name="website_id" ref="website.default_website" />
            <field name="url">/services/check-test-results</field>
            <field name="sequence" type="int">109</field>
        </record>

        
        <!-- ABOUT US -->
        <record id="menu_aboutus" model="website.menu">
            <field name="name">ABOUT US</field>
            <field name="url">/about-us</field>
            <field name="parent_id" eval="1"/>
            <field name="website_id" ref="website.default_website" />
            <field name="sequence" type="int">0</field>
            <field name="child_id" eval="[
                (4,ref('eha_website.submenu-about-eha-clinics')),
                (4,ref('eha_website.submenu-leadership-team')),
                 (4,ref('eha_website.submenu-careers'))]"/>
        </record>

        <!-- SERVICES -->
        <record id="menu_services" model="website.menu">
            <field name="name">OUR SERVICES</field>
            <field name="parent_id" eval="1"/>
            <field name="website_id" ref="website.default_website" />
            <field name="sequence" type="int">3</field>
            <field name="child_id" eval="[
                (4,ref('eha_website.submenu_medical_services')),
                (4,ref('eha_website.submenu_pharmacy')),
                 (4,ref('eha_website.submenu_lab_and_diagnostics')),
                 (4,ref('eha_website.submenu_community_health')),]"/>
        </record>

        <!-- MEMBERSHIP PLANS -->
        <record id="menu_membership" model="website.menu">
            <field name="name">MEMBERSHIP PLANS</field>
            <field name="website_id" ref="website.default_website" />
            <field name="parent_id" eval="1"/>
            <field name="sequence" type="int">11</field>
            <field name="child_id" eval="[
                (4,ref('eha_website.submenu_premium_plan')),
                (4,ref('eha_website.submenu_standard_plan')),
                 (4,ref('eha_website.submenu_international_plan'))]"/>
        </record>

        <!-- CONTACT US -->
        <record id="menu_contactus" model="website.menu">
            <field name="name">CONTACT US </field>
            <field name="parent_id" eval="1"/>
            <field name="website_id" ref="website.default_website" />
            <field name="sequence" type="int">12</field>
            <field name="child_id" eval="[(4, ref('eha_website.submenu_appointment')),
            (4, ref('eha_website.submenu_send_us_message'))]"/>
        </record>

        <!-- COVID 19 -->
        <record id="menu_covid-19" model="website.menu">
            <field name="name">COVID-19</field>
            <field name="website_id" ref="website.default_website" />
            <field name="parent_id" eval="1"/>
            <!-- <field name="parent_id" ref="website.main_menu" /> -->
            <field name="sequence" type="int">14</field>
            <field name="child_id" eval="[
                (4,ref('eha_website.submenu-covid-19-testing')),
                (4,ref('eha_website.submenu-isolation-center')),
                (4,ref('eha_website.submenu_test_result')),
                (4,ref('eha_website.submenu_faq')),]"/>
        </record>
        
        <record id="menu_get_care" model="website.menu">
            <field name="name">GET CARE</field>
            <field name="url">/shop/prescription_booking</field>
            <field name="website_id" ref="website.default_website" />
            <field name="parent_id" eval="1"/>
            <field name="sequence" type="int">13</field>
        </record> 

