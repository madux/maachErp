<odoo>
    <data>

       <record id="submenu-about-eha-clinics" model="website.menu">
            <field name="name">About EHA Clinics</field>
            <field name="url">/about-eha-clinics</field>
            <field name="sequence" type="int">101</field>
            <field name="website_id" ref="website.default_website" />
        </record>

        <record id="submenu-leadership-team" model="website.menu">
            <field name="name">Our Leadership Team</field>
            <field name="url">/our-leadership-team</field>
            <field name="sequence" type="int">102</field>
            <field name="website_id" ref="website.default_website" />
        </record>
        <record id="submenu-careers" model="website.menu">
            <field name="name">Careers</field>
            <field name="url">/jobs</field>
            <field name="sequence" type="int">103</field>
            <field name="website_id" ref="website.default_website" />
        </record>
        
        <record id="submenu_medical_services" model="website.menu">
            <field name="name">Medical Services</field>
            <field name="url">/services/medical-services</field>
            <field name="sequence" type="int">104</field>
            <field name="website_id" ref="website.default_website" />
        </record>

        <record id="submenu_pharmacy" model="website.menu">
            <field name="name">Pharmacy</field>
            <field name="url">/services/pharmacy</field>
            <field name="sequence" type="int">105</field>
            <field name="website_id" ref="website.default_website" />
        </record>
        <record id="submenu_lab_and_diagnostics" model="website.menu">
            <field name="name">Lab and Diagnostics</field>
            <field name="url">/services/lab</field>
            <field name="sequence" type="int">106</field>
            <field name="website_id" ref="website.default_website" />
        </record>
        <record id="submenu_community_health" model="website.menu">
            <field name="name">Community Health Program</field>
            <field name="url">/community-health</field>
            <field name="sequence" type="int">107</field>
            <field name="website_id" ref="website.default_website" />
        </record>

        <record id="submenu_standard_plan" model="website.menu">
            <field name="name">Standard Plan</field>
            <field name="url">/shop/membership#standard-plan</field>
            <field name="sequence" type="int">107</field>
            <field name="website_id" ref="website.default_website" />
        </record>
        <record id="submenu_premium_plan" model="website.menu">
            <field name="name">Premium Plan</field>
            <field name="url">/shop/membership#premium-plan</field>
            <field name="sequence" type="int">108</field>
            <field name="website_id" ref="website.default_website" />
        </record>
        <record id="submenu_international_plan" model="website.menu">
            <field name="name">International Plan</field>
            <field name="url">/shop/membership#premium-internation-plan</field>
