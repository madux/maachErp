<odoo>
    <data>
        <template id="buytest-step2" name="Preferred Appointment Type">
            <t t-name="website.buytest-step2">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty"/>
                    <t t-call="eha_website.covid19-preloader"/>
                    <div id="wrapper" class="d-none covid_booking">
                        <div class="section bgLight">
                            <div class="container pt-4 pb-3">
                                <h4 id="product_name_header"></h4>
                            </div>
                        </div>
                        <div class="section bgLight">
                            <div class="container">
                                <div class="tabs">
                                    <a href="/services/buy-covid19-patientsummary" id="step1" class="step-tab pt-4 pb-4 visited">
                                        <div>
                                            <span class="badge badge-primary badge-m mr-2">1</span>
                                            Who is getting tested?
                                        </div>
                                    </a>
                                    <div class="step-tab pt-4 pb-4 active">
                                        <div>
                                            <span class="badge badge-primary badge-m mr-2">2</span>
                                                Sample Collection
                                        </div>
                                    </div>
                                    <div class="step-tab pt-4 pb-4">
                                        <div>
                                            <span class="badge badge-primary badge-m mr-2">3</span>
                                                Purchase
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="section">
                            <div class="container mt-6 mb-5">
                            <div class="alert alert-info mt-16 col-lg-6 col-md-12 col-sm-12" role="alert">
                                <h5>Are you unable to complete your booking?</h5><p>Please contact our Command Center on 0800 EHA CLINICS<br/><b>(Toll Free: 0800 342 254 6427)</b> or Chat with us below.</p>
                            </div>
                                <form name="appointment_form" id="appointment_form" action="/services/buy-covid19-checkout" method="POST">
                                    <h5>Where do you want your samples to be collected?</h5>
                                    <div class="radio-selector mt-3">
                                        <input class="checkbox" value="clinic" name="appointment_type" type="radio"/>
                                        <div class="selector-content">
                                            <label class="mb-2">In Clinic Collection</label>
                                            <p>We collect your samples in a clinic appointment.</p>
                                            <div class="book-appointment mt-5">
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="row row-pcr">
                                                            <div class="form-group col-xl-10 col-12">
                                                                <label class="col-form-label" for="gender">Testing facility</label>
                                                                <select class="form-control o_website_form_input" id="simplybook-location-clinic" name="simplybook_location">
                                                                    <option/>
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div id="preloader-calendar" name="preloader-calendar" class="col-12 d-none">
                                                                <i class="fa fa-spin fa-spinner"/> Checking available slots ...
                                                            </div>
                                                            <div id="select-date" name="date-block" class="form-group col-xl-10 form-field o_website_form_custom">
                                                                <label class="col-form-label" for="Custom Date">Pick a date</label>
                                                                <div class="o_website_form_date input-group date" id="datepicker1div" data-target-input="nearest">
                                                                    <input type="text" t-att-value="datepicker2" class="form-control datetimepicker-input o_website_form_input" id="datepicker" data-target="#datepicker2" name="datepicker" placeholder="Select Date" autocomplete="off"/>
                                                                    <div class="input-group-append" data-target="#datepicker2" data-toggle="datepicker2">
                                                                        <div class="input-group-text">
                                                                            <i class="fa fa-calendar" id="calender-icon-booking" data-original-title="" title="" aria-describedby="tooltip118921"/>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div id="select-time-antigen" name="antigen-time-block" class="form-group col-xl-10 col-12 form-field o_website_form_custom d-none">
                                                                <label id="time_label" class="col-form-label" for="Custom Date">Time of flight 


                                                                    <em> (hh:mm (PM only))</em>
                                                                </label>
                                                                <div class="o_website_form_date input-group date" id="timepickerdiv" data-target-input="nearest">
                                                                    <input type="text" t-att-value="timepicker" class="form-control datetimepicker-input o_website_form_input timepicker" placeholder="Select Time" data-target="#timepickerdiv" id="clinic-timepicker"/>
                                                                    <!-- <div class="input-group-append" data-target="#timepicker" data-toggle="timepicker"><div class="input-group-text"><i class="fa fa-calendar" id="calender-icon-booking" data-original-title="" title="" aria-describedby="tooltip118921"/></div></div> -->
                                                                </div>
                                                            </div>
                                                            <div class="col-12">
                                                                <div id="select-time" name="time-block" class="form-group form-field d-none">
                                                                    <label class="col-form-label" id="showtimelabel" for="time" name="timelabel">Pick a time</label>
                                                                    <div class="mt-3 mb-5" id="times" name="times">
                                                                        <!--dynamic time buttons-->
                                                                    </div>
                                                                </div>
                                                                <label class="col-form-label asteriskField d-none" name="not_avilable">*All Slots Busy for the selected Date: Choose Another date</label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                     
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="radio-selector mt-3">
                                        <input class="checkbox" value="home" name="appointment_type" type="radio"/>
                                        <div class="selector-content">
                                            <label class="mb-2">Home Sample Collection, ₦<t t-esc="home_price"/> (₦20,000 for members)<br/> Note that price is per (1 to 10) beneficiaries</label>
                                            <p>We come and collect your samples from one household. Only available for Abuja and Kano.</p>
                                            <div class="book-appointment mt-5">
                                                <h5>Pick up location</h5>
                                                <div class="row">
                                                    <div class="form-group col-md-4">
                                                        <label class="col-form-label" for="gender">State</label>
                                                        <select id="simplybook-location-home" name="simplybook_location" class="form-control">
                                                            <option></option>
                                                        </select>
                                                    </div>
                                                    <div class="form-group col-md-4" id="lga-section">
                                                        <label class="col-form-label" for="street">LGA</label>
                                                        <input type="text" name="lga" maxlength="75" placeholder="Your LGA" class="form-control" />
                                                    </div>
                                                </div>
                                                <div class="row" id="more-info-section">
                                                    <div class="form-group col-md-4">
                                                        <label class="col-form-label" for="street">Street</label>
                                                        <input type="text" name="street" maxlength="75" placeholder="Your street" class="form-control" />
                                                    </div>
                                                    <div class="form-group col-md-4">
                                                        <label class="col-form-label" for="phone">Phone Number</label>
                                                        <input type="text" name="phone" maxlength="75" placeholder="Your Phone Number" class="form-control" />
                                                    </div>
                                                    <div class="form-group col-md-4">
                                                        <label class="col-form-label" for="phone">Whatsapp Number<small>(optional)</small></label>
                                                        <input type="text" name="whatsapp-phone" maxlength="75" placeholder="Your Whatsapp Number" class="form-control" />
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div name="preloader-calendar" class="col-12 d-none"><i class="fa fa-spin fa-spinner"></i> Checking available slots ...</div>
                                                    <div name="date-block" class="form-group col-md-4 form-field o_website_form_custom">
                                                        <label class="col-form-label" for="Custom Date">Pick a date</label>
                                                        <div class="o_website_form_date input-group date" id="datepicker3div" data-target-input="nearest">
                                                            <input type="text" t-att-value="datepicker3" class="form-control datetimepicker-input o_website_form_input" id="datepicker3" data-target="#datepicker3" name="datepicker" placeholder="Select Date" autocomplete="off"/>
                                                            <div class="input-group-append" data-target="#datepicker3" data-toggle="datepicker3">
                                                                <div class="input-group-text">
                                                                    <i class="fa fa-calendar" id="calender-icon-booking" data-original-title="" title="" aria-describedby="tooltip118921"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div id="select-time-antigen-home" name="antigen-time-block" class="form-group col-md-4 form-field o_website_form_custom d-none">
                                                        <label id="time_label" class="col-form-label" for="Custom Date">Time of flight <em> (hh:mm (PM only))</em></label>
                                                        <div class="o_website_form_date input-group date" id="timepickerdiv" data-target-input="nearest">
                                                            <input type="text" t-att-value="timepicker" class="form-control datetimepicker-input o_website_form_input timepicker" placeholder="Select Time" data-target="#timepickerdiv" id="home-timepicker" autocomplete="off" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div id="time-block" name="time-block" class="form-group form-field d-none">
                                                    <label class="col-form-label" id="showtimelabel2" for="time" name="timelabel">Pick a time</label>
                                                    <div class="mt-3 mb-5" name="times">
                                                        <!--dynamic time buttons-->
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row actions mt-5 pt-4 border-top-blue">
                                        <div class="col-8">
                                            <div href="#confirmCancelModal" class="btn btn-outline-primary mr-3 mb-2" data-toggle="modal">Cancel Purchase</div>
                                            <a href="/services/buy-covid19-patientsummary">
                                                <div name="back" class="btn btn-outline-primary mb-2">Back</div>
                                            </a>
                                        </div>
                                        <div class="col-4 text-right">
                                            <button type="submit" class="btn btn-preloader btn-primary mb-2">Continue</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div id="confirmCancelModal" class="modal fade">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-body">
                                        <h4>You Really Want to <span><b>Cancel</b></span> your Purchase?</h4>
                                        <div class="row actions mt-4 pt-4 border-top-blue">
                                            <div class="col-6">
                                                <div id="no" data-dismiss="modal" class="btn btn-outline-primary">NO</div>
                                            </div>
                                            <div class="col-6 text-right">
                                                <div id="yes" class="btn btn-primary">YES</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
