<odoo>
    <data>
     <template name="Buy COVID-19 Test" id="buytest-overview">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty"/>
            <t t-call="eha_website.covid19-preloader"/>
            <div id="wrapper" class="d-none">
                <div class="section">
                    <div class="container mt-6 mb-6">
                        <div class="row flex-md-row-reverse">
                            <div class="col-md-6 mb-6 test-form">
                                <h3>COVID19-Test</h3>
                                <label class="mt-4 mb-3">What type of test do you need?</label>
                                <div class="test-selector">
                                    <div class="row p-3">
                                        <div class="col-md-12 checkbox">
                                            <input class="checkbox" name="test-type" id="testtype_option_id" type="radio" checked="checked" />
                                            <label class="col-form-label" for="diagnostic-tests">
                                                <b>PCR Test</b><br />
                                                <i class="small">A Gold Standard molecular diagnostic test used to confirm an active Coronavirus infection. Conducted using a nasopharyngeal sample collected by swab</i>
                                            </label>
                                        </div>
                                        <div class="col-md-12 checkbox" id="checkbox_antigen_id">
                                            <input class="checkbox" name="test-type" id="testtype_antigen_option_id" type="radio"/>
                                            <label class="col-form-label" for="diagnostic-tests">
                                                <b>Antigen Test</b><br />
                                                <i class="small">A rapid diagnostic test with less accuracy than the PCR test used for screening for an active Coronavirus infection. 
                                                Positive results should be followed up by PCR. Conducted using a nasopharyngeal sample collected by swab.</i>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="checkbox p-3 border-top-blue" id="checkbox_antibody_id">
                                        <input class="checkbox" name="is_anti_body" id="is_anti_body" type="checkbox"/>
                                        <label class="col-form-label pl-1" for="antibody">
                                            <b>IgM Antibody Test (RDT)</b><br />
                                            <i class="small mt-2">A rapid diagnostic test with very high accuracy used to determine the presence of 
                                            COVID - 19 antibodies indicating previous infection of Coronavirus.</i>
                                        </label>
                                        <!--thirdpart partner id-->
                                        <input type="hidden" name="thirdparty_partner_id" t-att-value="thirdparty_partner_id" />
                                    </div>
                                </div>
                                <label class="mt-4">Do you need the test for International Travel?</label>
                                <div class="checkbox p-3 mb-4">
                                    <input class="checkbox" name="travel" id="is_international_travel" type="checkbox"/>
                                    <label class="col-form-label pl-1" for="travel">
                                        <b>International travel</b><br />
                                        <i class="small mt-2">Check this box if an airline, embassy, public health, or immigration authority needs to know your COVID-19 status.</i>
                                        <p class="small background p-3 mt-2 d-none" id="note_for_antigen">Please note, that Antigen tests not assigned to travels won't be accepted at the airport.</p>
                                    </label>
                                </div>
                                <label id="product_price_id"> - </label>
                                <div class="mt-3 pt-3 dashed-border-top">
                                    <a href="/services/buy-covid19-patientinfo" class="btn btn-primary preloader">BUY NOW</a>
                                </div>
                                <div class="box-rounded row pl-2 mt-5">
                                    <div class="col-sm-3 p-0 text-center">
                                        <img width="100%" style="max-width:160px" src="/eha_website/static/src/img/icon-family.png"/>
                                    </div>
                                    <div class="col-sm-9">
                                        <b>Not a member yet?</b>
                                        <p><i class="mt-2">Get Discounts, unlimited Routine Visits, free or discounted lab services and much more.</i></p>
                                        <a href="/shop/membership" class="btn btn-outline-invert">more about memberships</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="text-center"><img width="40%" src="/eha_website/static/src/img/illu-testing.png"/></div>
                                <div class="appointments mt-4 mb-5 pr-5">
                                    <h5>Sample collection schedule at EHA Clinics</h5>
                                    <p class="small">We have the capacity to test up to 400 people per day. However, early booking is advised to ensure the availability of a testing slot.<br/>
                                    Please be aware that Antigen tests for travels will be booked 4 hrs before your flight.</p>
                                    <h5 class="text-secondary mt-1 pt-1 border-top-grey">Abuja - Asba &amp; Dantata Street</h5>
                                    <div class="row mt-2">
                                        <div class="col-lg-12">
                                            <div class="row">
                                                <div class="col date"><small>PCR</small></div>
                                                <div class="col">                            
                                                    <span class="badge background">9:30am – 11:30am</span>
                                                    <span class="badge background">12:30pm – 2:30pm</span>
                                                </div>
                                            </div>
                                            <div class="row mt-1">
                                                <div class="col date text-highlight"><small>RAPID-PCR</small></div>
                                                <div class="col">
                                                 
                                                <div class="mb-1">
                                                    <span class="badge background">7:30am – 8am</span>
                                                </div>
                                                <div class="mb-1">
                                                    <span class="badge background">11am – 11:30am</span>
                                                </div>
                                                </div>
                                            </div>
                                            <div class="row mt-1">
                                                <div class="col date"><small>ANTIGEN</small></div>
                                                <div class="col">                            
                                                    <span class="badge background">24/7</span>
                                                </div>
                                            </div>
                                            <div class="row mt-1">
                                                <div class="col date"><small>ANTIBODY</small></div>
                                                <div class="col">                            
                                                    <span class="badge background">24/7</span><span class="small ml-2 mr-1"> In combination with PCR: </span><span class="badge background">2 - 3pm</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <h5 class="text-secondary mt-3 pt-1 border-top-grey">Kano - Lamido Crescent</h5>
                                    <div class="row mt-2">
                                        <div class="col-lg-12">
                                            <div class="row">
                                                <div class="col date"><small>PCR</small></div>
                                                <div class="col">                            
                                                    <span class="badge background">10am – 12pm</span>
                                                    <span class="badge background">1pm – 3pm</span>
                                                </div>
                                            </div>
                                            <div class="row mt-1">
                                                <div class="col date text-highlight"><small>RAPID-PCR</small></div>
                                                <div class="col">
                                                 
                                                <div class="mb-1">
                                                    <span class="badge background">7:30am – 8am</span>
                                                </div>
                                                <div class="mb-1">
                                                    <span class="badge background">11am – 11:30am</span>
                                                </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col date"><small>RAPID-PCR</small></div>
                                                <div class="col">                            
                                                    <span class="badge background">7:30am - 8:00am</span>
                                                    <span class="badge background">1pm – 3pm</span>
                                                </div>
                                            </div>
                                            <div class="row mt-1">
                                                <div class="col date"><small>ANTIGEN</small></div>
                                                <div class="col">                            
                                                    <span class="badge background">24/7</span>
                                                </div>
                                            </div>
                                            <div class="row mt-1">
                                                <div class="col date"><small>ANTIBODY</small></div>
                                                <div class="col">                            
                                                    <span class="badge background">24/7</span><span class="small ml-2 mr-1"> In combination with PCR: </span><span class="badge background">2 - 3pm</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <h5 class="text-secondary mt-3 pt-1 border-top-grey">Abuja - Asokoro Test Center</h5>
                                    <div class="row mt-2">
                                        <div class="col-lg-12">
                                            <div class="row">
                                                <div class="col date"><small>PCR</small></div>
                                                <div class="col">                            
                                                    <span class="badge background">9:30am – 4:30pm</span>
                                                </div>
                                            </div>
                                            <div class="row mt-1">
                                                <div class="col date"><small>ANTIGEN</small></div>
                                                <div class="col">                            
                                                    <span class="badge background">9:30am – 4:30pm</span>
                                                </div>
                                            </div>
                                            <div class="row mt-1">
                                                <div class="col date"><small>ANTIBODY</small></div>
                                                <div class="col">                            
                                                    <span class="badge background">9:30am – 4:30pm</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <h5 class="text-secondary mt-3 pt-1 border-top-grey">Home Service in Abuja and Kano City Centers</h5>
                                    
                                    <div class="row mt-2">
                                        <div class="col-lg-12">
                                            <div class="row">
                                                <div class="col date"><small>ALL TESTS</small></div>
                                                <div class="col">                            
                                                    <span class="badge background">10am – 4pm</span>
                                                </div>
                                            </div>
                                            <div class="row mt-1">
                                                <div class="col">  
                                                <i class="small">Please book at least one day ahead.</i>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="small mt-3 pt-2 border-top-grey"><span class="text-highlight"> HOME SERVICE NOW AVAILABLE! </span>Get tested in the safety of your home or any other facility in the city areas of Abuja and Kano.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="section background-50 mt-5 pt-3">
                    <div class="container">
                        <h3 class="text-center mt-6">How does testing work?</h3>
                            <div class="row">
                                <div class="col-md-6 mt-5 mb-5 pl-5">
                                <h5 class="mt-3 mb-3">Before testing</h5>
                                <ol>
                                    <li>Payment must be received before an appointment can be confirmed.</li>
                                    <li>Once payment is confirmed, your appointment will be booked and you will receive a confirmation via email.</li>
                                    <li>If you are experiencing any COVID-19 symptoms, isolate yourself to keep others safe. </li>
                                    <li>Ensure you wear a face mask at all times when at our testing facility.</li>
                                    <li>For COVID-19 tests for the purpose of travel, kindly ensure that your booking is within the testing window of the airline you are travelling with and no later than 48 hours before your proposed travel date to ensure the availability of your results prior to departure. </li>
                                </ol>
                            </div>
                            <div class="col-md-6 mt-5 mb-5 pl-5">
                                <h5 class="mt-3 mb-3">During testing</h5>
                                <ol>
                                    <li>Kindly indicate to the security personnel at the gate that you are here for COVID 19 test.</li>
                                    <li>Kindly follow the instructions given on where to park and how to access your test.</li>
                                    <li>Do not come out of your car. </li>
                                    <li>If you do not come with a car, the security personnel will direct you to the designated waiting area. Please stay seated until it is your turn. </li>
                                    <li>Note that testing will be on a first come first served basis for patients who are booked for the same time slot.</li>
                                </ol>
                                <h5 class="mt-3 mb-3">After testing</h5>
                                <ol>
                                    <li>Your results will be sent via email within 8 hours of testing.</li>
                                    <li>All positive patients will receive a call from the clinic to discuss treatment and next steps.</li>
                                    <li>Stamped results can be obtained at the clinic for those that require one for the purpose of travel. Inform the receptionist at the gate that you would like to have your test stamped. Note that we do not print out results at the clinic. You will need to bring your printed COVID-19 test result with you. </li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
     </template>
    </data>
</odoo>