<odoo>
    <data>
        <template id="patient-modal-form">
            <div id="addperson" class="modal fade">
                <div class="modal-dialog big">
                    <div class="modal-content">
                        <div class="modal-body">
                            <form id="patient_form" action="#" method="post">
                                <span type="button" class="close" data-dismiss="modal">×</span>
                                <h5>Person to be tested</h5>
                                <p>Please fill in the fields for the person that is going to get tested.</p>
                                <small>
                                    <i>All fields are mandatory</i>
                                </small>
                                <input name="sn" type="hidden" />
                                <input name="mode" type="hidden" />
                                <t t-call="eha_website.patient-form" />
                                <div class="row actions mt-5 pt-4 border-top-blue">
                                    <div class="col-6">
                                        <div class="btn btn-outline-primary" data-dismiss="modal">Cancel</div>
                                    </div>
                                    <div class="col-6 text-right">
                                        <button type="submit" class="btn btn-primary">Save</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </template>
        <template id="buytest-step1-summary" name="Capture Persons Form Summary">
            <t t-name="website.buytest-step1-summary">
                <t t-call="website.layout">
                    <link rel="stylesheet" href="/eha_website/static/src/lib/build/css/intlTelInput.min.css" />
                    <script type="text/javascript" src="/eha_website/static/src/js/utils.js?v=1.0.1"></script>
                    <script src="/eha_website/static/src/lib/build/js/intlTelInput.min.js"></script>
                    <!-- <script type="text/javascript" src="/eha_website/static/src/js/covid19/covid19_test_patients.js?v=1.0.4"></script> -->
                    <div id="wrap" class="oe_structure oe_empty"/>
                    <t t-call="eha_website.covid19-preloader"/>
                    <div id="wrapper" class="d-none">
                        <div id="confirmRemoveModal" class="modal fade">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-body">
                                        <h4>Remove
                                            <span id="name_head" class="text-secondary"></span> from Purchase List?
                                        </h4>
                                        <input name="sn" type="hidden" />
                                        <div class="row actions mt-4 pt-4 border-top-blue">
                                            <div class="col-6">
                                                <div data-dismiss="modal" class="btn btn-outline-primary">Cancel</div>
                                            </div>
                                            <div class="col-6 text-right">
                                                <button id="remove" class="btn btn-primary">Remove</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="section bgLight">
                            <div class="container pt-4 pb-3">
                                <h4 id="product_name_header"></h4>
                            </div>
                        </div>
                        <div class="section bgLight">
                            <div class="container">
                                <div class="tabs">
                                    <div class="step-tab pt-4 pb-4 active">
                                        <div>
                                            <span class="badge badge-primary badge-m mr-2">1</span>
                                    Who is getting tested?
                                        </div>
                                    </div>
                                    <div class="step-tab pt-4 pb-4">
                                        <div>
                                            <span class="badge badge-primary badge-m mr-2">2</span>
                                    Sample Collection
                                        </div>
                                    </div>
                                    <div class="step-tab pt-4 pb-4">
                                        <div>
                                            <span class="badge badge-primary badge-m mr-2">3</span>
                                    Purchase
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="section">
                            <div class="container mt-6 mb-5">
                                <div class="purchase-summary">
                                    <div class="summary-header" id="product_summary">
                                        <!--COVID-19 PCR for International Travel + Antibody Test-->
                                    </div>
                                    <table id="main_table" data-delete="true">
                                        <tbody>
                                        <!---
                                        <tr>
                                            <td class="position">1</td>
                                            <td class="item">
                                                <a id="edit_principal" href="#editperson" data-toggle="modal"><t t-esc="parent_name" /></a>
                                            </td>
                                            <td id="amount" class="item-price"></td>
                                        </tr>
                                        -->
                                        </tbody>
                                        <tfoot>
                                            <tr id="total" class="summary-footer">
                                                <td colspan="2">Total</td>
                                                <td id="main_total" class="total-price"></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="section">
                            <div class="container">
                                <p>You can buy multiple tests by adding a person</p>
                                <button id="add_person" data-mode="Add" href="#addperson" data-toggle="modal" maxlength="20" class="btn-primary btn-sm mt-2" type="button">Add Person</button>
                                <div class="row actions mt-6 pt-4 border-top-blue">
                                    <!--cancel purchase modal-->
                                    <t t-call="eha_website.cancel-purchase" />
                                    <div class="col-6">
                                        <!--<div class="btn btn-outline-primary">Cancel Purchase</div>-->
                                        <button href="#confirmCancelModal" data-toggle="modal" class="btn btn-outline-primary">Cancel Purchase</button>
                                    </div>
                                    <div class="col-6 text-right">
                                        <a href="/services/buy-covid19-appointmenttype" class="btn btn-primary preloader">Continue</a>
                                    </div>
                                </div>
                            </div>
                            <t t-call="eha_website.patient-modal-form" />
                        </div>
                        <div class="section">
                            <div class="container mt-6 mb-5"></div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
