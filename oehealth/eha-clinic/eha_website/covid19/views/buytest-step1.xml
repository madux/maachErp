<odoo>
    <data>
        <template id="cancel-purchase">
            <div id="confirmCancelModal" class="modal fade">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-body">
                            <h4>You Really Want to 
                                <span>
                                    <b>Cancel</b>
                                </span> your Purchase?
                            </h4>
                            <div class="row actions mt-4 pt-4 border-top-blue">
                                <div class="col-6">
                                    <div id="no" data-dismiss="modal" class="btn btn-outline-primary">NO</div>
                                </div>
                                <div class="col-6 text-right">
                                    <div id="yes" class="btn btn-primary">YES</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>        <!--cancel purchase modal-->

        <template id="patient-form">

            <div id="MembershipErrorModal" class="modal fade">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-body">
                            <h3 style="color:black">Sorry your membership status couldn't be verified.</h3><br/>
                            <p>To verify an active membership of a person, we check for name and phone number.</p>
                            <p><b>There seems to be no match with the details you provided.</b></p>
                            <p>Please check if you have entered the personal details correctly.<br/>Maybe the person had been registered with a different phone number?</p>
                            <div class="row actions mt-4 pt-4 border-top-blue">
                                <div class="col-8">
                                    <div id="continue" data-dismiss="modal" class="btn btn-outline-primary">CONTINUE WITHOUT MEMBERSHIP</div>
                                </div>
                                <div class="col-4 text-right">
                                    <div id="stay" class="btn btn-primary">EDIT FORM</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <div class="form-group">
                    <label class="col-form-label">Name (Surname, Firstname, Middlename) <span style="color:red">*</span>
                    </label>
                    <input type="text" maxlength="75" required="required" placeholder="Surname Firstname Middlename" name="name" class="form-control" />
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label class="col-form-label" for="gender">
                            Gender <span style="color:red">*</span>
                        </label>
                        <select name="gender" required="required" data-init="1" class="form-control">
                            <option value="">Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label class="col-form-label" for="dob">Date of Birth <span style="color:red">*</span>
                        </label>
                        <div class="o_website_form_date input-group date">
                            <input name="dob" required="required" class="form-control datetimepicker-input o_website_form_input datepicker" data-toggle="datetimepicker" data-target="#customer_dob" autocomplete="off" />
                            <div class="input-group-append" data-target="#customer_dob" data-toggle="datetimepicker">
                                <div class="input-group-text">
                                    <i class="fa fa-calendar" data-original-title="Date of Birth" title="Date of Birth" aria-describedby="tooltip118921"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="checkbox p-3 border-top-blue">
                    <input class="checkbox" name="is-member" type="checkbox"/>
                    <label class="col-form-label pl-1" for="antibody">
                        <b>is EHA Clinics Member</b><br/>
                    </label><br/>
                    <i class="small mt-2">We will verify the membership status by validating the personal details provided in this form.</i>
                </div>
                <div class="checkbox p-3 border-top-blue">
                    <input class="checkbox" id="has_promo_code" name="has-promocode" type="checkbox"/>
                    <label class="col-form-label pl-1" for="antibody">
                        <b>Apply Promo Code</b><br/>
                    </label><br/>
                    <i class="small mt-2">Apply promo code for discounted price</i>
                    <div class="row promo-container d-none">
                        <div class="col-7">
                            <input type="text" name="promo_code" class="form-control"/>
                        </div>
                        <div class="col-3">
                            <span class="btn btn-primary verify_promo_code">Verify</span>
                        </div>
                    </div>
                </div>
                <div class="form-row mt-4 pt-4 border-top-blue">
                    <div class="form-group col-md-6">
                        <label class="col-form-label">Email<span style="color:red">*</span>
                        </label>
                        <input type="email" maxlength="75" required="required" placeholder="Your email" name="email" class="form-control" />
                    </div>
                    <div class="form-group col-md-6">
                        <label class="col-form-label">Phone Number(eg. +2348033333333)<span style="color:red">*</span>
                        </label>
                        <input type="tel" maxlength="75" required="required" placeholder="eg. 8033333333" name="phone" id="phone" class="form-control" />
                    </div>
                </div>
                <h5 class="mt-4">Please provide the adress of where you are currently staying in Nigeria</h5>
                <div class="form-row mt-4">
                    <div class="form-group col-md-6">
                        <label class="col-form-label">
                            Street <span style="color:red">*</span>
                        </label>
                        <input name="street" type="text" maxlength="75" required="required" placeholder="Street in Nigeria" class="form-control" />
                    </div>
                    <div class="form-group col-md-6">
                        <label class="col-form-label">
                            City <span style="color:red">*</span>
                        </label>
                        <input name="city" type="text" maxlength="75" required="required" placeholder="City in Nigeria" class="form-control" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label class="col-form-label">
                            State <span style="color:red">*</span>
                        </label>
                        <select name="state" class="form-control">
                            <option value="">Choose State</option>
                            <t t-foreach="ng_states" t-as="ng_state">
                                <option t-att-value="ng_state.id">
                                    <t t-esc="ng_state.name" />
                                </option>
                            </t>
                        </select>

                    </div>
                    <div class="form-group col-md-6">
                        <label class="col-form-label">
                            LGA <span style="color:red">*</span>
                        </label>
                        <input name="lga" type="text" maxlength="50" required="required" placeholder="Your LGA" class="form-control" />
                        <!--
                        <select name="lga" required="required" class="form-control">
                            <option value="">Choose LGA</option>
                        </select>
                        -->
                    </div>
                </div>
                <div name="travel" class="form-row mt-4 pt-4 border-top-blue">
                    <div class="form-group col-md-6">
                        <label class="col-form-label">
                            Name of Airline <span style="color:red">*</span>
                        </label>
                        <select name="airline" class="form-control">
                            <option value="">Choose Airline</option>
                            <t t-foreach="airlines" t-as="airline">
                                <option t-att-value="airline">
                                    <t t-esc="airline" />
                                </option>
                            </t>
                        </select>

                    </div>
                    <div name="travel" class="form-group col-md-6">
                        <div id="flight_date">
                            <label class="col-form-label">
                                Date of flight <span style="color:red">*</span>
                            </label>
                            <div class="o_website_form_date input-group date">
                                <input name="dof" class="form-control datetimepicker-input o_website_form_input datepicker" data-toggle="datetimepicker" data-target="#customer_dob" autocomplete="off"/>
                                <div class="input-group-append" data-toggle="datetimepicker">
                                    <div class="input-group-text">
                                        <i class="fa fa-calendar" data-original-title="Date of Birth" title="Date of Birth" aria-describedby="tooltip118921"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div name="travel" class="form-row">
                    <div class="form-group col-md-6">
                        <label class="col-form-label">
                            Destination Country <span style="color:red">*</span>
                        </label>
                        <select name="country_to" class="form-control">
                            <option value="">Choose Country</option>
                            <t t-foreach="countries" t-as="country">
                                <option t-att-value="country.id">
                                    <t t-esc="country.name" />
                                </option>
                            </t>
                        </select>
                    </div>
                </div>
                <div name="travel" class="form-row mt-4">
                    <div class="form-group col-md-6">
                        <label class="col-form-label">
                            Passport Number <span style="color:red">*</span>
                        </label>
                        <input name="passport_no" type="text" maxlength="75" placeholder="Passport Number" class="form-control" />
                    </div>
                    <div class="form-group col-md-6">
                        <label class="col-form-label">
                            Passport Issuing Country <span style="color:red">*</span>
                        </label>
                        <select name="pass_country" class="form-control">
                            <option value="">Choose Country</option>
                            <t t-foreach="countries" t-as="country">
                                <option t-att-value="country.id">
                                    <t t-esc="country.name" />
                                </option>
                            </t>
                        </select>
                        <input name="mode" type="hidden" value="New" />
                    </div>
                </div>
            </div>
        </template>
        <template id="patient-form-footer">
            <div class="row actions mt-5 pt-4 border-top-blue">
                <div class="col-6">
                    <!--cancel purchase modal-->
                    <t t-call="eha_website.cancel-purchase" />
                    <!--end cancel purchase modal-->
                    <div name="cancel" href="#confirmCancelModal" data-toggle="modal" data-dismiss="modal" class="btn btn-outline-primary">Cancel Purchase</div>
                </div>
                <div class="col-6 text-right">
                    <button type="submit" name="continue" class="btn btn-primary">Continue</button>
                </div>
            </div>
        </template>

        <template id="buytest-step1" name="Buy COVID-19 Patient Data">
            <t t-name="website.buytest-step1">
                <t t-call="website.layout">
                    <link rel="stylesheet" href="/eha_website/static/src/lib/build/css/intlTelInput.min.css" />
                    <script type="text/javascript" src="/eha_website/static/src/js/utils.js?v=1.0.1"></script>
                    <script src="/eha_website/static/src/lib/build/js/intlTelInput.min.js"></script>
                    <div id="wrap" class="oe_structure oe_empty"/>
                    <t t-call="eha_website.covid19-preloader"/>
                    <div id="wrapper" class="d-none">
                        <div class="section bgLight">
                            <div class="container pt-4 pb-3">
                                <h4 id="product_name_header"></h4>
                            </div>
                        </div>
                        <div class="section bgLight">
                            <div class="container">
                                <div class="tabs">
                                    <div class="step-tab pt-4 pb-4 active">
                                        <div>
                                            <span class="badge badge-primary badge-m mr-2">1</span>
                                                Who is getting tested?
                                        </div>
                                    </div>
                                    <div class="step-tab pt-4 pb-4">
                                        <div>
                                            <span class="badge badge-primary badge-m mr-2">2</span>
                                                Sample Collection
                                        </div>
                                    </div>
                                    <div class="step-tab pt-4 pb-4">
                                        <div>
                                            <span class="badge badge-primary badge-m mr-2">3</span>
                                            Purchase
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="section">
                            <div class="container mt-6 mb-5">
                                <form id="patient_form" action="/services/buy-covid19-patientsummary" method="post">
                                    <div class="row">
                                        <div class="col-md-4 mt-2 mb-4 pr-5">
                                            <h5>Who is getting tested</h5>
                                            <p>Please fill in the fields with details of the person that is getting tested.</p>
                                            <small>
                                                <i>*Note, all fields are mandatory.</i>
                                            </small>
                                        </div>
                                        <div class="col-md-8">
                                            <t t-call="eha_website.patient-form" />
                                        </div>
                                    </div>
                                    <t t-call="eha_website.patient-form-footer" />
                                </form>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
