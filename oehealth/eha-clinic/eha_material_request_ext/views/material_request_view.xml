<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="eha_view_material_request_search" model="ir.ui.view">
            <field name="name">eha.material.request.search</field>
            <field name="model">material.request</field>
            <field name="inherit_id" ref="material_request.view_material_request_search"/>
            <field name="arch" type="xml">
                <field name="assigned_to" position="after">
                    <field name="line_ids" string="Product" filter_domain="[('line_ids.product_id.name', 'ilike', self)]"/>
                    <field name="line_ids" string="Description" filter_domain="[('line_ids.description', 'ilike', self)]"/>
                    <field name="line_ids" string="Product Category" filter_domain="[('line_ids.product_id.categ_id', 'child_of', self)]"/>
                </field>
            </field>
        </record>
        
        <record id="eha_view_material_request_form_ext" model="ir.ui.view">
            <field name="name">eha.material.request.form</field>
            <field name="model">material.request</field>
            <field name="inherit_id" ref="material_request.view_material_request_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='line_ids']/tree" position="attributes">
                    <attribute name="editable">bottom</attribute>
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree/field[@name='product_uom_id']" position="attributes">
                    <attribute name="groups">uom.group_uom</attribute>
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="%(action_create_warehouse_transfer_wizard)d" class="oe_highlight" string="Transfer Material" type="action" attrs="{'invisible': ['|', ('request_type','!=','warehouse_transfer'), ('state','!=','approved')]}" groups="stock.group_stock_manager"/>
                </xpath>
                <field name="picking_type_id" position="after">
                    <field name="incoming_picking_type_id" attrs="{'invisible': [('request_type','!=','warehouse_transfer')], 'readonly': [('allow_update','=', False)] , 'required': [('request_type','=', 'warehouse_transfer'), ('state','=', 'to_approve')]}"/>
                    <field name="transfer_direction" attrs="{'invisible': [('request_type','!=','warehouse_transfer')], 'readonly': [('allow_update','=', False)] , 'required': [('request_type','=', 'warehouse_transfer'), ('state','=', 'to_approve')]}"/>
                </field>
                <xpath expr="//field[@name='line_ids']/tree/field[@name='product_id']" position="after">
                    <field name="associated_warehouse_product_id" optional="hide"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>