<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="hr_recruitment_move_form" model="ir.ui.view">
            <field name="name">hr.recruitment.move.view.form</field>
            <field name="model">hr.applicant.move</field>
            <field name="arch" type="xml">
                <form string="HR Applicant">
                    <field name="applicant_ids" />
                    <group>
                        <group>
                            <field name="stage_id" />
                        </group>
                    </group>
                    <footer>
                        <button type="object" name="move"
                            string="Move" class="oe_highlight"
                            attrs="{'invisible': ['|', ('applicant_ids','=', False), ('stage_id', '=', False)]}" />
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record> 

        <record id="hr_applicant_move_action" model="ir.actions.act_window">
            <field name="name">Move Applicants</field>
            <field name="res_model">hr.applicant.move</field>
            <field name="view_mode">form</field>
            <field name="context">{'default_applicant_ids': active_ids}</field>
            <field name="target">new</field>
            <field name="views">[[False, 'form']]</field>
            <field name="binding_model_id" ref="hr_recruitment.model_hr_applicant" />
        </record>

    </data>
</odoo>
