<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.telehealth</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="50"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')]" position="inside">
                    <div class="app_settings_block" data-string="TeleHealth" string="TeleHealth" data-key="telehealth">
                        <h2>TeleHealth</h2>
                        <div class="row mt16 o_settings_container" name="income_accounts_setting_container">
                            <div class="col-12 col-lg-6 o_setting_box" id="">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <span class="o_form_label">TeleHealth</span>
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label for="telehealth_product_id" class="col-lg-3 o_light_label"/>
                                            <field name="telehealth_product_id" options="{'no_create_edit': True, 'no_open': True}" />
                                        </div>
                                    </div>
                                    <div class="oe_clear" />
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label for="telehealth_service_id" class="col-lg-3 o_light_label"/>
                                            <field name="telehealth_service_id" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- <div class="col-12 col-lg-6 o_setting_box" id="">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label for="credentials_json" class="col-lg-3 o_light_label"/>
                                            <field name="credentials_json" />
                                        </div>
                                    </div>
                                    <div class="oe_clear" />
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label for="token_json" class="col-lg-3 o_light_label"/>
                                            <field name="token_json" />
                                        </div>
                                    </div>
                                </div>
                            </div> -->
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_right_pane">
                                    <div class="content-group">
                                        <div class="row mt16">
                                            <label for="telehealth_location_id" class="col-lg-3 o_light_label"/>
                                            <field name="telehealth_location_id" />
                                        </div>
                                    </div>
                                    <div class="oe_clear" />
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="telehealth_config_settings_action" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="res_config_settings_view_form"/>
            <field name="target">inline</field>
            <field name="context">{'module' : 'telehealth', 'bin_size': False}</field>
        </record>

        <menuitem id="telehealth_settings_menu_action" name="Settings" parent="oehealth.oeh_medical_conf_menu"
            sequence="0" action="telehealth_config_settings_action" groups="base.group_system"/>
    
    </data>
</odoo>
