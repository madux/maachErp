                            <option t-att-value='state.id'>
                              <span t-esc="state.name" />
                            </option>
                          </t>
                        </select> -->
                      </div>
                      <div class="form-group col">
                        <label class="col-form-label">
                                            Patient ID (for patients)
                            </label>
                        <input type="text" maxlength="75" id="client-patientID" name="patientID" class="form-control" />
                      </div>
                    </div>
