                    <div class="form-row d-none">
                      <div id="select-date" name="date-block" class="form-group col-md-6 form-field o_website_form_custom">
                        <label class="col-form-label" for="Custom Date">Pick a date</label>
                        <div class="o_website_form_date input-group date" id="datepicker1div" data-target-input="nearest">
