                              <span id="telehealth-summary-booking-time" />
                            </h5>
                            <i>Note to the doctor:</i>
                            <p>
                              <b id="telehealth-note-to-doctor"></b>
                            </p>
                          </td>
                        </tr>
                      </tbody>
                      <tfoot>
                        <tr class="summary-footer">
                          <td>Total</td>
                          <td id="telehealth-price-total"></td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
