    <template id="telehealth_modal">
      <div id="telehealthModal" class="modal show">
        <div class="modal-dialog h-auto">
          <div class="modal-content">
            <div class="modal-header">
              <span type="button" class="close" data-dismiss="modal">&#215;</span>
              <h3 class="mb-4 mx-5 mt-2">Book Telehealth appointment</h3>
            </div>
            <div class="d-flex flex-column align-items-center">
              <img class="mb-3" src="/eha_website/static/src/img/illu-telehealth.png" width="180px" />
            </div>
            <div class="nav" role="tablist">

              <div class="nav-tab step-tab pt-4 pb-4 active" id="nav_tabs_link_1" data-toggle="tab" role="tab" href="#nav_tabs_content_1" aria-controls="#nav_tabs_content_1" aria-selected="true">
                <div class="d-flex flex-column align-items-center">
                  <span class="badge badge-primary badge-m mb-2">1</span>
                  Personal Details
                </div>
              </div>
              <div class="nav-tab step-tab pt-4 pb-4" id="nav_tabs_link_2" data-toggle="tab" role="tab" href="#nav_tabs_content_2" aria-controls="#nav_tabs_content_2" aria-selected="false">
                <div class="d-flex flex-column align-items-center">
                  <span class="badge badge-primary badge-m mb-2">2</span>
                  Date and Time
                </div>
              </div>
              <div class="nav-tab step-tab pt-4 pb-4" id="nav_tabs_link_3" data-toggle="tab" role="tab" href="#nav_tabs_content_3" aria-controls="#nav_tabs_content_3" aria-selected="false">
                <div class="d-flex flex-column align-items-center">
                  <span class="badge badge-primary badge-m mb-2">3</span>
                  Payment
                </div>
              </div>
            </div>
            <div class="tab-content">
              <div class="tab-pane fade show active" id="nav_tabs_content_1" role="tabpanel" aria-labelledby="nav_tabs_link_1">
                <div class="p-4">
                  <h4 class="mb-4 mt-2">Book Consultation for</h4>
                  <form>
                    <div class="form-row">
                      <div class="form-group col">
                        <label class="col-form-label">Surname</label>
                        <input type="text" maxlength="75" required="1" id="client-lastname" placeholder="Surname" name="lastname" class="form-control" />
                      </div>
                      <div class="form-group col">
                        <label class="col-form-label">First Name</label>
                        <input type="text" maxlength="75" required="1" id="client-firstname" placeholder="First Name" name="firstname" class="form-control" />
                      </div>
                      <div class="form-group col">
                        <label class="col-form-label">Middle Name</label>
                        <input type="text" maxlength="75" id="client-middlename" placeholder="Middle Name" name="middlename" class="form-control" />
                      </div>
                      <input type="hidden" name="family_class" class="family_class form-control" />
                    </div>
                    <div class="form-row">
                      <div class="form-group col">
                        <label class="col-form-label" for="email">Email</label>
                        <input name="email" required="required" type="text" id="client-email" placeholder="admin@example.com" class="form-control o_website_form_input" autocomplete="off" />
                      </div>
                      <div class="form-group col">
                        <label class="col-form-label" for="gender">
                                            Gender
                            </label>
                        <select name="gender" required="1" data-init="1" class="form-control">
                          <option value="">Gender</option>
                          <option value="Male">
                                                Male
                              </option>
                          <option value="Female">
                                                Female
                              </option>
                          <option value="Other">
                                                Other
                              </option>
                        </select>
                      </div>
                      <div class="form-group col">
                        <label class="col-form-label" for="dob">
                                            Date of Birth
                            </label>
                        <div class="o_website_form_date input-group input-group-lg date">
