    <template id="telehealth">
      <t t-name="website.telehealth">
        <t t-call="website.layout">
          <section class="s_banner parallax pt96 pb48" data-scroll-background-ratio="0.6" data-name="Banner" style="background-image: none;">
            <span class="s_parallax_bg oe_img_bg oe_custom_bg" style="background-image: url(&quot;/eha_website/static/src/img/bg-get-care.jpg&quot;); background-position: 62.2% 44.59%; top: -65.76px; bottom: -65.76px; transform: translateY(-20px);" />
            <div class="container">
              <div class="row justify-content-center mb-4">
                <div class="col-12 s_title pt30 pb2  text-center" data-name="Title">
                  <h1 class="title-banner">
                    <span>Get Care</span>
                    <span class="text-highlight">with EHA Clinics</span>
                  </h1>
                </div>
                <button href="#telehealthModal" data-toggle="modal" maxlength="20" class="btn-primary mt-4" type="button">book telehealth appointment</button>
              </div>
            </div>
          </section>
          <t t-call="eha_telehealth.telehealth_modal" />
        </t>
      </t>
    </template>

    <template id="telehealth_final" name="template_final">
      <t t-name="website.telehealth-final">
        <t t-call="website.layout">
          <t t-set="title">TeleHealth | Success</t>
          <div id="wrap" class="oe_structure oe_empty" />
          <div class="section bgLight pt-4">
            <div class="container pt-5 pb-4">
              <h3>Thank you for choosing EHA Clinics.</h3>
              <p class="text-lg pt-4 d-none" id="label-for-payment">Payment has been confirmed and your TeleHealth Appointment has been booked.</p>
              <p class="text-lg pt-4 d-none" id="label-for-non-payment">Your TeleHealth Appointment has been booked.</p>
              <p class="text-lg pt-4">
                Your booking reference is
                <t t-esc="booking.name" />
                .
              </p>
            </div>
          </div>
          <div class="section pt-4 mb-5">
            <div class="container pt-4">
              <h3>Your next steps</h3>
              <div class="row">
                <div class="col-md-8">
                  <div class="mt-4 pl-5 pt-1 mr-3 list-icon">
                    <i class="fa fa-check rounded-icon"></i>
                    <p>
                                Check Email inbox for you personal TeleHealth link.
                    </p>
                  </div>
                  <div class="mt-4 pl-5 pt-1 mr-3 list-icon">
                    <i class="fa fa-check rounded-icon"></i>
                    <p>
                                Follow the link sent to your email at your appointment time
                    </p>
                    <div class="background-50 p-4 row col-lg-8 flex-center">
                      <i class="fa fa-calendar text-primary mr-3" />
                      <b>
                        <t t-esc="date" />
                        |
                        <t t-esc="time" />
                      </b>
