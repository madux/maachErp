                    <div class="row actions mt-5 pt-4 border-top-blue">
                      <div class="col-6">
                        <a class="btn btn-outline-primary" id="telehealth-back-to-patient-details" href="#">Back</a>
                      </div>
                      <div class="col-6 text-right">
                        <input type="submit" class="btn btn-primary" id="telehealth-confirm-date" value="Continue" />
                      </div>
                    </div>
                    <input type="hidden" name="csrf_token" />
                  </form>
                </div>
              </div>
              <div class="tab-pane fade" id="nav_tabs_content_3" role="tabpanel" aria-labelledby="nav_tabs_link_3">
                <div class="p-4">
                  <div class="purchase-summary">
                    <div class="summary-header">
                                        TeleHealth Consultation
                        </div>
                    <table>
                      <tbody>
                        <tr>
                          <td colspan="2">
                            <h5>
                              <i class="fa fa-calendar fa-md text-primary mr-3"></i>
                              <span id="telehealth-summary-booking-date" />
