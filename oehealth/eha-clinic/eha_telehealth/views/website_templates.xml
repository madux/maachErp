    <template id="homepage" inherit_id="eha_website.new_home_page">
        <xpath expr="//t[@t-call='website.layout']" position="inside">
            <t t-call="eha_telehealth.telehealth_modal" />
        </xpath>

        <xpath expr="//div[hasclass('appointment-select-box')]/form/div[1]" position="before">
            <div class="appointment-selector">
                <input class="checkbox" name="appt-type" id="select_tele" value="/appointment/telehealth" type="radio"/>
                <label class="appointment-selector-label" for="select_tele">
                    <i class="icon eha-telemedicine mr-3"/>
                    <span>Doctor Consultation <b>- Online</b>
                        <span class="description">Get an online consultation, conveniently from your home.</span>
                    </span>
                </label>
            </div>
        </xpath>

        <xpath expr="//button[@id='appt-btn']" position="after">
           <button href="#telehealthModal" id="telehealth-appt-btn" hidden="1" data-toggle="modal" maxlength="20" class="btn-primary mt-4" type="button">Book An Appointment</button>
        </xpath>
    </template>

</odoo>
