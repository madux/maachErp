<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="service_telehealth" inherit_id="eha_website.service_telehealth">
        <xpath expr="//section[hasclass('landing-page')]" position="after">
            <t t-call="eha_telehealth.telehealth_modal" />
        </xpath>
        <xpath expr="//a[@href='#feedbackform']" position="replace">
            <button href="#telehealthModal" data-toggle="modal" maxlength="20" class="btn-primary mt-4" type="button">Get In Touch</button>
        </xpath>
    </template>

