<?xml version="1.0" encoding='UTF-8'?>
<odoo>
    <data>
         
        <record id="payslip_threshold_date_param" model="ir.config_parameter">
            <field name="key">payroll_extension.payslip_threshold_date</field>
            <field name="value" eval="(datetime.now() - timedelta(days=1)).strftime('%Y-%m-%d')"/>
        </record>
    </data>
         
</odoo>
