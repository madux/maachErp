<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--Email template --> 
        <record id="email_tpl_payslip" model="mail.template">
            <field name="name">Employee Payslip - Send by Email</field>
            <field name="email_from">"${object.employee_id.company_id.name|safe}"${(object.employee_id.company_id.email or '')|safe}</field>
            <field name="subject">Ref ${object.name or 'n/a' }</field>
            <field name="email_to">${ctx['email_to']}</field>
            <field name="partner_to">${object.employee_id.address_home_id.id}</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="auto_delete" eval="True"/>
            <field name="report_template" ref="hr_payroll.action_report_payslip"/>
            <field name="report_name">${(object.name or '').replace('/','_')}</field>
            <field name="lang">${object.employee_id.address_home_id.lang}</field>
            <field name="body_html"><![CDATA[
                <div style="padding:0px;width:960px;margin:auto;background: #FFFFFF repeat top /100%;color:#777777">
                    <table cellspacing="0" cellpadding="0" style="width:600px;background:inherit;color:inherit">
                        <tbody><tr>
                            <td valign="center" width="200" style="padding:10px 10px 10px 5px;font-size: 12px">
                                <img src="/logo.png" style="padding: 0px; margin: 0px; height: auto; width: 80px;" alt="${object.company_id.name}">
                            </td>
                        </tr></tbody>
                    </table>
                </div>
                <p>Dear ${object.employee_id.name},<br/>
                    <br/>
                    Please find attached your payslip
                    <br/><br/>
                    If you have any questions, please do not hesitate to ask us.
                    <br/><br/>
                    Regards,
                    </br>
                    HR Department
                </p>
                <br/>
                <div style="width: 960px; margin: 0px; padding: 0px; background-color: #007bff; background-repeat: repeat no-repeat;">
                    <h3 style="margin: 0px; padding: 2px 14px; font-size: 12px; color: #DDD;">
                        &nbsp;
                    </h3>
                </div>
                <div style="width: 960px; margin: 0px; line-height: 16px; background-color: #F2F2F2;">
                    <div style="color: #222; margin-bottom: 5px; padding: 5px 14px; ">
                        ${object.company_id.partner_id.sudo().with_context(show_address=True, html_format=True).name_get()[0][1] | safe}
                    </div>
                    % if object.company_id.phone:
                        <div style="padding: 5px 14px;">
                            Phone:&nbsp; ${object.company_id.phone}
                        </div>
                    % endif
                    % if object.company_id.website:
                        <div style="padding: 5px 14px;">
                            Web :&nbsp;<a href="${object.company_id.website}">${object.company_id.website}</a>
                        </div>
                    %endif
                    <p></p>
                </div>
            ]]></field>
        </record>
    </data>
</odoo>
