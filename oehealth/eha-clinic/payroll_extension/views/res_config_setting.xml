<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="hr_payroll_res_config_settings_inherited" >
            <field name="name">res.config.settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='localization_text']" position="after">
                    <div class="mt8" id="localization_text">
                        <label for="payslip_threshold_date" string="Payslip Threshold Date"/>
                        <field name="payslip_threshold_date_str" invisible="1"/>
                        <field name="payslip_threshold_date"/>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>