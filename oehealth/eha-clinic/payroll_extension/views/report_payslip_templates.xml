<?xml version="1.0" encoding="utf-8"?>
<!--inherit and modify hr_payroll payslip template-->
<odoo>
    <template id="report_payslip_extension" inherit_id="hr_payroll.report_payslip">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="payroll_extension.external_layout_extension">
                <div class="page">
                    <h2>Pay Slip</h2>
                    <p t-field="o.name"/>

                    <table class="table table-sm table-bordered">
                        <tr>
                            <td>
                                <strong>Name</strong>
                            </td>
                            <td>
                                <span t-field="o.employee_id"/>
                            </td>
                            <td>
                                <strong>Position</strong>
                            </td>
                            <td>
                                <span t-field="o.employee_id.job_id"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Private Address</strong>
                            </td>
                            <td colspan="">
                                <div t-field="o.employee_id.address_home_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                            </td>
                            <!-- <td>
                                <strong>Pension No</strong>
                            </td>
                            <td>
                                <span t-field="o.employee_id.pfa_id_ref"/>
                            </td> -->
                        </tr>
                        <tr>
                            <td>
                                <strong>Email</strong>
                            </td>
                            <td>
                                <span t-field="o.employee_id.work_email"/>
                            </td>
                            <td>
                                <strong>Staff ID</strong>
                            </td>
                            <td>
                                <span t-field="o.employee_id.employee_identification_code"/>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Reference</strong>
                            </td>
                            <td>
                                <span t-field="o.number"/>
                            </td>
                            <td>
                                <strong>Bank Details</strong>
                            </td>
                            <td>
                                <span> Bank Name: <span t-field="o.employee_id.bank_account_id.bank_id.name"/></span>
                                <br/>
                                <span> Account No: <span t-field="o.employee_id.bank_account_id"/>
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Date From</strong>
                            </td>
                            <td>
                                <span t-field="o.date_from"/>
                            </td>
                            <td>
                                <strong>Date To</strong>
                            </td>
                            <td>
                                <span t-field="o.date_to"/>
                            </td>
                        </tr>
                    </table>

                    <!--set variable to be used later-->
                    <t t-set="lines" t-value="o.line_ids.filtered(lambda line: line.appears_on_payslip)"/>
                    <t t-set="earning_categories" t-value="['Allowance','Basic']" />
                    <t t-set="deduction_categories" t-value="['Deduction']" />
                    <t t-set="earnings" t-value="sum(o.line_ids.filtered(lambda line: line.appears_on_payslip and line.salary_rule_id.category_id.name in earning_categories).mapped('total'))"/>
                    <t t-set="deductions" t-value="sum(o.line_ids.filtered(lambda line: line.appears_on_payslip and line.salary_rule_id.category_id.name in deduction_categories).mapped('total'))"/>

                    <!--deductions is negative value, to arrive at the net, use + operator
                    <t t-set="net" t-value="earnings + deductions"/> -->

                    <!-- Earning and deduction table-->
                    <table class="table table-sm ">
                        <thead>
                            <tr style="background-color: lightblue">
                                <th>EARNINGS</th>
                                <th style=""></th>
                                <th>DEDUCTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <table class="table">
                                        <thead >
                                            <tr style="width:100%">
                                                <th> Description </th>
                                                <th> Amount (NGN)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="lines" t-as="line">
                                                <tr t-if="line.salary_rule_id.category_id.name == 'Basic' ">
                                                    <td>
                                                        <span t-field="line.name"/>
                                                    </td>
                                                    <td>
                                                        <span t-esc="line.total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                                    </td>
                                                </tr>
                                                <tr t-if="line.salary_rule_id.category_id.name == 'Allowance' ">
                                                    <td>
                                                        <span t-field="line.name"/>
                                                    </td>
                                                    <td>
                                                        <span t-esc="line.total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                                    </td>
                                                </tr>
                                                <tr t-if="line.salary_rule_id.category_id.name == 'Gross' ">
                                                    <td>
                                                        <br/>
                                                        <strong> Total Earnings / Gross Pay </strong>
                                                    </td>
                                                    <td>
                                                        <br/>
                                                        <span t-esc="line.total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                                    </td>
                                                </tr>

                                                <tr style="height:5px">

                                                </tr>

                                                <tr style="background-color: lightblue" t-if="line.salary_rule_id.category_id.name == 'Net' ">
                                                    <br/>
                                                    <td>
                                                        <strong> NET PAY </strong>
                                                    </td>
                                                    <td>
                                                        <span t-esc="line.total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </td>
                                <!--//earnings-->
                                <td style="border-collapse:collapse; border: solid 1px #EFEFEF"></td>
                                <td>
                                    <table class="table">
                                        <thead >
                                            <tr style="width:100%">
                                                <th> Description </th>
                                                <th> Amount (NGN)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="lines" t-as="line">
                                                <t t-if="line.salary_rule_id.category_id.name == 'Deduction' ">
                                                    <td>
                                                        <span t-field="line.name"/>
                                                    </td>
                                                    <td>
                                                        <span t-esc="line.total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                                    </td>
                                                </t>
                                            </tr>
                                            <tr style="">
                                                
                                                <td>
                                                    <br/>
                                                    <strong> Total Deductions  </strong>
                                                </td>
                                                <td>
                                                <br/>
                                                    <span t-esc="deductions" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                                <!--//deductions-->
                            </tr>
                        </tbody>
                    </table>

                    <p class="text-right">
                        <!-- <strong>Authorized signature</strong> -->
                    </p>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
