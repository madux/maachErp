<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="eha_emr_connector_error_log_view_tree" model="ir.ui.view">
            <field name="name">eha_emr_connector.error.log.view.tree</field>
            <field name="model">eha_emr_connector.error.log</field>
            <field name="arch" type="xml">
                <tree string="EMR Migration Error Log">
                    <field name="model" />
                    <field name="create_date" />
                    <field name="record" />
                    <field name="error" />
                </tree>
            </field>
        </record>

        <record id="eha_emr_connector_error_log_view_form" model="ir.ui.view">
            <field name="name">eha_emr_connector.error.log.view.form</field>
            <field name="model">eha_emr_connector.error.log</field>
            <field name="arch" type="xml">
                <form string="EMR Migration Error Log">
                    <group string="EMR Migration Error Logs">
                        <group>
                            <field name="model" />
                            <field name="create_date" />
                        </group>
                        <group>
                            <field name="record" />
                        </group>
                    </group>
                    <notebook>
                        <page>
                            <field name="error" />
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <record id="eha_emr_connector_error_log_view_search" model="ir.ui.view">
            <field name="name">eha_emr_connector.error.log.view.search</field>
            <field name="model">eha_emr_connector.error.log</field>
            <field name="arch" type="xml">
                <search string="">
                    <field name="model" />
                    <field name="record" />
                    <field name="create_date" />
                </search>
            </field>
        </record>

        <record id="eha_emr_connector_error_log_action" model="ir.actions.act_window">
            <field name="name">EMR Migration Logs</field>
            <field name="res_model">eha_emr_connector.error.log</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <menuitem
            id="eha_emr_connector_root"
            name="EMR Migration"
            parent="oehealth.oeh_medical_conf_menu"
            sequence="10" />

        <menuitem
            id="eha_emr_connector_error_menu"
            name="Error logs"
            parent="eha_emr_connector_root"
            action="eha_emr_connector_error_log_action"
            sequence="1"
        />

    </data>
</odoo>