<odoo>
  <data>

    <record id="res_config_settings_view_form" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.inherit.eha.emr.connector</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
      <field name="arch" type="xml">
        <xpath expr="//div[@name='integration']" position="inside">
          <div class="col-12 col-lg-6 o_setting_box">
            <div class="o_setting_left_pane">
              <div class="text-muted">
                <!-- Use external pads in Odoo Notes -->
              </div>
            </div>
            <div class="o_setting_right_pane">
              <strong>EMR Connection Settings</strong>
              <div class="text-muted">
                Configure variables like url, client iD etc.
              </div>
              <div>
                <div>
                  <label for="client_id" />
                  <field name="client_id" />
                </div>
                <div>
                  <label for="demographics_url" />
                  <field name="demographics_url" />
                </div>
                <div>
                  <label for="token_url" />
                  <field name="token_url" />
                </div>
                <div>
                  <label for="username" />
                  <field name="username" />
                </div>
                <div>
                  <label for="password" />
                  <field name="password" />
                </div>
              </div>
            </div>
          </div>
          <div class="col-12 col-lg-6 o_setting_box">
            <div class="o_setting_left_pane">
              <div class="text-muted">
                <!-- Use external pads in Odoo Notes -->
              </div>
            </div>
            <div class="o_setting_right_pane">
              <strong>EHR Connection Settings</strong>
              <div class="text-muted">
                Configure variables like url, client iD etc.
              </div>
              <div>
                <div>
                  <label for="ehr_url" />
                  <field name="ehr_url" />
                </div>
                <div>
                  <label for="ehr_username" />
                  <field name="ehr_username" />
                </div>
                <div>
                  <label for="ehr_password" />
                  <field name="ehr_password" />
                </div>
                <div>
                  <label for="namespace" />
                  <field name="namespace" />
                </div>
              </div>
            </div>
          </div>
        </xpath>
      </field>
    </record>
  </data>
</odoo>