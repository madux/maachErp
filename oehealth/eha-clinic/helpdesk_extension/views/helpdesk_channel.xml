<?xml version="1.0" encoding="utf-8"?>
    <odoo>

		<record id="view_helpdesk_channel_form" model="ir.ui.view">
			<field name="name">helpdesk.channel.form</field>
			<field name="model">helpdesk.channel</field>
			<field name="arch" type="xml">
				<form string="Channel"> 
					<sheet>
						<field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
					</sheet>
				</form>
			</field>
		</record>

        <record id="view_helpdesk_channel_tree" model="ir.ui.view">
			<field name="name">helpdesk.channel.tree</field>
			<field name="model">helpdesk.channel</field>
			<field name="arch" type="xml">
				<tree editable="top" string="Channel"> 
                    <field name="name"/>
                    <field name="sequence" widget="handle"/>
				</tree>
			</field>
		</record>
		 
		<record id="view_helpdesk_channel_search" model="ir.ui.view">
			<field name="name">Channel</field>
			<field name="model">helpdesk.channel</field>
			<field name="arch" type="xml">
				<search string="Banks">
					<field name="name"/>
                    <field name="sequence"/>
				</search>
			</field>
		</record>

        <record id="act_window_helpdesk_channel" model="ir.actions.act_window">
			<field name="name">Channel</field>
			<field name="res_model">helpdesk.channel</field>
			<field name="view_mode">tree,form</field>
			<field name="help" type="html">
				<p class="oe_view_nocontent_create">
					 
				</p>
			</field>
		</record>

        <menuitem id="helpdesk_channel_menu" name="Channel" sequence="77" parent="helpdesk.helpdesk_menu_config" action="act_window_helpdesk_channel"/>

    </odoo>