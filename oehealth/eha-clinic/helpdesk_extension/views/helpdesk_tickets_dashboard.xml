    <template id="helpdesk_ticket_dashboard">
        <t t-name="EHA Helpdesk Dashboard">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty"/>
                <div class="dashboard">
                    <span class="label-top-left" t-esc="request.env.user.branch_id.name"/>
                    <table class="dashboard-table">
                        <thead>
                            <th class="room">Room</th>
                            <th class="name">Patient</th>
