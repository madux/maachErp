<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="helpdesk_ticket_form_view_extension" model="ir.ui.view">
            <field name="name">helpdesk ticket form Extension</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <xpath expr="//form" position="replace">
                    <form string="Helpdesk Ticket">
                        <header>
                            <field name="is_self_assigned" invisible="1"/>
                            <button name="assign_ticket_to_self" string="Assign To Me" type="object" class="oe_highlight" groups="helpdesk.group_helpdesk_user" attrs="{'invisible': [('is_self_assigned', '=', True)]}"/>
                            <field name="stage_id" widget="statusbar"
                                options="{'clickable': '1', 'fold_field': 'fold'}"/>
                            <field name="order_id" invisible="1"/>
                            <button name="create_sales_order" attrs="{'invisible': [('order_id','>',0)]}" class="oe_stat_button oe_highlight" icon="fa-cart" type="object" string="Create Sale Order"/>
                            <button name="create_sales_order" attrs="{'invisible': [('order_id','=',False)]}" class="oe_stat_button oe_highlight" icon="fa-cart" type="object" string="Access Sale Order"/>
                        </header>
                        <sheet>
                            <field name="legend_blocked" invisible="1"/>
                            <field name="legend_normal" invisible="1"/>
                            <field name="legend_done" invisible="1"/>
                            <field name="partner_ticket_count" invisible="1"/>
                            <div class="oe_button_box" name="button_box">
                                <button name="action_get_attachment_tree_view" class="oe_stat_button" icon="fa-book"
                                    type="object" attrs="{'invisible':  [('attachment_number', '=', 0)]}">
                                    <field name="attachment_number" widget="statinfo" string="Documents"/>
                                </button>
                                <button type="action" class="oe_stat_button" name="%(oehealth.oeh_medical_appointment_action_tree)d" groups="oehealth_extension.group_oeh_medical_op_ass,oehealth_extension.group_oeh_medical_nurse,oehealth.group_oeh_medical_physician" context="{'search_default_patient': patient_id,'default_patient': patient_id,'search_default_ticket_id': active_id,'default_ticket': active_id}" icon="fa-calendar-alt">
                                    <field string="Appointments" name="app_count" widget="statinfo"/>
                                </button>
                                <button type="action" class="oe_stat_button" name="%(oehealth.oeh_medical_evaluation_action_tree)d" groups="oehealth_extension.group_oeh_medical_nurse,oehealth.group_oeh_medical_physician" context="{'search_default_patient': patient_id,'default_patient': patient_id,'search_default_ticket_id': active_id,'default_ticket': active_id}" icon="fa-user-md">
                                    <field string="Evaluations" name="eval_count" widget="statinfo"/>
                                </button>
                                <button type="action" class="oe_stat_button" name="%(oehealth.oeh_medical_prescription_action_tree)d" groups="oehealth_extension.group_oeh_medical_nurse,oehealth.group_oeh_medical_physician" context="{'search_default_patient': patient_id,'default_patient': patient_id,'search_default_ticket_id': active_id,'default_ticket': active_id}" icon="fa-prescription-bottle-alt">
                                    <field string="Prescriptions" name="prescription_count" widget="statinfo"/>
                                </button>
                                <button type="action" class="oe_stat_button" name="%(oehealth.oeh_medical_lab_test_action_tree)d" groups="oehealth_extension.group_oeh_medical_nurse,oehealth_extension.group_oeh_medical_lab_off,oehealth.group_oeh_medical_physician" context="{'search_default_patient': patient_id,'default_patient': patient_id}" icon="fa-vials">
                                    <field string="Lab Tests" name="labs_count" widget="statinfo"/>
                                </button>
                                <button type="action" class="oe_stat_button" name="%(oehealth.oeh_medical_vaccine_action_tree)d" groups="oehealth_extension.group_oeh_medical_op_ass,oehealth_extension.group_oeh_medical_nurse,oehealth.group_oeh_medical_physician" context="{'search_default_patient': patient_id,'default_patient': patient_id,'search_default_ticket_id': active_id,'default_ticket': active_id}" icon="fa-list">
                                    <field string="Vaccines" name="vaccine_count" widget="statinfo"/>
                                </button>
                                <button type="action" class="oe_stat_button" name="%(oehealth.oeh_medical_inpatient_action_tree)d" groups="oehealth_extension.group_oeh_medical_op_ass,oehealth_extension.group_oeh_medical_nurse,oehealth.group_oeh_medical_physician" context="{'search_default_patient': patient_id,'default_patient': patient_id,'search_default_ticket_id': active_id,'default_ticket': active_id}" icon="fa-building-o">
                                    <field string="Admissions" name="admission_count" widget="statinfo"/>
                                </button>
                                <button type="action" class="oe_stat_button" name="%(account.action_move_out_invoice_type)d" groups="oehealth_extension.group_oeh_medical_op_ass" context="{'search_default_patient': active_id,'default_patient': active_id}" icon="fa-pencil-square-o">
                                    <field string="Invoices" name="invoice_count" widget="statinfo"/>
                                </button>
                            </div>
                            <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                            <field name="kanban_state" widget="state_selection"/>
                            <group>
                                <group>
                                    <field name="ticket_type_id"/>
                                    <field name="ticket_type_categ" string ="Category" invisible="0" required="0"/>
                                </group>
                                <group>
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    <field name="channel_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    <field name="priority" widget="priority"/>
                                </group>
                            </group>
                            <div class="oe_title">
                                <h1><field name="name" class="field_name" placeholder="Subject..."/></h1>
                                <field name="sla_status_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="1" groups="helpdesk.group_use_sla"/>
                            </div>
                            <group>
                                <field name="description" class="field_description" placeholder="Description of the ticket..."/>
                                <group>
                                    <field name="partner_id" class="field_partner_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                                    <field name="patient_id" attrs="{'invisible': [('ticket_type_categ', '!=', 'patient')]}" groups="oehealth_extension.group_oeh_medical_chp_nurse,oehealth_extension.group_oeh_medical_lab_off,oehealth_extension.group_oeh_medical_nurse,oehealth.group_oeh_medical_patient,oehealth.group_oeh_medical_physician,base.group_system,oehealth_extension.group_oeh_medical_op_ass,helpdesk_extension.group_helpdesk_dashboard,oehealth.group_oeh_medical_manager"/>
                                    <field name="partner_name" attrs="{'invisible': [('partner_id', '!=', False)]}"/>
                                    <field name="partner_email"/>
                                    <field name="email_cc" groups="base.group_no_one"/>
                                    <field name="dob" attrs="{'invisible': [('ticket_type_categ', '!=', 'patient')]}"/>
                                    <field name="phone"/>
                                    <field name="payer_type" readonly="True" attrs="{'invisible': [('ticket_type_categ', '!=', 'patient')]}"/>
                                </group>
                                <group>
                                    <field name="active" invisible="1"/>
                                    <field name="team_id" string="Rooms" widget="selection" attrs="{'required': [('ticket_type_categ','=', 'patient')], 'invisible': [('ticket_type_categ', 'not in', ['patient'])]}"/>
                                    <field name="team_id" string="Teams" widget="selection" attrs="{'required': [('ticket_type_categ','!=', 'patient')], 'invisible': [('ticket_type_categ', '=', 'patient')]}"/>
                                    <field name="room_status" readonly="1" attrs="{'invisible': ['|',('team_id', '=', False),('ticket_type_categ', '!=', 'patient')]}"/>
                                    <field name="room_type" invisible="1"/>
                                    <field name="incident_date" attrs="{'invisible': [('ticket_type_categ', 'not in', ['near_miss_event', 'sentinel_event', 'adverse_event', 'incident_event'])], 'required': [('ticket_type_categ', 'in', ['near_miss_event', 'sentinel_event', 'adverse_event', 'incident_event'])]}"/>
                                    <field name="reported_by" attrs="{'invisible': [('ticket_type_categ', 'not in', ['near_miss_event', 'sentinel_event', 'adverse_event', 'incident_event'])], 'required': [('ticket_type_categ', 'in', ['near_miss_event', 'sentinel_event', 'adverse_event', 'incident_event'])]}"/>
                                    <field name="department_id" attrs="{'invisible': [('ticket_type_categ', 'not in', ['near_miss_event', 'sentinel_event', 'adverse_event', 'incident_event'])], 'required': [('ticket_type_categ', 'in', ['near_miss_event', 'sentinel_event', 'adverse_event', 'incident_event'])]}"/>
                                    <field name="incident_affected_persons" attrs="{'invisible': [('ticket_type_categ', 'not in', ['near_miss_event', 'sentinel_event', 'adverse_event', 'incident_event'])]}"/>
                                    <field name="prevention" attrs="{'invisible': [('ticket_type_categ', 'not in', ['near_miss_event', 'sentinel_event', 'adverse_event', 'incident_event'])]}"/>
                                    <field name="correction" attrs="{'invisible': [('ticket_type_categ', 'not in', ['near_miss_event', 'sentinel_event', 'adverse_event', 'incident_event'])]}"/>
                                    <field name="location_id" attrs="{'invisible': [('ticket_type_categ', 'not in', ['near_miss_event', 'sentinel_event', 'adverse_event', 'incident_event'])], 'required': [('ticket_type_categ', 'in', ['near_miss_event', 'sentinel_event', 'adverse_event', 'incident_event'])]}"/>
                                    
                                    <field name="user_id" class="field_user_id" string="Assigned To" attrs="{'invisible': [('ticket_type_categ', '=', 'patient')]}"/>
                                    <field name="user_id" class="field_user_id" string="Physician" attrs="{'invisible': [('ticket_type_categ', '!=', 'patient')]}"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="sla_deadline" attrs="{'invisible': [('sla_deadline', '=', False)]}" groups="helpdesk.group_use_sla"/>
                                </group>
                                <group string="">
                                    <field name="evaluation_id" domain="[('patient','=',patient_id)]" attrs="{'invisible': [('ticket_type_categ', '!=', 'patient')]}" options="{'no_create': 'true', 'no_open': 'true'}"/>
                                    <field name="labtest_ids" widget="many2many_tags" domain="[('patient','=',patient_id)]" attrs="{'invisible': [('ticket_type_categ', '!=', 'patient')]}" options="{'no_create': 'true', 'no_open': 'true'}"/>
                                    <field name="prescription_ids" widget="many2many_tags" domain="[('patient','=',patient_id)]" attrs="{'invisible': [('ticket_type_categ', '!=', 'patient')]}" options="{'no_create': 'true', 'no_open': 'true'}"/>
                                </group>
                                <group>
                                    <field name="lab_result_status" attrs="{'invisible': [('ticket_type_categ', '!=', 'patient')]}"/>
                                    <field name="prescription_status" attrs="{'invisible': [('ticket_type_categ', '!=', 'patient')]}"/>
                                </group>
                            </group>
                            <notebook>
                                <page string="Status Log Tracker" invisible ="0">
                                    <field name="status_change_log_ids" readonly="1" force_save="1">
                                        <tree string="Time Line" editable="bottom">
                                            <field name="team_id" string="Team/Room"/>
                                            <field name="stage_from_id"/>
                                            <field name="stage_to_id"/>
                                            <field name="start_time"/>
                                            <field name="end_time"/>
                                            <field name="create_uid" string="User"/>
                                            <field name="duration_in_text" string="Duration (D:H:M:S)"/>
                                            <field name="duration" invisible = "1" string="Duration (In seconds)"/>
                                        </tree>
                                    </field>
                                </page>
                            </notebook>
                        </sheet>
                        <div class="oe_chatter">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="activity_ids" widget="mail_activity"/>
                            <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients'}"/>
                        </div>
                    </form>
                </xpath>
            </field>
        </record>

        <record id="helpdesk_tickets_view_tree_extended" model="ir.ui.view">
            <field name="name">helpdesk.ticket.view.treee.xtended</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="team_id" string="Team/Room"/>
                </field>
            </field>
        </record>

        <record id="helpdesk_tickets_view_inherit_filter" model="ir.ui.view">
            <field name="name">helpdesk.ticket</field>
            <field name="model">helpdesk.ticket</field>
            <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='archive']" position="after">
                <filter string="Assigned to" name="assignee" context="{'group_by':'user_id'}"/>
                    <filter string="Near Miss" domain="[('ticket_type_categ','=','near_miss_event')]" name="near_miss"/>
                    <filter string="Sentinel Event" domain="[('ticket_type_categ','=','sentinel_event')]" name="sentinel_event"/>
                    <filter string="Adverse Event" domain="[('ticket_type_categ','=','adverse_event')]" name="adverse_event"/>
                    <filter string="Incident" domain="[('ticket_type_categ','=','incident_event')]" name="incident"/>
                    <filter string="Command Center" domain="[('ticket_type_categ','=','command_center')]" name="command_center"/>
                    <filter string="Patient Centered" domain="[('ticket_type_categ','=','patient')]" name="patient"/>
                    <filter string="Late Incident Activities" name="incident_late_activities" 
                    domain="[('incident_date','&gt;',(context_today()+relativedelta(weeks=-1)).strftime('%Y-%m-%d')),
                     ('incident_date','&lt;=',context_today().strftime('%Y-%m-%d'))]"/>
                    <filter invisible="0" string="Today Incident Activities" name="incident_date_today" domain="[('incident_date', '=', context_today().strftime('%Y-%m-%d'))]"/> 
                    <filter invisible="0" string="Future Incident Activities" name="incident_date_upcoming_all" domain="[('incident_date', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>  
                </xpath>
                
                <xpath expr="//filter[@name='assignee']" position="after">
                    <filter string="Department" name="department_id" context="{'group_by':'department_id'}"/>
                    <filter string="Incident Location" name="location_id" context="{'group_by':'location_id'}"/>
                </xpath>
            </field>
        </record>
        <record id="helpdesk.helpdesk_ticket_view_graph_main" model="ir.ui.view">
            <field name="name">helpdesk.ticket.graph</field>
            <field name="model">helpdesk.ticket</field>
            <field name="arch" type="xml">
                <graph string="Helpdesk Tickets" type="line" stacked="True">
                    <field name="incident_date" type="row" interval="day"/>
                    <field name="ticket_type_categ" type="col"/>
                    <field name="stage_id" type="col"/>
                </graph>
            </field>
        </record>

        <record id="helpdesk.helpdesk_ticket_action_main_tree" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">tree,kanban,form,activity,graph</field>
        <field name="search_view_id" ref="helpdesk.helpdesk_tickets_view_search"/>
        <field name="context">{'search_default_is_open': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first ticket.
                </p><p>To get things done, use activities and status on tickets.<br/>
                Chat in real time or by email to collaborate efficiently.
            </p>
        </field>
    </record>

    </data>


</odoo>
