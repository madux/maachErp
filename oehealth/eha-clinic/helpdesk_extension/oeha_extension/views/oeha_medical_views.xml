<?xml version="1.0"?>
<odoo>
    <record id="oeha_medical_evaluation_view_helpdesk" model="ir.ui.view">
        <field name="name">Helpdesk Extensions to Evaluation Form</field>
        <field name="model">oeh.medical.evaluation</field>
        <field name="priority" eval="1" />
        <field name="inherit_id" ref="oehealth_extension.oeha_medical_evaluation_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='after_eval_header']" position="after">
                <!--transition buttons-->
                <div class="row transition-button-box">
                    <div class="label">
                        Transition Patient
                    </div>
                    <div class="transition-buttons">
                        <button name="%(helpdesk_extension.action_helpdesk_room_wizard)d" type="action" context="{'default_patient_id': patient, 'doctor': doctor, 'room_type': 'Exam Room'}" string="To Room" class="btn btn-primary btn-transition" />
                        <button name="%(helpdesk_extension.action_helpdesk_room_wizard)d" type="action" context="{'default_patient_id': patient, 'room_type': 'Waiting Room'}" string="To Waiting Room" class="btn btn-primary btn-transition" />
                        <button name="%(helpdesk_extension.action_helpdesk_room_wizard)d" type="action" context="{'default_patient_id': patient, 'room_type': 'Laboratory'}" string="To Laboratory" class="btn btn-primary btn-transition" />
                        <button name="%(helpdesk_extension.action_helpdesk_room_wizard)d" type="action" context="{'default_patient_id': patient, 'room_type': 'Pharmacy'}" string="To Pharmacy" class="btn btn-primary btn-transition"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="oeha_medical_patient_view">
            <field name="name">oeh.medical.patient.helpdesk.extension</field>
            <field name="model">oeh.medical.patient</field>
            <field name="inherit_id" ref="oehealth_extension.oeha_medical_patient_view"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='after_patient_header']" position="after">
                    <div class="row transition-button-box">
                        <div class="label">
                            Transition Patient
                        </div>
                        <div class="transition-buttons">
                            <button name="%(helpdesk_extension.action_helpdesk_room_wizard)d" type="action" context="{'default_patient_id': active_id, 'doctor': doctor, 'room_type': 'Exam Room'}" string="To Room" class="btn btn-primary btn-transition" />
                            <button name="%(helpdesk_extension.action_helpdesk_room_wizard)d" type="action" context="{'default_patient_id': active_id, 'room_type': 'Waiting Room'}" string="To Waiting Room" class="btn btn-primary btn-transition" />
                            <button name="%(helpdesk_extension.action_helpdesk_room_wizard)d" type="action" context="{'default_patient_id': active_id, 'room_type': 'Laboratory'}" string="To Laboratory" class="btn btn-primary btn-transition" />
                            <button name="%(helpdesk_extension.action_helpdesk_room_wizard)d" type="action" context="{'default_patient_id': active_id, 'room_type': 'Pharmacy'}" string="To Pharmacy" class="btn btn-primary btn-transition"/>
                        </div>
                    </div>
                </xpath>
            </field>
    </record>

</odoo>