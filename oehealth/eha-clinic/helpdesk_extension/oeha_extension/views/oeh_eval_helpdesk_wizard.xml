<?xml version="1.0"?>
<odoo>

   <!-- Clear Dashboard Wizard-->
    <record id="view_helpdesk_dashboard_clear" model="ir.ui.view">
        <field name="name">Clear Helpdesk Dashboard</field>
        <field name="model">helpdesk.team.clear.wizard</field>
        <field name="arch" type="xml">
            <form string="Clear Dashboard">
                <group>
                    <separator string="Are you sure to clear the dashboard?." colspan="4"/>
                    <separator string="If you proceed with this action, the following will be done: " colspan="4"/>
                    <separator string="1. All rooms will be set to clean." colspan="4"/>
                    <separator string="2. All patients will be discharged" colspan="4"/>
                    <separator string="3. This action CANNOT be undone!" colspan="4"/>
                    <separator string="If you still want to proceed, click 'Clear Dashboard'" colspan="4"/>
                </group>
                <footer>                        
                    <button name="clear_dashboard" string="Clear Dashboard"
                        type="object" class="oe_highlight" />
                    <button string="Cancel" class="oe_link"
                        special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- <act_window id="action_clear_helpdesk_dashboard"
            name="Clear Helpdesk Dashboard"
            res_model="helpdesk.team.clear.wizard"
            binding_model="helpdesk.team"
            view_mode="form"
            target="new"/> -->
    <record id="action_clear_helpdesk_dashboard" model="ir.actions.act_window">
        <field name="name">Clear Helpdesk Dashboard</field>
        <!-- <field name="res_model" ref="helpdesk_extension.model_helpdesk_team_clear_wizard"/> -->
        <field name="res_model">helpdesk.team.clear.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="helpdesk.model_helpdesk_team"/>
        <field name="target">new</field>
    </record>

    <record id="action_helpdesk_room_wizard" model="ir.actions.act_window">
        <field name="name">Select a Room</field>
        <field name="res_model">helpdesk.team.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="helpdesk.model_helpdesk_team"/>
        <field name="target">new</field>
    </record>

   <!-- Helpdesk Team Wizard Action-->
    <!-- <act_window id="action_helpdesk_room_wizard" 
            name="Select a Room" 
            binding_model="helpdesk.team"
            res_model="helpdesk.team.wizard" 
            view_mode="form" 
            target="new" 
      /> -->

    <record id="hepdesk_room_wizard" model="ir.ui.view">
        <field name="name">Helpdesk Room Wizard</field>
        <field name="model">helpdesk.team.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="patient_id" invisible="1"/>
                        <field name="team_id" options='{"always_reload": True,"no_create":True, "no_open": True}' />
                        <field name="stage_id" string="State" options='{"always_reload": True,"no_create":True, "no_open": True}'/>
                        <field name="user_id" options='{"always_reload": True,"no_create":True, "no_open": True}'/>
                        <field name="room_type" invisible="1" />
                        <field name="lab_result_ready" attrs="{'invisible': [('room_type','=','Pharmacy')]}"/>
                        <field name="prescription_ready" attrs="{'invisible': [('room_type','=','Laboratory')]}"/>
                        <field name="is_online_pharmacy"/>
                    </group>
                    <group>
                        <field name="current_team_id" invisible="1" />
                        <field name="current_stage_id" invisible="1" />
                    </group>
                </group>
                <footer>
                    <button type="object" name="do_transition_room" string="Ok" class="oe_highlight" confirm="Are you sure you want to perform this operation?" />
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>