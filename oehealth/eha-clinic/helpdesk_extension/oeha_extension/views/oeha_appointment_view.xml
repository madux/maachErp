<?xml version="1.0"?>
<odoo>
    <record id="oeha_medical_appointment_form_helpdesk" model="ir.ui.view">
        <field name="name">Helpdesk Extensions to Appointment Form</field>
        <field name="model">oeh.medical.appointment</field>
        <field name="inherit_id" ref="oehealth_extension.oeha_medical_appointment_form"/>
        <field name="arch" type="xml">
            <field name="doctor" position="before">
                <field name="team_id" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="oeha_medical_appointment_search_helpdesk" model="ir.ui.view">
        <field name="name">Extensions to Appointment search extended</field>
        <field name="model">oeh.medical.appointment</field>
        <field name="inherit_id" ref="oehealth.view_oeh_medical_appointment_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='patient']" position="after">
                 <field name="ticket_id"/>
                 <field name="appointment_date"/>
            </xpath>
        </field>

    </record>
</odoo>