<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="oeh_extension_pharmacy_line_view_form" model="ir.ui.view">
            <field name="name">oehealth.pharmacyline.form.extended</field>
            <field name="model">oeh.medical.health.center.pharmacy</field>
            <field name="inherit_id" ref="oehealth.oeh_medical_healthcenters_pharmacy_view"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_prescription_invoice_create']" position="after">
                    <button name="move_to_room" states="Draft" string="Transition Ticket" type="object" class="oe_highlight"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>


