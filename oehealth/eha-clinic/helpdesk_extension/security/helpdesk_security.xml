<?xml version="1.0" ?>

<odoo>
    <record id="group_helpdesk_dashboard" model="res.groups">
        <field name="name">EHA Helpdesk Dashboard User</field>
        <field name="category_id" ref="base.module_category_helpdesk"/>
    </record>

    <record id="group_helpdesk_command_center" model="res.groups">
        <field name="name">Command Center Agent</field>
        <field name="category_id" ref="base.module_category_helpdesk"/>
    </record>

    <record id="helpdesk_ticket_command_center_rule" model="ir.rule">
        <field name="name">Each Command center agent can see only own ticket</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('helpdesk_extension.group_helpdesk_command_center'))]"/>
    </record>
    <record id="helpdesk_team_user_rule_two" model="ir.rule">
        <field name="name">user can see all ticket when branch is false</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('team_id.branch_id', '=', False)]</field>
    </record>

    <record id="helpdesk_team_user_rule_two" model="ir.rule">
        <field name="name">user can see all ticket when branch is false</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('team_id.branch_id', '=', False)]</field>
    </record>

</odoo>