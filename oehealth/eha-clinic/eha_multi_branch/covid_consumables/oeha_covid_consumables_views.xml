<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_form_covid_consumables_inherit" model="ir.ui.view">
            <field name="name">view.form.covid.consumables.inherit</field>
            <field name="model">oehealth_extension.consumables.tracking</field>
            <field name="inherit_id" ref="oehealth_extension.view_oeha_lab_consumables_tracking_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='run_by']" position="after">
                    <field name="branch_id" />
                </xpath>
            </field>
        </record>

        <record id="oeha_consumables_tracking_view_search_inherit" model="ir.ui.view">
            <field name="name">oeha.lab.consumables.tracking.view.search.inherit</field>
            <field name="model">oehealth_extension.consumables.tracking</field>
            <field name="inherit_id" ref="oehealth_extension.oeha_consumables_tracking_view_search" />
            <field name="arch" type="xml">
                <search string="">
                    <field name="branch_id" />
                </search>
            </field>
        </record>

    </data>
</odoo>
