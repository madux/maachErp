<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        
        <record model="ir.ui.view" id="eha_asana_links_tree">
            <field name="name">eha.asana.links.view.tree</field>
            <field name="model">eha.asana.links</field>
            <field name="arch" type="xml">
                <tree editable="top">
                    <field name="name"/>
                    <field name="url" widget="url"/>
                </tree>
            </field>
        </record>

    <!-- actions opening views on models -->
    <record model="ir.actions.act_window" id="eha_asana_links_action_window">
        <field name="name">Asana Links</field>
        <field name="res_model">eha.asana.links</field>
        <field name="view_mode">tree</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                let's create a new link.
            </p>
        </field>
    </record>

    <!-- Top menu item -->
    <menuitem name="Asana Links" id="eha_asana_links_menu_root" web_icon="eha_asana_links,static/description/icon.png"/>

    <!-- menu item -->
    <menuitem
        name="Asana Links"
        parent="eha_asana_links_menu_root"
        id="eha_asana_links_menu" action="eha_asana_links_action_window" sequence="20"/>

  </data>
</odoo>