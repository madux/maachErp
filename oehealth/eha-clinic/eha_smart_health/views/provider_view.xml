<odoo>
    <data>

        <record id="view_tree_smart_health_card_provider" model="ir.ui.view">
            <field name="name">view.tree.smart.health.card.provider</field>
            <field name="model">smart.health.card.provider</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <field name="name" />
                    <field name="provider" />
                </tree>
            </field>
        </record>

        <record id="view_form_smart_health_card_provider" model="ir.ui.view">
            <field name="name">view.form.smart.health.card.provider</field>
            <field name="model">smart.health.card.provider</field>
            <field name="arch" type="xml">
                <form create="false">
                    <field name="image_128" widget="image"/>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="provider" />
                        </group>
                    </group>
                    <notebook>
                        <page name="configuration_smart_health" string="Configuration">
                            <group>
                                <field name="key_type" />
                                <field name="private_key" />
                            </group>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>
        
        <record id="view_kanban_smart_health_card_provider" model="ir.ui.view">
            <field name="name">view.kanban.smart.health.card.provider</field>
            <field name="model">smart.health.card.provider</field>
            <field name="arch" type="xml">
                <kanban create="false">
                    <field name="id" />
                    <field name="image_128" />
                    <field name="name" />
                    <field name="provider" />
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_vignette oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img type="open" t-att-src="kanban_image('smart.health.card.provider', 'image_128', record.id.raw_value)" alt="Provider"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <h4><field name="name"/></h4>
                                    <h6><field name="provider" /></h6>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="action_smart_health" model="ir.actions.act_window">
            <field name="name">Smart Health</field>
            <field name="res_model">smart.health.card.provider</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="context">{}</field>
            <field name="domain">[]</field>
        </record>

        <menuitem id="menu_smart_health" name="Smart Health" sequence="4" parent="oehealth.oeh_medical_conf_menu" />
        <menuitem id="menu_smart_health_action" name="Providers" sequence="1" parent="menu_smart_health" action="action_smart_health"/>

    </data>
</odoo>