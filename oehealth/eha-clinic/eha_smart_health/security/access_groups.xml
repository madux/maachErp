<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data noupdate="0">

        <record model="ir.module.category" id="module_smart_health">
	        <field name="name">Smart Health</field>
	        <field name="sequence">10</field>
	        <field name="description">Smart Health</field>
    	</record>

		<record id="group_smart_health_user" model="res.groups">
	        <field name="name">User</field>
            <field name="category_id" ref="module_smart_health"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
            <field name="users" eval="[(4, ref('base.user_admin'))]" />
        </record>

        <record id="group_smart_health_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_smart_health"/>
            <field name="implied_ids" eval="[(4, ref('eha_smart_health.group_smart_health_user'))]" />
            <field name="users" eval="[(4, ref('base.user_admin'))]" />
        </record>

    </data>
</odoo>