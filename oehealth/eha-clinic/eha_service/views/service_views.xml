<odoo>
  <data>

    <!-- Service Categories -->
    <record id="eha_service_category_view_tree" model="ir.ui.view">
      <field name="name">eha.service.category.view.tree</field>
      <field name="model">eha_service.category</field>
      <field name="arch" type="xml">
        <tree string="Category">
          <field name="name" />
          <field name="description" />
        </tree>
      </field>
    </record>

    <record id="eha_service_category_view_form" model="ir.ui.view">
      <field name="name">eha_service.category.view.form</field>
      <field name="model">eha_service.category</field>
      <field name="arch" type="xml">
        <form string="Category">
          <sheet>
            <group>
              <group>
                <field name="name" />
                <field name="image" widget="image" class="oe_avatar"/>
              </group>
              <group>
                <field name="description" />
              </group>
            </group>
            <notebook>
              <page string="Services">
                <field name="service_ids">
                  <tree string="">

                      <field name="name" />
                      <field name="product_id" />
                      <field name="description" />
                      <field name="display_on_website" />
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers" />
            <field name="message_ids" widget="mail_thread" />
          </div>
        </form>
      </field>
    </record>

    <record id="eha_service_category_view_search" model="ir.ui.view">
      <field name="name">eha_service.category.view.search</field>
      <field name="model">eha_service.category</field>
      <field name="arch" type="xml">
        <search string="Clinical Services">
          <field name="name" />
          <field name="description" />
        </search>
      </field>
    </record>

    <record id="eha_service_category_action" model="ir.actions.act_window">
      <field name="name">Clinical Categories</field>
      <field name="res_model">eha_service.category</field>
      <field name="view_mode">tree,form</field>
      <field name="domain">[]</field>
      <field name="context">{}</field>
      <field name="help" type="html">
        <p class="oe_no_content_create">Click to create a new clinical category</p>
      </field>
    </record>

    <!-- Services -->
    <record id="eha_service_service_view_tree" model="ir.ui.view">
      <field name="name">eha.service.service.view.tree</field>
      <field name="model">eha_service.service</field>
      <field name="arch" type="xml">
        <tree string="Clinical Services">
          <field name="name" />
          <field name="category_id" />
          <field name="product_id" />
          <field name="display_on_website" />
          <field name="appointment_provider_ids"/>
          <field name="appointment_service_id" />
        </tree>
      </field>
    </record>

    <record id="eha_service_view_form" model="ir.ui.view">
      <field name="name">eha_service.view.form</field>
      <field name="model">eha_service.service</field>
      <field name="arch" type="xml">
        <form string="Clinical Services">
          <sheet>
            <field name="image" widget="image" class="oe_avatar" />
            <div class="oe_title">
              <label class="oe_edit_only" for="name" string="Service Name"/>
              <h1>
                <field name="name" placeholder="Telehealth Consultation"/>
              </h1>
            </div>
            <group>
              <group>
                <field name="category_id" />
                <field name="description" />
                <field name="display_on_website" />
                <field name="is_member_free" />
              </group>
              <group>
                <field name="product_id" required="1"/>
                <field name="product_pricelist_ids" widget="many2many_tags" required="1"/>
                <field name="appointment_service_id" required="1"/>
              </group>
            </group>
            <notebook>
              <page string="Providers">
                  <field name="appointment_provider_ids">
                    <tree string="Providers">
                      <field name="name" required="1" readonly="1"/>
                    </tree>
                    <form string="Providers">
                        <group>
                          <group>
                            <field name="name" required="1" readonly="1"/>
                            <field name="email" readonly="1"/>
                          </group>
                          <group>
                            <field name="simplybook_performer_id" readonly="0"/>
                            <field name="image_1920" required="0" widget="image" class="oe_avatar"/>
                          </group>
                        </group>
                    </form>
                  </field>
                
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers" />
            <field name="message_ids" widget="mail_thread" />
          </div>
        </form>
      </field>
    </record>

    <record id="eha_service_service_view_search" model="ir.ui.view">
      <field name="name">eha_service.service.view.search</field>
      <field name="model">eha_service.service</field>
      <field name="arch" type="xml">
        <search string="Clinical Services">
          <field name="name" />
          <field name="category_id" />
          <field name="description" />
          <field name="appointment_provider_ids" />
          <field name="appointment_service_id" />
        </search>
      </field>
    </record>

    <record id="eha_service_service_action" model="ir.actions.act_window">
      <field name="name">Clinical Services</field>
      <field name="res_model">eha_service.service</field>
      <field name="view_mode">tree,form</field>
      <field name="domain">[]</field>
      <field name="context">{}</field>
      <field name="help" type="html">
        <p class="oe_no_content_create">Click to create a new clinical service</p>
      </field>
    </record>

    <menuitem id="eha_service_menu" name="Clinical Services" parent="sale.menu_sale_config" sequence="4"/>

    <menuitem id="eha_service_category_menu" name="Category" parent="eha_service_menu" action="eha_service_category_action" sequence="1"/>

    <menuitem id="eha_service_service_menu" name="Services" parent="eha_service_menu" action="eha_service_service_action" sequence="2"/>

  </data>
</odoo>