<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="pharmacy_default_mail" model="ir.config_parameter">
            <field name="key">inventory_extension.pharmacy_default_mail</field>
            <field name="value">pharmacy@eha.ng</field>
        </record>

        <record id="product_expiry_reminder_template_v3" model="mail.template">
            <field name="name">Product Expiry Reminder v2</field>
            <field name="subject">Product Expiry Reminder </field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear,</p>
                    <p>The following products have reached their expiry date.
                        Please access the ERP and process them accordingly.
                    </p>
                    
                </div>
            </field>
        </record>
    </data>
</odoo>
 