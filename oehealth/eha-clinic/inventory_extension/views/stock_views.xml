<?xml version="1.0" ?>
<odoo>
    <data>
        <record id="stock_move_list" model="ir.ui.view">
            <field name="name">stock.move.list</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_tree"/>
            <field name="arch" type="xml">
                <field name="date" position="after">
                    <field name="cpo"/>
                    <field name="lot_number"/>
                </field>
            </field>
        </record>


        <!--Add Demand Quantity to Detailed Operation Line-->
        <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
            <field name="name">stock.move.list</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
            <field name="arch" type="xml">
                <field name="reserved_uom_qty" position="replace">
                    <field name="reserved_uom_qty" readonly="1" string="Demand" />
                </field>
                <field name="reserved_uom_qty" position="after">
                    <field name="lot_expiry_date" optional="show"/>
                </field>
            </field>
        </record>

        <!--Display alert date, best before date etc while creating lot during purchase delivery
        by removing attribute invisible from description page
        -->
        <record id="view_production_lot_form" model="ir.ui.view">
            <field name="name">stock.lot</field>
            <field name="model">stock.lot</field>
            <field name="priority">1</field>
            <field name="inherit_id" ref="stock.view_production_lot_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//group[@name='main_group']" position="after">
                        <notebook>
                            <page string="Other Info" name="description">
                            
                            </page>
                        </notebook>
                    </xpath>
                    
                </data>
            </field>
        </record>

    </data>
</odoo>