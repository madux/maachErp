<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="consignment_report_view_form" model="ir.ui.view">
            <field name="name">Consignment Report</field>
            <field name="model">consignment.reportwizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="datefrom"/>

                            <field name="partner_id" string="Owner" required="1"/>

                        </group>
                        <group>
                            <field name="dateto"/>
                        </group>
                        <field name="generated_report_ids" editable="bottom" readonly="1">
                            <tree string="Product Lines" editable="bottom">
                                <field name="product_id"/>
                                <field name="owner_id"/>
                                <field name="qty_done"/>
                                <field name="cpo"/>
                                <field name="date"/>

                            </tree>
                        </field>
                    </group>

                    <footer>
                        <button name="action_view_records" string="View Records" type="object" default_focus="1"
                                class="oe_highlight"/>

                        <button name="generate_vendor_bills" string="Generate Bills" type="object" default_focus="1"
                                class="oe_highlight"/>

                        or
                        <button string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_consignment_view_wizard" model="ir.actions.act_window">
            <field name="name">Consignment Report</field>
            <field name="res_model">consignment.reportwizard</field>
            <field name="type">ir.actions.act_window</field>

            <field name="view_mode">form</field>
            <field name="view_id" ref="consignment_report_view_form"/>
            <field name="target">new</field>
        </record>


        <!--	<menuitem id="consignment_sale_menu_report" name="Consignment Reports" action="action_consignment_view_wizard"-->
        <!--              parent="purchase.menu_purchase_control" sequence="14"/>-->
    </data>
</odoo>