<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="sms_log_form_view" model="ir.ui.view">
      <field name="name">sms.log.form</field>
      <field name="model">sms.log</field>
      <field name="arch" type="xml">
        <form string="SMS Log" create="false" edit="false">
          <group>
            <field name="model"/>
            <field name="ref"/>
            <field name="phone"/>
            <field name="text_message"/>
            <field name="response_message"/>
          </group>
          <separator/>
          <h2>Body</h2>
          <field name="response_message"/>
        </form>
      </field>
    </record>

    <record id="sms_log_tree_view" model="ir.ui.view">
      <field name="name">sms.log.tree</field>
      <field name="model">sms.log</field>
      <field name="arch" type="xml">
        <tree string="SMS Log" default_order="create_date desc" create="false" edit="false">
          <field name="model"/>
          <field name="ref" />
          <field name="phone"/>
          <field name="text_message"/>
          <field name="response_message"/>
          <field name="create_date"/>
        </tree>
      </field>
    </record>

    <record id="action_sms_log" model="ir.actions.act_window">
      <field name="name">SMS Log</field>
      <field name="res_model">sms.log</field>

      <field name="view_mode">tree,form</field>
      <field name="search_view_id" eval="False"/>
      <field name="context">{}</field>
      <field name="help">SMS Log</field>
    </record>

    <menuitem name="Custom SMS" id="sms_root_menu" parent="base.menu_custom" sequence="5" />
    <menuitem action="action_sms_log" id="menu_action_sms_log" parent="sms_root_menu" sequence="1" />
  </data>
</odoo>
