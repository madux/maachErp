<?xml version="1.0"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="edit_ot_new_tree">
            <field name="name">hr.overtime.tree</field>
            <field name="model">hr.overtime</field>
            <field name="arch" type="xml">
                <tree string="Overtime">
                    <field name="employee_id" on_change="onchange_employee_id(date_from, date_from, employee_id)"/>
                    <field name="manager_id" invisible="1"/>
                    <field name="number_of_hours"/>
                    <field name="number_of_days"/>
                    <field name="date_from" invisible="1"/>
                    <field name="date_to" invisible="1"/>
                    <field name="approve_date" invisible="1"/>
                    <field name="department_id"/>
                    <field name="category_id"/>
                    <field name="include_payroll"/>
                    <field name="company_id" groups="base.group_multi_company" widget="selection"/>
                    <field name="state"/>
                    <button string="Approve" groups="hr.group_hr_user,hr.group_hr_manager" name="ot_validate"
                            states="confirm" type="object"/>
                    <button string="Refuse" name="ot_refuse" states="confirm" type="object"
                            groups="hr.group_hr_user,hr.group_hr_manager"/>
                </tree>
            </field>
        </record>

        <record id="view_hr_overtime_filter" model="ir.ui.view">
            <field name="name">hr.overtime.select</field>
            <field name="model">hr.overtime</field>
            <field name="arch" type="xml">
                <search string="Search Overtimes">
                    <group>
                        <filter name="draft_overtime" string="Draft" domain="[('state','=','draft')]"
                                help="Draft Overtime"/>
                        <filter name="toapprove" string="To Approve" domain="[('state','=','confirm')]"
                                help="Confirm Overtimes"/>
                        <filter name="approved_overtimes" string="Approved" domain="[('state','=','validate')]"
                                help="Approved Overtimes"/>
                        <filter name="include_in_payroll" string="Payroll" domain="[('include_payroll','=', True)]"
                                help="Include in Payroll"/>
                        <separator orientation="vertical"/>
                        <field name="employee_id"/>
                        <field name="department_id" widget="selection"/>
                        <field name="category_id" widget="selection"/>
                        <field name="state"/>
                        <field name="include_payroll"/>
                    </group>
                    <group expand="0" string="Group By...">
                        <filter string="Employees" name="employee_id" context="{'group_by':'employee_id'}"/>
                        <filter string="Managers" name="manager_id" context="{'group_by':'manager_id'}"/>
                        <filter string="Departments" name="employee_id" context="{'group_by':'department_id'}"/>
                        <filter string="Categories" name="employee_id" context="{'group_by':'category_id'}"/>
                        <separator orientation="vertical"/>
                        <filter string="Companies" name="company_id" groups="base.group_multi_company"
                                context="{'group_by':'company_id'}"/>
                        <separator orientation="vertical"/>
                        <filter string="States" name="state" context="{'group_by':'state'}"/>
                        <separator orientation="vertical"/>
                        <filter string="Start Date" name="group_start_date" domain="[]"
                                context="{'group_by':'date_from'}"/>
                        <filter string="Approved Date" name="group_approved_date" domain="[]"
                                context="{'group_by':'approve_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="edit_ot_new">
            <field name="name">hr.overtime.form</field>
            <field name="model">hr.overtime</field>
            <field name="arch" type="xml">
                <form string="Overtimes" version="7.0">
                    <header>
                        <button string="Refuse" name="ot_refuse" states="confirm,validate1" type="object"
                                groups="hr.group_hr_user,hr.group_hr_manager"/>
                        <button string="Confirm" class="oe_highlight" name="ot_confirm" states="draft" type="object"/>
                        <button string="Approve" class="oe_highlight" groups="hr.group_hr_user,hr.group_hr_manager"
                                name="ot_validate" states="confirm" type="object"/>
                        <button string="Set to Draft" name="set_to_draft" states="refuse,validate" type="object"
                                groups="hr.group_hr_user"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,validate"
                               statusbar_colors='{"confirm":"blue","validate1":"blue","refuse":"red"}' colspan="2"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                            <label for="employee_id" class="oe_edit_only"/>
                            <h2>
                                <field name="employee_id"/>
                            </h2>
                        </div>
                        <group string="General" colspan="4">
                            <group>
                                <field name="department_id"/>
                                <field name="category_id"/>
                            </group>
                            <group>
                                <field name="date_from" on_change="onchange_date_from(date_to, date_from)"
                                       required="1"/>
                                <field name="date_to" on_change="onchange_date_from(date_to, date_from)" required="1"/>
                            </group>
                            <group>
                                <field name="number_of_hours"/>
                                <field name="number_of_days"/>
                            </group>
                            <group>
                                <field name="manager_id"/>
                                <field name="approve_date"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company" widget="selection"/>
                                <field name="include_payroll"/>
                            </group>
                            <group string="Notes" colspan="4">
                                <field name="notes" nolabel="1" colspan="4"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_ot_new_calendar" model="ir.ui.view">
            <field name="name">Overtime Requests</field>
            <field name="model">hr.overtime</field>
            <field name="arch" type="xml">
                <calendar string="Overtime Request" color="user_id" date_start="date_from" date_stop="date_to">
                    <field name="state"/>
                </calendar>
            </field>
        </record>

        <record model="ir.actions.act_window" id="request_approve_ot">
            <field name="name">Overtime Requests</field>
            <field name="res_model">hr.overtime</field>
            <field name="view_mode">tree,form,calendar</field>

            <field name="search_view_id" ref="view_hr_overtime_filter"/>
        </record>

        <record model="ir.actions.act_window" id="request_approve_ot_1">
            <field name="name">Overtime Requests to Approve</field>
            <field name="res_model">hr.overtime</field>
            <field name="context">{'search_default_toapprove': 1}</field>

            <field name="search_view_id" ref="view_hr_overtime_filter"/>
        </record>

        <menuitem name="Overtime" parent="hr.menu_hr_root" id="menu_open_ot" sequence="5"/>
        <menuitem name="Overtime Requests" parent="menu_open_ot" id="menu_request_ot" action="request_approve_ot"/>
        <menuitem name="Overtime Requests to Approve" groups="hr.group_hr_user,hr.group_hr_manager"
                  parent="menu_open_ot" id="menu_request_ot_req" action="request_approve_ot_1"/>

    </data>
</odoo>        