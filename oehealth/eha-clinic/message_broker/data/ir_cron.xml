<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
        <record id="cron_resend_failed_broker_messages" model="ir.cron">
            <field name="name">Broker: Resend Failed Messages</field>
            <field name="active" eval="False"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="interval_number">1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"/>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">0</field>
            <field name="model_id" ref="message_broker.model_message_broker_broker"/>
            <field name="state">code</field>
            <field name="code">model._cron_resend_failed_messages()</field>
        </record>
    
    </data>
</odoo>
