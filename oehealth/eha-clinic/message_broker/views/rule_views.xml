<odoo>
  <data>

    <record id="message_broker_rule_tree" model="ir.ui.view">
      <field name="name">message_broker.rule.view.tree</field>
      <field name="model">message_broker.rule</field>
      <field name="arch" type="xml">
        <tree string="Rule">
          <field name="name" />
          <field name="model_id" required="1" />
          <field name="namespace" required="1" />
          <field name="key" required="1" />
          <field name="state" />
        </tree>
      </field>
    </record>

    <record id="message_broker_rule_form" model="ir.ui.view">
      <field name="name">message_broker.rule.view.form</field>
      <field name="model">message_broker.rule</field>
      <field name="arch" type="xml">
        <form string="Rule">
          <header>
            <button
              string="Subscribe"
              name="action_subscribe"
              states="draft"
              type="object"
              class="oe_highlight" />
            <button
              string="Unsubscribe"
              name="action_unsubscribe"
              states="subscribe"
              type="object"
            />
            <field name="state" widget="statusbar" required="1" />
          </header>
          <sheet>
            <div class="oe_title">
              <label for="name" />
              <h1>
                <field name="name" required="1" />
              </h1>
            </div>
            <group>
              <group>
                <field name="model_id" required="1" />
                <field name="namespace" required="1" placeholder="ng.eha.patients" />
                <field name="key" string="Topic" required="1" />
              </group>
              <group>
                <field name="publish_create" widget="boolean_toggle" />
                <field name="publish_unlink" widget="boolean_toggle" />
                <field name="publish_write" widget="boolean_toggle" />
              </group>
            </group>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers" />
            <field name="activity_ids" widget="mail_activity" />
            <field name="message_ids" widget="mail_thread" />
          </div>
        </form>
      </field>
    </record>

    <record id="message_broker_rule_search" model="ir.ui.view">
      <field name="name">message_broker.rule.view.search</field>
      <field name="model">message_broker.rule</field>
      <field name="arch" type="xml">
        <search string="">
          <field name="name" />
          <field name="model_id" />
        </search>
      </field>
    </record>

    <record id="message_broker_rule_action" model="ir.actions.act_window">
      <field name="name">Message Rule</field>
      <field name="res_model">message_broker.rule</field>
      <field name="view_mode">tree,form</field>
      <field name="domain">[]</field>
      <field name="context">{}</field>
      <field name="help" type="html">
        <p class="oe_no_content_create">Click here to create a new rule</p>
      </field>
    </record>

    <menuitem
      id="message_broker.rule_menu"
      name="Message Rule"
      sequence="10"
      parent="base.menu_custom" />

    <menuitem
      id="message_broker.rule_action_menu"
      name="Rule"
      action="message_broker_rule_action"
      parent="message_broker.rule_menu"
      sequence="1" />

  </data>
</odoo>