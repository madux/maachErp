<odoo>
  <data>

    <record id="message_broker_view_tree" model="ir.ui.view">
      <field name="name">message_broker.view.tree</field>
      <field name="model">message_broker.broker</field>
      <field name="arch" type="xml">
        <tree string="Broker">
          <field name="name" />
          <field name="provider" />
          <field name="default" />
          <field name="test_mode" widget="boolean_toggle" />
        </tree>
      </field>
    </record>

    <record id="message_broker_view_form" model="ir.ui.view">
      <field name="name">message_broker.view.form</field>
      <field name="model">message_broker.broker</field>
      <field name="arch" type="xml">
        <form string="Broker">
          <header>
            <button string="Trigger Broker" name="action_produce_message" type="object"
              class="oe_highlight" />
          </header>
          <sheet>
            <div class="oe_title">
              <label for="name" />
              <h1>
                <field name="name" required="1" />
              </h1>
            </div>
            <group>
              <group>
                <field name="provider" required="1" />
                <field name="test_mode" widget="boolean_toggle" />
                <field name="use_ssl" widget="boolean_toggle" />
                <field name="delivery_timeout" />
                <field name="request_timeout" />
                <field name="no_of_retries" />
              </group>
              <group>
                <field name="default" />
                <field name="enable_flush" />
              </group>
            </group>
            <notebook>
              <page name="config_test" string="Test Config Params"
                attrs="{'invisible': [('test_mode', '=', False)]}">
                <div>Configurations below are for testing purposes</div>
                <group string="Test Configuration">
                  <group string="Bootstrap Servers">
                    <field name="bootstrap_server_test" placeholder="24.21.23.23:9092" />
                    <field name="bootstrap_server_api_key_test" password="True" />
                    <field name="bootstrap_server_api_secret_test" password="True" />
                  </group>
                  <group string="Schema Registry URL">
                    <field name="schema_registry_url_test" placeholder="http://24.21.23.23:8085" />
                    <field name="schema_registry_api_key_test" password="True" />
                    <field name="schema_registry_api_secret_test" password="True" />
                  </group>
                </group>
              </page>
              <page name="config_prod" string="Production Config Params"
                attrs="{'invisible': [('test_mode', '=', True)]}">
                <group string="Production Configuration">
                  <group string="Bootstrap Servers">
                    <field name="bootstrap_server_production" placeholder="24.21.23.23:9092" />
                    <field name="bootstrap_server_api_key_prod" />
                    <field name="bootstrap_server_api_secret_prod" />
                  </group>
                  <group string="Schema Registry URL">
                    <field name="schema_registry_url_prod" placeholder="http://24.21.23.23:8085" />
                    <field name="schema_registry_api_key_prod" />
                    <field name="schema_registry_api_secret_prod" />
                  </group>
                </group>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers" />
            <field name="activity_ids" widget="mail_activity" />
            <field name="message_ids" widget="mail_thread" />
          </div>
        </form>
      </field>
    </record>

    <record id="message_broker_view_search" model="ir.ui.view">
      <field name="name">message_broker.view.search</field>
      <field name="model">message_broker.broker</field>
      <field name="arch" type="xml">
        <search string="">
          <field name="name" />
          <field name="provider" />
        </search>
      </field>
    </record>

    <record id="message_broker_action" model="ir.actions.act_window">
      <field name="name">Message Broker</field>
      <field name="res_model">message_broker.broker</field>
      <field name="view_mode">tree,form</field>
      <field name="domain">[]</field>
      <field name="context">{}</field>
      <field name="help" type="html">
        <p class="oe_no_content_create">Click here to create a new broker</p>
      </field>
    </record>

    <menuitem id="message_broker_menu" name="Message Broker" sequence="10"
      web_icon="message_broker,static/description/icon.png" />
    <menuitem id="message_broker_action_menu" name="Broker" action="message_broker_action"
      parent="message_broker_menu" sequence="1" />

    <!-- Message History -->
    <record id="message_broker_message_view_tree" model="ir.ui.view">
      <field name="name">message.broker.message.view.tree</field>
      <field name="model">message_broker.message</field>
      <field name="arch" type="xml">
        <tree string="Message">
          <field name="name" />
          <field name="record_id" />
          <field name="type" />
          <field name="date" />
          <field name="message" />
          <field name="state" />
        </tree>
      </field>
    </record>

    <record id="message_broker_message_view_form" model="ir.ui.view">
      <field name="name">message.broker.message.view.form</field>
      <field name="model">message_broker.message</field>
      <field name="arch" type="xml">
        <form string="Message">
          <header>
            <field name="state" widget="statusbar" />
          </header>
          <sheet>
            <group>
              <group>
                <field name="name" />
                <field name="type" />
                <field name="date" />
              </group>
              <group>
                <field name="message" />
                <field name="model" />
                <field name="record_id" />
              </group>
              <group>
                <field name="broker_id" />
                <field name="key" />
              </group>
              <group>
                <field name="provider" />
                <field name="state_message" invisible="1" />
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="message_broker_message_view_search" model="ir.ui.view">
      <field name="name">message.broker.message.view.search</field>
      <field name="model">message_broker.message</field>
      <field name="arch" type="xml">
        <search string="Message">
          <field name="provider" />
        </search>
      </field>
    </record>

    <record id="message_broker_message_action" model="ir.actions.act_window">
      <field name="name">Message</field>
      <field name="res_model">message_broker.message</field>
      <field name="view_mode">tree,form</field>
      <field name="domain">[]</field>
      <field name="context">{}</field>
      <field name="help" type="html">
        <p class="oe_no_content_create">Click here to create a new message</p>
      </field>
    </record>

    <menuitem id="message_broker_message_action_menu" name="Message"
      action="message_broker_message_action" parent="message_broker_menu" sequence="2" />

  </data>
</odoo>