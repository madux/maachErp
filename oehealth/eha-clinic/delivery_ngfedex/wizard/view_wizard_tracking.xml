<odoo>
    <data>
        <record id="tracking_wizard_form" model="ir.ui.view">
            <field name="name">tracking.wizard.form</field>
            <field name="model">tracking.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <p class="text-center">
                        <field name="tracking_updates" readonly="1"/>
                    </p>
                    <footer>
                        <button name="action_ok" string="Ok" type="object" default_focus="1" class="oe_highlight"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>