<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <template id="eha_label_transfer_template_view_pdf">
            <t t-call="web.basic_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="picking">
                        <t t-set="picking_qty_done" t-value="any(picking.move_lines.move_line_ids.mapped('qty_done'))"/>
                        <t t-foreach="picking.move_lines" t-as="move">
                            <t t-foreach="move.move_line_ids" t-as="move_line">
                                <t t-if="move_line.product_uom_id.category_id.measure_type == 'unit'">
                                    <t t-if="picking_qty_done">
                                        <t t-set="qty" t-value="int(move_line.qty_done)"/>
                                    </t>
                                    <t t-else="">
                                        <t t-set="qty" t-value="int(move_line.product_uom_qty)"/>
                                    </t>
                                </t>
                                <t t-else="">
                                    <t t-set="qty" t-value="1"/>
                                </t>
                                <t t-foreach="range(qty)" t-as="item">
                                    <t t-translation="off">
                                        <div class="col-8">
                                            <table class="table table-condensed" style="border-bottom: 0px solid white !important;width: 3in;" t-if="picking.move_lines">
                                                <tr>
                                                    <th style="text-align: left;">
                                                        <span t-esc="move.product_id.name[:70]"/>
                                                    </th>
                                                </tr>
                                                <tr>
                                                    <td>
                                                        LN/SN:
                                                        <span t-field="move_line.lot_name or move_line.lot_id.name"/>
                                                    </td>
                                                </tr>
                                                <t t-if="move_line.product_id.tracking != 'none'">
                                                    <tr>
                                                        <td style="text-align: center; vertical-align: middle;" class="col-5">
                                                            <!-- <t t-if="move_line.print_lot and move_line.lot_id">
                                                                <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', move_line.lot_name, 600, 150)" style="width:100%;height:20%;" alt="Barcode"/>
                                                            </t> -->
                                                            <t t-elif="move_line.lot_name or move_line.lot_id">
                                                                <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', move_line.lot_name, 600, 150)" style="width:100%;height:20%;" alt="Barcode"/>
                                                            </t>
                                                            <t t-else="">
                                                                <span class="text-muted">No barcode available</span>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </table>
                                        </div>
                                        <div style="page-break-after: always;"/>
                                    </t>
                                </t>
                            </t>
                        </t>
                    </t>
                </div>
            </t>
        </template>

    </data>
</odoo>