<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_users_booking_form" model="ir.ui.view">
        <field name="name">res.users.booking.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Medical Profile" name="medical_profile">
                    <group>
                        <group string="Role">
                            <field name="is_doctor"/>
                            <field name="is_nurse"/>
                            <field name="medical_speciality"/>
                        </group>
                        <group string="Branch Assignment">
                            <field name="branch_ids" widget="many2many_tags"
                                   domain="[]"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
