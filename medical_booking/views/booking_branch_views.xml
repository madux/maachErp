<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_multi_branch_inherit" model="ir.ui.view">
        <field name="name">multi.branch.form.inherit</field>
        <field name="model">multi.branch</field>
        <field name="inherit_id" ref="ik_multi_branch.view_multi_branch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <button class="oe_stat_button" type="object" name="action_view_api_tokens" icon="fa-key"/>
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field string="Total Bookings" name="booking_count" widget="statinfo"/>
                </xpath>
            </xpath>
        </field>
    </record>
</odoo>
