<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══  LIST VIEW  ══════════════════════════════════════════════ -->
    <record id="view_booking_record_list" model="ir.ui.view">
        <field name="name">booking.record.list</field>
        <field name="model">booking.record</field>
        <field name="arch" type="xml">
            <tree string="Bookings"
                  decoration-danger="is_conflicting == True"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'">
                <field name="serial_number"/>
                <field name="patient_id"/>
                <field name="category_id"/>
                <field name="branch_id"/>
                <field name="booking_date"/>
                <field name="time_slot_id"/>
                <field name="assign_doctor_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state in ('draft','confirmed')"
                       decoration-danger="state in ('cancelled','no_show')"
                       decoration-info="state == 'in_progress'"/>
                <field name="is_conflicting" optional="hide"/>
                <field name="reminder_sent" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- ══  FORM VIEW  ══════════════════════════════════════════════ -->
    <record id="view_booking_record_form" model="ir.ui.view">
        <field name="name">booking.record.form</field>
        <field name="model">booking.record</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Visit" type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Mark Done" type="object"
                            invisible="state != 'in_progress'"/>
                    <button name="action_no_show" string="No Show" type="object"
                            invisible="state not in ('confirmed','in_progress')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done','cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert"
                         invisible="is_conflicting == False">
                        ⚠️ <strong>Conflict Detected:</strong> Another confirmed booking exists for the same doctor and time slot.
                    </div>
                    <group>
                        <group string="Reference">
                            <field name="serial_number" readonly="1"/>
                            <field name="is_conflicting" readonly="1" widget="boolean_toggle"/>
                            <field name="reminder_sent" readonly="1"/>
                            <!-- <field name="access_token" readonly="1" password="True"/> -->
                            <field name="access_token" readonly="1"/>
                        </group>
                        <group string="Patient">
                            <field name="patient_id"/>
                            <field name="patient_phone" readonly="1"/>
                            <field name="patient_email" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Appointment">
                            <field name="category_id"/>
                            <field name="branch_id"/>
                            <field name="booking_date"/>
                            <field name="time_slot_id"
                                   domain="[('category_weekday_id.category_id','=',category_id)]"/>
                            <field name="booking_start_time" widget="float_time" readonly="1"/>
                            <field name="booking_end_time" widget="float_time" readonly="1"/>
                        </group>
                        <group string="Medical Staff">
                             <field name="dummy_available_doctor_ids" invisible="1"/>
                            <field name="available_doctor_ids" widget="many2many_tags" domain="[('id', 'in', dummy_available_doctor_ids)]"/>
                            <field name="assign_doctor_id"
                                   domain="[('id','in',available_doctor_ids)]"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                        <page string="Cancellation" invisible="state != 'cancelled'">
                            <field name="cancellation_reason"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══  CALENDAR VIEW  ═════════════════════════════════════════ -->
    <record id="view_booking_record_calendar" model="ir.ui.view">
        <field name="name">booking.record.calendar</field>
        <field name="model">booking.record</field>
        <field name="arch" type="xml">
            <calendar string="Bookings Calendar"
                      date_start="booking_datetime"
                      color="category_id"
                      mode="month"
                      quick_create="False">
                <field name="patient_id"/>
                <field name="category_id"/>
                <field name="assign_doctor_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ══  SEARCH VIEW  ═══════════════════════════════════════════ -->
    <record id="view_booking_record_search" model="ir.ui.view">
        <field name="name">booking.record.search</field>
        <field name="model">booking.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="serial_number"/>
                <field name="patient_id"/>
                <field name="assign_doctor_id"/>
                <field name="branch_id"/>
                <field name="category_id"/>
                <filter string="Today" name="today"
                        domain="[('booking_date','=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week"
                        domain="[('booking_date','>=', (context_today() + relativedelta(weekday=0, days=-6)).strftime('%Y-%m-%d')),
                                 ('booking_date','&lt;=', (context_today() + relativedelta(weekday=6)).strftime('%Y-%m-%d'))]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Conflicting" name="conflicting" domain="[('is_conflicting','=',True)]"/>
                <filter string="Reminder Not Sent" name="no_reminder" domain="[('reminder_sent','=',False),('state','=','confirmed')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Branch" name="group_branch" context="{'group_by':'branch_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by':'category_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by':'booking_date'}"/>
                    <filter string="Doctor" name="group_doctor" context="{'group_by':'assign_doctor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══  ACTION  ════════════════════════════════════════════════ -->
    <record id="action_booking_record" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">booking.record</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_booking_record_search"/>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>

    <record id="action_booking_record_all" model="ir.actions.act_window">
        <field name="name">All Bookings</field>
        <field name="res_model">booking.record</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="view_booking_record_search"/>
    </record>

    <record id="action_booking_record_conflicts" model="ir.actions.act_window">
        <field name="name">Conflicting Bookings</field>
        <field name="res_model">booking.record</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_conflicting','=',True)]</field>
    </record>

</odoo>
