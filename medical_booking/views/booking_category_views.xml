<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_booking_category_list" model="ir.ui.view">
        <field name="name">booking.category.list</field>
        <field name="model">booking.category</field>
        <field name="arch" type="xml">
            <list string="Booking Categories">
                <field name="code"/>
                <field name="name"/>
                <field name="category_type"/>
                <field name="slot_duration" string="Slot (min)"/>
                <field name="reminder_hours" string="Reminder (hrs)"/>
                <field name="auto_assign_doctor"/>
                <field name="booking_count" string="Bookings"/>
            </list>
        </field>
    </record>

    <record id="view_booking_category_form" model="ir.ui.view">
        <field name="name">booking.category.form</field>
        <field name="model">booking.category</field>
        <field name="arch" type="xml">
            <form string="Booking Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-calendar" type="object">
                            <field name="booking_count" widget="statinfo" string="Bookings"/>
                        </button>
                    </div>
                    <group>
                        <group string="General">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category_type"/>
                            <field name="description"/>
                            <field name="active"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group string="Configuration">
                            <field name="slot_duration"/>
                            <field name="max_bookings_per_slot"/>
                            <field name="reminder_hours"/>
                            <field name="auto_assign_doctor"/>
                        </group>
                    </group>
                    <group string="Mail Templates">
                        <field name="confirmation_template_id"/>
                        <field name="reminder_template_id"/>
                    </group>
                    <notebook>
                        <page string="Weekly Schedule">
                            <field name="weekday_ids">
                                <list editable="bottom">
                                    <field name="weekday"/>
                                    <field name="is_available"/>
                                    <field name="time_slot_ids" widget="one2many_list">
                                        <list editable="bottom">
                                            <field name="start_time" widget="float_time"/>
                                            <field name="end_time" widget="float_time"/>
                                            <field name="name" readonly="1"/>
                                        </list>
                                    </field>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_booking_category" model="ir.actions.act_window">
        <field name="name">Booking Categories</field>
        <field name="res_model">booking.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
