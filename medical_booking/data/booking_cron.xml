<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_booking_reminders" model="ir.cron">
            <field name="name">Medical Booking: Send Appointment Reminders</field>
            <field name="model_id" ref="medical_booking.model_booking_record"/>
            <field name="state">code</field>
            <field name="code">model.cron_send_booking_reminders()</field>
            <field name="interval_number">1</field>
